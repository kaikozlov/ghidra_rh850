# DUP.H imm2 (0x6DC, subop2 bits 4-3 == 10): broadcast halfword imm2.
:dup.h 0, vR1115, vR2731 is op0510=0x3F & op0304=2 & op0002=0 & vR1115; op1626=0x6DC & vR2731 {
	local h:8 = zext(vR1115[0,16]);
	vR2731 = h | (h << 16) | (h << 32) | (h << 48);
}

