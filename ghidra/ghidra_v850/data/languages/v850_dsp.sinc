	vR2731[16,16] = vR1115[16,16] >> op0003;
	vR2731[32,16] = vR1115[32,16] >> op0003;
	vR2731[48,16] = vR1115[48,16] >> op0003;
}

:vshl.h op0003, vR1115, vR2731 is op0510=0x3F & op0003 & op0404=0 & vR1115; op1626=0x6AC & vR2731 {
	vR2731[0,16] = vR1115[0,16] << op0003;
	vR2731[16,16] = vR1115[16,16] << op0003;
	vR2731[32,16] = vR1115[32,16] << op0003;
	vR2731[48,16] = vR1115[48,16] << op0003;
}

# VAND/VOR/VXOR/VNOT.
:vand vR0004, vR1115, vR2731 is op0510=0x3F & vR0004 & vR1115; op1626=0x680 & vR2731 {
	vR2731 = vR0004 & vR1115;
}

:vor vR0004, vR1115, vR2731 is op0510=0x3F & vR0004 & vR1115; op1626=0x682 & vR2731 {
	vR2731 = vR0004 | vR1115;
}

:vxor vR0004, vR1115, vR2731 is op0510=0x3F & vR0004 & vR1115; op1626=0x684 & vR2731 {
	vR2731 = vR0004 ^ vR1115;
}

# ---- cat=5 vector data movement, per ana.cpp cases 0x2D/0x2E/0x2F and the
# binutils simulator (mov/dup semantics: lane insert / broadcast).
# Selector fields: type = hw1 bits 4-1 (op0104), imm bits in op0000/op0002,
# subop2 = hw1 bits 4-0 (op0004).
:vnot vR1115, vR2731 is op0510=0x3F & op0004=4 & vR1115; op1626=0x6DC & vR2731 {
	vR2731 = ~vR1115;
}

:vbswap.h vR1115, vR2731 is op0510=0x3F & op0004=5 & vR1115; op1626=0x6DC & vR2731 {
	local s0:2 = vR1115[0,16];
	vR2731[0,16] = ((s0 & 0xff) << 8) | (s0 >> 8);
	local s1:2 = vR1115[16,16];
	vR2731[16,16] = ((s1 & 0xff) << 8) | (s1 >> 8);
	local s2:2 = vR1115[32,16];
	vR2731[32,16] = ((s2 & 0xff) << 8) | (s2 >> 8);
	local s3:2 = vR1115[48,16];
	vR2731[48,16] = ((s3 & 0xff) << 8) | (s3 >> 8);
}

:vbswap.w vR1115, vR2731 is op0510=0x3F & op0004=6 & vR1115; op1626=0x6DC & vR2731 {
	local a:4 = vR1115[0,32];
	vR2731[0,32] = ((a & 0xff) << 24) | ((a & 0xff00) << 8) | ((a >> 8) & 0xff00) | (a >> 24);
	local b:4 = vR1115[32,32];
	vR2731[32,32] = ((b & 0xff) << 24) | ((b & 0xff00) << 8) | ((b >> 8) & 0xff00) | (b >> 24);
}

:vbswap.dw vR1115, vR2731 is op0510=0x3F & op0004=7 & vR1115; op1626=0x6DC & vR2731 {
	local q0:1 = vR1115[0,8];   local q1:1 = vR1115[8,8];
	local q2:1 = vR1115[16,8];  local q3:1 = vR1115[24,8];
	local q4:1 = vR1115[32,8];  local q5:1 = vR1115[40,8];
	local q6:1 = vR1115[48,8];  local q7:1 = vR1115[56,8];
	vR2731[56,8] = q0; vR2731[48,8] = q1; vR2731[40,8] = q2; vR2731[32,8] = q3;
	vR2731[24,8] = q4; vR2731[16,8] = q5; vR2731[8,8] = q6;  vR2731[0,8] = q7;
}
:vnot vR1115, vR2731 is op0510=0x3F & op0004=4 & vR1115; op1626=0x6DE & vR2731 {
	vR2731 = ~vR1115;
}

:vbswap.h vR1115, vR2731 is op0510=0x3F & op0004=5 & vR1115; op1626=0x6DE & vR2731 {
	local s0:2 = vR1115[0,16];
