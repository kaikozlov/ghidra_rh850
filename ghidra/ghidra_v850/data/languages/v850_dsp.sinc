# MODADD r: modulo-arithmetic update of the (inc<<16 | value) pair.
# Reference: binutils v850 simulator.
:modadd r1215 is op0510=0x3F & op0404=0 & op1111=0 & r1215; op1626=0x6D8 {
	# The operand encodes the even pair (r, r+1): inc/value in r, limit in r+1.
	local inc:4 = r1215[0,32] >> 16;
	local val:4 = r1215[0,32] & 0xffff;
	local max:4 = r1215[32,32] & 0xffff;
	local nxt:4 = val + inc;
	local wrap_hi:4 = zext((inc s> 0) && (nxt > max));
	local wrap_lo:4 = zext((inc s< 0) && (nxt s< 0));
	nxt = (nxt * zext((wrap_hi == 0) && (wrap_lo == 0))) + (max * wrap_lo);
	r1215[0,32] = (inc << 16) | (nxt & 0xffff);
}

# ---------------------------------------------------------------- vector memory
# VLD/VST move a full 64-bit vector between memory and a V register.
# Addressing modes: post-increment, post-decrement, post-increment by the
# amount in a general-purpose index register, modulo and bit-reverse
# addressing driven by a register pair (IDA cacheop FMT3/FMT4/FMT45 forms;
# the addressing update for the inferred modulo/bit-reverse cases mirrors
# MODADD: pair = (base/limit registers)).

macro vbitrev32(res, x) {
	local r:4 = x;
	local m:4;
	m = ((r >> 0) ^ (r >> 31)) & 1;
	r = r ^ ((m << 0) | (m << 31));
	m = ((r >> 1) ^ (r >> 30)) & 1;
	r = r ^ ((m << 1) | (m << 30));
	m = ((r >> 2) ^ (r >> 29)) & 1;
	r = r ^ ((m << 2) | (m << 29));
	m = ((r >> 3) ^ (r >> 28)) & 1;
	r = r ^ ((m << 3) | (m << 28));
	m = ((r >> 4) ^ (r >> 27)) & 1;
	r = r ^ ((m << 4) | (m << 27));
	m = ((r >> 5) ^ (r >> 26)) & 1;
	r = r ^ ((m << 5) | (m << 26));
	m = ((r >> 6) ^ (r >> 25)) & 1;
	r = r ^ ((m << 6) | (m << 25));
	m = ((r >> 7) ^ (r >> 24)) & 1;
	r = r ^ ((m << 7) | (m << 24));
	m = ((r >> 8) ^ (r >> 23)) & 1;
	r = r ^ ((m << 8) | (m << 23));
	m = ((r >> 9) ^ (r >> 22)) & 1;
	r = r ^ ((m << 9) | (m << 22));
	m = ((r >> 10) ^ (r >> 21)) & 1;
	r = r ^ ((m << 10) | (m << 21));
	m = ((r >> 11) ^ (r >> 20)) & 1;
	r = r ^ ((m << 11) | (m << 20));
	m = ((r >> 12) ^ (r >> 19)) & 1;
	r = r ^ ((m << 12) | (m << 19));
	m = ((r >> 13) ^ (r >> 18)) & 1;
	r = r ^ ((m << 13) | (m << 18));
	m = ((r >> 14) ^ (r >> 17)) & 1;
	r = r ^ ((m << 14) | (m << 17));
	m = ((r >> 15) ^ (r >> 16)) & 1;
	r = r ^ ((m << 15) | (m << 16));
	res = r;
}

