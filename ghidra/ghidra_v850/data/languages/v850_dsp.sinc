# MOV.DW: full 64-bit moves between vector registers and GPR pairs.
# The GPR-pair write goes through the raw window (an r0:r1 destination
# commits only r1); pair sources use the read views.
:mov.dw vR1115, xR2731pair is op0510=0x3F & op0104=0xC & vR1115; op1626=0x6DA & xR2731pair {
	xR2731pair = vR1115;
}

:mov.dw R1115pair, vR2731 is op0510=0x3F & op0104=0xE & R1115pair; op1626=0x6DA & vR2731 {
	vR2731 = R1115pair;
}

# VSHUFL.B r1, v2, v3: byte lane shuffle; r1 holds eight 3-bit source selectors.
:vshufl.b R0004, vR1115, vR2731 is op0510=0x3F & R0004 & vR1115; op1626=0x6AE & vR2731 {
	local selectors:4 = R0004;
	local source:8 = vR1115;
	local result:8 = 0;
	result = result | ((source >> (((selectors >> 0) & 7) << 3)) & 0xff);
	result = result | (((source >> (((selectors >> 3) & 7) << 3)) & 0xff) << 8);
	result = result | (((source >> (((selectors >> 6) & 7) << 3)) & 0xff) << 16);
	result = result | (((source >> (((selectors >> 9) & 7) << 3)) & 0xff) << 24);
	result = result | (((source >> (((selectors >> 12) & 7) << 3)) & 0xff) << 32);
	result = result | (((source >> (((selectors >> 15) & 7) << 3)) & 0xff) << 40);
	result = result | (((source >> (((selectors >> 18) & 7) << 3)) & 0xff) << 48);
	result = result | (((source >> (((selectors >> 21) & 7) << 3)) & 0xff) << 56);
	vR2731 = result;
}

