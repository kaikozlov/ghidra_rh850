# Legacy V850E2H-class packed DSP instructions (64-bit V registers).
#
# Encoding authority: IDA SDK nec850 ana.cpp categories 4/5, cross-checked
# with GNU binutils sim/v850/v850.igen. The public simulator supplies
# recovered pack/convert/move/absolute/modadd behavior, not a complete
# silicon specification. Simple lane arithmetic is a bounded numeric
# model; compound operations without a recovered algorithm use explicit
# architecture intrinsics with the recovered input/output registers.
#
# All instructions are format X (bits 10..5 = 111111, bit 26 = 1, bit 16 = 0):
#   cat=4 -> op1626 0x600..0x67E, cat=5 -> op1626 0x680..0x6FE.

define pcodeop __vcalc_h;
define pcodeop __vcalc_w;

# VMAX/VMIN update both the index GPR and the destination vector
# (IDA SDK ins.cpp CF_USE1|CF_CHG1|CF_USE2|CF_CHG3). Architecture intrinsics
# preserve the recovered two-output contract without inventing the index
# algorithm. Their internal result record packs index at bits 0..31 and
# vector at bits 32..95; it is not an architectural register format.
define pcodeop __vmaxgt_h;
define pcodeop __vmaxge_h;
define pcodeop __vmaxgt_w;
define pcodeop __vmaxge_w;
define pcodeop __vminlt_h;
define pcodeop __vminle_h;
define pcodeop __vminlt_w;
define pcodeop __vminle_w;
:vmaxgt.h R0004, vR1115, vR2731 is op0510=0x3F & R0004 & vR1115; op1626=0x650 & op2727=0 & vR2731 {
	local outputs:16 = __vmaxgt_h(R0004, vR1115, vR2731);
	R0004 = outputs:4;
	vR2731[0,32] = outputs[32,32];
	vR2731[32,32] = outputs[64,32];
}
:vmaxge.h R0004, vR1115, vR2831 is op0510=0x3F & R0004 & vR1115; op1626=0x650 & op2727=1 & vR2831 {
	local outputs:16 = __vmaxge_h(R0004, vR1115, vR2831);
	R0004 = outputs:4;
	vR2831[0,32] = outputs[32,32];
	vR2831[32,32] = outputs[64,32];
}
:vmaxgt.w R0004, vR1115, vR2731 is op0510=0x3F & R0004 & vR1115; op1626=0x652 & op2727=0 & vR2731 {
	local outputs:16 = __vmaxgt_w(R0004, vR1115, vR2731);
	R0004 = outputs:4;
	vR2731[0,32] = outputs[32,32];
	vR2731[32,32] = outputs[64,32];
}
:vmaxge.w R0004, vR1115, vR2831 is op0510=0x3F & R0004 & vR1115; op1626=0x652 & op2727=1 & vR2831 {
	local outputs:16 = __vmaxge_w(R0004, vR1115, vR2831);
	R0004 = outputs:4;
	vR2831[0,32] = outputs[32,32];
	vR2831[32,32] = outputs[64,32];
}
:vminlt.h R0004, vR1115, vR2731 is op0510=0x3F & R0004 & vR1115; op1626=0x654 & op2727=0 & vR2731 {
	local outputs:16 = __vminlt_h(R0004, vR1115, vR2731);
	R0004 = outputs:4;
	vR2731[0,32] = outputs[32,32];
	vR2731[32,32] = outputs[64,32];
}
:vminle.h R0004, vR1115, vR2831 is op0510=0x3F & R0004 & vR1115; op1626=0x654 & op2727=1 & vR2831 {
	local outputs:16 = __vminle_h(R0004, vR1115, vR2831);
	R0004 = outputs:4;
	vR2831[0,32] = outputs[32,32];
	vR2831[32,32] = outputs[64,32];
}
:vminlt.w R0004, vR1115, vR2731 is op0510=0x3F & R0004 & vR1115; op1626=0x656 & op2727=0 & vR2731 {
	local outputs:16 = __vminlt_w(R0004, vR1115, vR2731);
	R0004 = outputs:4;
	vR2731[0,32] = outputs[32,32];
	vR2731[32,32] = outputs[64,32];
}
:vminle.w R0004, vR1115, vR2831 is op0510=0x3F & R0004 & vR1115; op1626=0x656 & op2727=1 & vR2831 {
	local outputs:16 = __vminle_w(R0004, vR1115, vR2831);
	R0004 = outputs:4;
	vR2831[0,32] = outputs[32,32];
	vR2831[32,32] = outputs[64,32];
}

# Software-visible SESR view used by the public DSP simulator.
:ldsr R0004, "SESR", 0 is op0510=0x3f & R0004 & op1115=12; op1631=0x20 {
	SESR = R0004;
}
:stsr "SESR", R1115, 0 is op0510=0x3f & R1115 & op0004=12; op1631=0x40 {
	R1115 = SESR;
}

# ------------------------------------------------------------- macros
# SLEIGH macros are expanded in place, so they avoid labels entirely.

# Saturating narrowing uses the public simulator's SAT16/SAT32 behavior.
macro vsat16(res, value) {
	local r:4 = value;
	local hi:4 = zext(r s> 0x7fff);
	local lo:4 = zext(r s< -0x8000);
	local bounded:4 = (r * zext((hi == 0) && (lo == 0)))
		+ (0x7fff * hi) + (-0x8000 * lo);
	SESR = SESR | (zext((hi != 0) || (lo != 0)) * 3);
	res = bounded:2;
}
macro vsat32(res, value) {
	local r:8 = value;
	local hi:8 = zext(r s> 0x7fffffff);
	local lo:8 = zext(r s< -0x80000000);
	local bounded:8 = (r * zext((hi == 0) && (lo == 0)))
		+ (0x7fffffff * hi) + (-0x80000000 * lo);
	SESR = SESR | (zext((hi != 0) || (lo != 0)) * 3);
	res = bounded:4;
}
macro vsat_add16(res, a, b) {
	local sum:4 = sext(a) + sext(b);
	vsat16(res, sum);
}
macro vsat_sub16(res, a, b) {
	local difference:4 = sext(a) - sext(b);
	vsat16(res, difference);
}
macro vsat_add32(res, a, b) {
	local sum:8 = sext(a) + sext(b);
	vsat32(res, sum);
}
macro vsat_sub32(res, a, b) {
	local difference:8 = sext(a) - sext(b);
	vsat32(res, difference);
}

macro vaddsat_h(d, a, b) {
	vsat_add16(d[0,16], a[0,16], b[0,16]);
	vsat_add16(d[16,16], a[16,16], b[16,16]);
	vsat_add16(d[32,16], a[32,16], b[32,16]);
	vsat_add16(d[48,16], a[48,16], b[48,16]);
}
macro vsubsat_h(d, a, b) {
	vsat_sub16(d[0,16], a[0,16], b[0,16]);
	vsat_sub16(d[16,16], a[16,16], b[16,16]);
	vsat_sub16(d[32,16], a[32,16], b[32,16]);
	vsat_sub16(d[48,16], a[48,16], b[48,16]);
}
macro vaddsat_w(d, a, b) {
	vsat_add32(d[0,32], a[0,32], b[0,32]);
	vsat_add32(d[32,32], a[32,32], b[32,32]);
}
macro vsubsat_w(d, a, b) {
	vsat_sub32(d[0,32], a[0,32], b[0,32]);
	vsat_sub32(d[32,32], a[32,32], b[32,32]);
}

# |a| with the most negative value saturating (binutils sim ABS16/ABS32).
macro vabs16(res, a) {
	local v:4 = sext(a);
	local neg:4 = zext(v s< 0);
	local minimum:4 = zext(v == -0x8000);
	local magnitude:4 = (v * zext((neg == 0) && (minimum == 0)))
		+ ((0 - v) * zext((neg != 0) && (minimum == 0)))
		+ (0x7fff * minimum);
	SESR = SESR | (zext(minimum != 0) * 3);
	res = magnitude:2;
}
macro vabs32(res, a) {
	local v:8 = sext(a);
	local neg:8 = zext(v s< 0);
	local minimum:8 = zext(v == -0x80000000);
	local magnitude:8 = (v * zext((neg == 0) && (minimum == 0)))
		+ ((0 - v) * zext((neg != 0) && (minimum == 0)))
		+ (0x7fffffff * minimum);
	SESR = SESR | (zext(minimum != 0) * 3);
	res = magnitude:4;
}
# Negate with saturation of the most negative value.
macro vneg16(res, a) {
	local negated:4 = 0 - sext(a);
	vsat16(res, negated);
}
macro vneg32(res, a) {
	local negated:8 = 0 - sext(a);
	vsat32(res, negated);
}
# VADD/VSUB: lane-wise add/subtract.
:vadd.h vR0004, vR1115, vR2731 is op0510=0x3F & vR0004 & vR1115; op1626=0x600 & vR2731 {
	vR2731[0,16] = vR0004[0,16] + vR1115[0,16];
	vR2731[16,16] = vR0004[16,16] + vR1115[16,16];
	vR2731[32,16] = vR0004[32,16] + vR1115[32,16];
	vR2731[48,16] = vR0004[48,16] + vR1115[48,16];
}

:vsub.h vR0004, vR1115, vR2731 is op0510=0x3F & vR0004 & vR1115; op1626=0x604 & vR2731 {
	vR2731[0,16] = vR0004[0,16] - vR1115[0,16];
	vR2731[16,16] = vR0004[16,16] - vR1115[16,16];
	vR2731[32,16] = vR0004[32,16] - vR1115[32,16];
	vR2731[48,16] = vR0004[48,16] - vR1115[48,16];
}

:vadd.w vR0004, vR1115, vR2731 is op0510=0x3F & vR0004 & vR1115; op1626=0x602 & vR2731 {
	vR2731[0,32] = vR0004[0,32] + vR1115[0,32];
	vR2731[32,32] = vR0004[32,32] + vR1115[32,32];
}

:vsub.w vR0004, vR1115, vR2731 is op0510=0x3F & vR0004 & vR1115; op1626=0x606 & vR2731 {
	vR2731[0,32] = vR0004[0,32] - vR1115[0,32];
	vR2731[32,32] = vR0004[32,32] - vR1115[32,32];
}

# VADDS/VSUBS: add/sub with scaling, lane = (a op b) >> 1 (inferred).
:vadds.h vR0004, vR1115, vR2731 is op0510=0x3F & vR0004 & vR1115; op1626=0x608 & vR2731 {
	vR2731[0,16] = (vR0004[0,16] + vR1115[0,16]) >> 1;
	vR2731[16,16] = (vR0004[16,16] + vR1115[16,16]) >> 1;
	vR2731[32,16] = (vR0004[32,16] + vR1115[32,16]) >> 1;
	vR2731[48,16] = (vR0004[48,16] + vR1115[48,16]) >> 1;
}

:vsubs.h vR0004, vR1115, vR2731 is op0510=0x3F & vR0004 & vR1115; op1626=0x60C & vR2731 {
	vR2731[0,16] = (vR0004[0,16] - vR1115[0,16]) >> 1;
	vR2731[16,16] = (vR0004[16,16] - vR1115[16,16]) >> 1;
	vR2731[32,16] = (vR0004[32,16] - vR1115[32,16]) >> 1;
	vR2731[48,16] = (vR0004[48,16] - vR1115[48,16]) >> 1;
}

:vadds.w vR0004, vR1115, vR2731 is op0510=0x3F & vR0004 & vR1115; op1626=0x60A & vR2731 {
	vR2731[0,32] = (vR0004[0,32] + vR1115[0,32]) >> 1;
	vR2731[32,32] = (vR0004[32,32] + vR1115[32,32]) >> 1;
}

:vsubs.w vR0004, vR1115, vR2731 is op0510=0x3F & vR0004 & vR1115; op1626=0x60E & vR2731 {
	vR2731[0,32] = (vR0004[0,32] - vR1115[0,32]) >> 1;
	vR2731[32,32] = (vR0004[32,32] - vR1115[32,32]) >> 1;
}

# VADDSAT/VSUBSAT: lane-wise saturating add/subtract.
:vaddsat.h vR0004, vR1115, vR2731 is op0510=0x3F & vR0004 & vR1115; op1626=0x610 & vR2731 {
	vaddsat_h(vR2731, vR0004, vR1115);
}

:vsubsat.h vR0004, vR1115, vR2731 is op0510=0x3F & vR0004 & vR1115; op1626=0x614 & vR2731 {
	vsubsat_h(vR2731, vR0004, vR1115);
}

:vaddsat.w vR0004, vR1115, vR2731 is op0510=0x3F & vR0004 & vR1115; op1626=0x612 & vR2731 {
	vaddsat_w(vR2731, vR0004, vR1115);
}

:vsubsat.w vR0004, vR1115, vR2731 is op0510=0x3F & vR0004 & vR1115; op1626=0x616 & vR2731 {
	vsubsat_w(vR2731, vR0004, vR1115);
}

# VMUL.H: even-halfword products into the two word lanes; VMUL.W: low word of each word-lane product.
:vmul.h vR0004, vR1115, vR2731 is op0510=0x3F & vR0004 & vR1115; op1626=0x618 & vR2731 {
	local p0:4 = sext(vR0004[0,16]) * sext(vR1115[0,16]);
	local p32:4 = sext(vR0004[32,16]) * sext(vR1115[32,16]);
	vR2731[0,32] = p0;
	vR2731[32,32] = p32;
}

:vmul.w vR0004, vR1115, vR2731 is op0510=0x3F & vR0004 & vR1115; op1626=0x61A & vR2731 {
	vR2731[0,32] = vR0004[0,32] * vR1115[0,32];
	vR2731[32,32] = vR0004[32,32] * vR1115[32,32];
}

# VMULT: truncated (Q-format scaled) multiply. H keeps product bits 31..16 per halfword lane;
# W keeps product bits 63..32 per word lane (inferred).
:vmult.h vR0004, vR1115, vR2731 is op0510=0x3F & vR0004 & vR1115; op1626=0x61C & vR2731 {
	local p0:4 = sext(vR0004[0,16]) * sext(vR1115[0,16]);
	local p16:4 = sext(vR0004[16,16]) * sext(vR1115[16,16]);
	local p32:4 = sext(vR0004[32,16]) * sext(vR1115[32,16]);
	local p48:4 = sext(vR0004[48,16]) * sext(vR1115[48,16]);
	vR2731[0,16] = p0[16,16];
	vR2731[16,16] = p16[16,16];
	vR2731[32,16] = p32[16,16];
	vR2731[48,16] = p48[16,16];
}

:vmult.w vR0004, vR1115, vR2731 is op0510=0x3F & vR0004 & vR1115; op1626=0x61E & vR2731 {
	local sa0:8 = sext(vR0004[0,32]);
	local sb0:8 = sext(vR1115[0,32]);
	local p0:8 = sa0 * sb0;
	vR2731[0,32] = p0[32,32];
	local sa32:8 = sext(vR0004[32,32]);
	local sb32:8 = sext(vR1115[32,32]);
	local p32:8 = sa32 * sb32;
	vR2731[32,32] = p32[32,32];
}

# VCMP: lane compares produce all-ones/all-zeros masks.
:vcmpeq.h vR0004, vR1115, vR2731 is op0510=0x3F & vR0004 & vR1115; op1626=0x620 & vR2731 {
	local a0:4 = sext(vR0004[0,16]);
	local a16:4 = sext(vR0004[16,16]);
	local a32:4 = sext(vR0004[32,16]);
	local a48:4 = sext(vR0004[48,16]);
	local b0:4 = sext(vR1115[0,16]);
	local b16:4 = sext(vR1115[16,16]);
	local b32:4 = sext(vR1115[32,16]);
	local b48:4 = sext(vR1115[48,16]);
	vR2731[0,16] = zext(a0 == b0) * 0xffff;
	vR2731[16,16] = zext(a16 == b16) * 0xffff;
	vR2731[32,16] = zext(a32 == b32) * 0xffff;
	vR2731[48,16] = zext(a48 == b48) * 0xffff;
}

:vcmpeq.w vR0004, vR1115, vR2731 is op0510=0x3F & vR0004 & vR1115; op1626=0x622 & vR2731 {
	vR2731[0,32] = zext(vR0004[0,32] == vR1115[0,32]) * 0xffffffff;
	vR2731[32,32] = zext(vR0004[32,32] == vR1115[32,32]) * 0xffffffff;
}

:vcmpne.h vR0004, vR1115, vR2731 is op0510=0x3F & vR0004 & vR1115; op1626=0x624 & vR2731 {
	local a0:4 = sext(vR0004[0,16]);
	local a16:4 = sext(vR0004[16,16]);
	local a32:4 = sext(vR0004[32,16]);
	local a48:4 = sext(vR0004[48,16]);
	local b0:4 = sext(vR1115[0,16]);
	local b16:4 = sext(vR1115[16,16]);
	local b32:4 = sext(vR1115[32,16]);
	local b48:4 = sext(vR1115[48,16]);
	vR2731[0,16] = zext(a0 != b0) * 0xffff;
	vR2731[16,16] = zext(a16 != b16) * 0xffff;
	vR2731[32,16] = zext(a32 != b32) * 0xffff;
	vR2731[48,16] = zext(a48 != b48) * 0xffff;
}

:vcmpne.w vR0004, vR1115, vR2731 is op0510=0x3F & vR0004 & vR1115; op1626=0x626 & vR2731 {
	vR2731[0,32] = zext(vR0004[0,32] != vR1115[0,32]) * 0xffffffff;
	vR2731[32,32] = zext(vR0004[32,32] != vR1115[32,32]) * 0xffffffff;
}

:vcmplt.h vR0004, vR1115, vR2731 is op0510=0x3F & vR0004 & vR1115; op1626=0x628 & vR2731 {
	local a0:4 = sext(vR0004[0,16]);
	local a16:4 = sext(vR0004[16,16]);
	local a32:4 = sext(vR0004[32,16]);
	local a48:4 = sext(vR0004[48,16]);
	local b0:4 = sext(vR1115[0,16]);
	local b16:4 = sext(vR1115[16,16]);
	local b32:4 = sext(vR1115[32,16]);
	local b48:4 = sext(vR1115[48,16]);
	vR2731[0,16] = zext(a0 s< b0) * 0xffff;
	vR2731[16,16] = zext(a16 s< b16) * 0xffff;
	vR2731[32,16] = zext(a32 s< b32) * 0xffff;
	vR2731[48,16] = zext(a48 s< b48) * 0xffff;
}

:vcmplt.w vR0004, vR1115, vR2731 is op0510=0x3F & vR0004 & vR1115; op1626=0x62A & vR2731 {
	vR2731[0,32] = zext(vR0004[0,32] s< vR1115[0,32]) * 0xffffffff;
	vR2731[32,32] = zext(vR0004[32,32] s< vR1115[32,32]) * 0xffffffff;
}

:vcmple.h vR0004, vR1115, vR2731 is op0510=0x3F & vR0004 & vR1115; op1626=0x62C & vR2731 {
	local a0:4 = sext(vR0004[0,16]);
	local a16:4 = sext(vR0004[16,16]);
	local a32:4 = sext(vR0004[32,16]);
	local a48:4 = sext(vR0004[48,16]);
	local b0:4 = sext(vR1115[0,16]);
	local b16:4 = sext(vR1115[16,16]);
	local b32:4 = sext(vR1115[32,16]);
	local b48:4 = sext(vR1115[48,16]);
	vR2731[0,16] = zext(a0 s<= b0) * 0xffff;
	vR2731[16,16] = zext(a16 s<= b16) * 0xffff;
	vR2731[32,16] = zext(a32 s<= b32) * 0xffff;
	vR2731[48,16] = zext(a48 s<= b48) * 0xffff;
}

:vcmple.w vR0004, vR1115, vR2731 is op0510=0x3F & vR0004 & vR1115; op1626=0x62E & vR2731 {
	vR2731[0,32] = zext(vR0004[0,32] s<= vR1115[0,32]) * 0xffffffff;
	vR2731[32,32] = zext(vR0004[32,32] s<= vR1115[32,32]) * 0xffffffff;
}

# VMSUM: word lane j = h(2j)*h'(2j) + h(2j+1)*h'(2j+1); VMSUM.W is a plain word product (replaces).
:vmsum.h vR0004, vR1115, vR2731 is op0510=0x3F & vR0004 & vR1115; op1626=0x64C & vR2731 {
	local p0e:4 = sext(vR0004[0,16]) * sext(vR1115[0,16]);
	local p0o:4 = sext(vR0004[16,16]) * sext(vR1115[16,16]);
	vR2731[0,32] = p0e + p0o;
	local p32e:4 = sext(vR0004[32,16]) * sext(vR1115[32,16]);
	local p32o:4 = sext(vR0004[48,16]) * sext(vR1115[48,16]);
	vR2731[32,32] = p32e + p32o;
}

:vmsum.w vR0004, vR1115, vR2731 is op0510=0x3F & vR0004 & vR1115; op1626=0x64E & vR2731 {
	vR2731[0,32] = vR0004[0,32] * vR1115[0,32];
	vR2731[32,32] = vR0004[32,32] * vR1115[32,32];
}

# The public simulator does not implement these multiply/complex families.
# Keep their full operand dataflow in architecture intrinsics instead of
# inventing Q scaling, complex-lane packing, or accumulation/rounding laws.
define pcodeop __vmsumad_h;
define pcodeop __vmsumad_w;
define pcodeop __vmsumadre_h;
define pcodeop __vmsumadim_h;
define pcodeop __vmsumadre_w;
define pcodeop __vmsumadim_w;
define pcodeop __vmsumadrn_h;
define pcodeop __vmadsat_h;
define pcodeop __vmadsat_w;
define pcodeop __vmadrn_h;
define pcodeop __vmadrn_w;
define pcodeop __vmulcx_h;
define pcodeop __vmulcx_w;
:vmsumad.h vR0004, vR1115, vR2731 is op0510=0x3F & vR0004 & vR1115; op1626=0x630 & vR2731 {
	vR2731 = __vmsumad_h(vR0004, vR1115, vR2731);
}
:vmsumad.w vR0004, vR1115, vR2731 is op0510=0x3F & vR0004 & vR1115; op1626=0x632 & vR2731 {
	vR2731 = __vmsumad_w(vR0004, vR1115, vR2731);
}
:vmsumadre.h vR0004, vR1115, vR2731 is op0510=0x3F & vR0004 & vR1115; op1626=0x638 & vR2731 {
