# VITLV family: two-operand (vreg2, vreg3). Interleave permutation is a
# documented inference (no public semantics; sim does not implement it).
:vitlv.h vR1115, vR2731 is op0510=0x3F & op0004=0 & vR1115; op1626=0x6DE & vR2731 {
	vR2731[0,16] = vR1115[0,16];
