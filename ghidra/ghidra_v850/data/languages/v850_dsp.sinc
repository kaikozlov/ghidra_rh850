# PK/PKQ/CNV family: reference semantics from the binutils v850 simulator.
# pki16i32 v1, v2, v3 writes sign-extended halfwords into BOTH v2 and v3.
:pki16i32 vR0004, vR1115, vR2731 is op0510=0x3F & vR0004 & vR1115; op1626=0x66A & vR2731 {
	# Snapshot the source first: vreg2/vreg3 may alias vreg1. Each 16-bit
	# lane sign-extends into its own 32-bit word lane (sim v850.igen 3944).
	local v:8 = vR0004;
	local h0:4 = sext(v[0,16]);
	local h1:4 = sext(v[16,16]);
	local h2:4 = sext(v[32,16]);
	local h3:4 = sext(v[48,16]);
	vR1115 = zext(h0) | (zext(h1) << 32);
	vR2731 = zext(h2) | (zext(h3) << 32);
}


:pki16ui8 vR0004, vR1115, vR2731 is op0510=0x3F & vR0004 & vR1115; op1626=0x666 & vR2731 {
	# EVEN bytes (bit offsets 0,16,32,48) of each source pack into the result:
	# vreg1 bytes 0,2,4,6 -> result bytes 0-3; vreg2 bytes 0,2,4,6 -> result
	# bytes 4-7 (sim v850.igen 3967: (v >> 8) & 0xff00 selects original bits
	# 16..23, not 8..15).
	vR2731[0,8] = vR0004[0,8];
	vR2731[8,8] = vR0004[16,8];
	vR2731[16,8] = vR0004[32,8];
	vR2731[24,8] = vR0004[48,8];
	vR2731[32,8] = vR1115[0,8];
	vR2731[40,8] = vR1115[16,8];
	vR2731[48,8] = vR1115[32,8];
	vR2731[56,8] = vR1115[48,8];
}


# pkui8i16 v1, v2, v3: zero-extended even bytes to v2, odd bytes to v3.
:pkui8i16 vR0004, vR1115, vR2731 is op0510=0x3F & vR0004 & vR1115; op1626=0x66C & vR2731 {
	# Unpack bytes into the LOW byte of each 16-bit lane (bit offsets
	# 0,16,32,48): bytes 0-3 -> vreg2, bytes 4-7 -> vreg3 (sim v850.igen
	# 4098: (v << 8) & 0x00ff0000 deposits original byte1 at bits 16..23).
	local v:8 = vR0004;
	vR1115 = zext(v[0,8]) | (zext(v[8,8]) << 16) | (zext(v[16,8]) << 32) | (zext(v[24,8]) << 48);
	vR2731 = zext(v[32,8]) | (zext(v[40,8]) << 16) | (zext(v[48,8]) << 32) | (zext(v[56,8]) << 48);
}


