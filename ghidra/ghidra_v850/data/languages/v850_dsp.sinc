# vconcat.b r4(8..15), v1, v2, v3: per-byte select between v1 and v2 by r4 bits.
:vconcat.b r8, vR0003, vR1114, vR2730 is op0510=0x3F & op0404=0 & op1515=0 & vR0003 & vR1114; op1626=0x6B2 & op3131=0 & vR2730 & r8 {
	local s0:1 = (r8 & 1) != 0;
	vR2730[0,8] = (vR1114[0,8] * s0) + (vR0003[0,8] * (s0 == 0));
	local s1:1 = (r8 & 2) != 0;
	vR2730[8,8] = (vR1114[8,8] * s1) + (vR0003[8,8] * (s1 == 0));
	local s2:1 = (r8 & 4) != 0;
	vR2730[16,8] = (vR1114[16,8] * s2) + (vR0003[16,8] * (s2 == 0));
	local s3:1 = (r8 & 8) != 0;
	vR2730[24,8] = (vR1114[24,8] * s3) + (vR0003[24,8] * (s3 == 0));
	local s4:1 = (r8 & 16) != 0;
