	vR2731[32,32] = ((b & 0xff) << 24) | ((b & 0xff00) << 8) | ((b >> 8) & 0xff00) | (b >> 24);
}

:vbswap.dw vR1115, vR2731 is op0510=0x3F & op0004=7 & vR1115; op1626=0x6DE & vR2731 {
	local q0:1 = vR1115[0,8];   local q1:1 = vR1115[8,8];
	local q2:1 = vR1115[16,8];  local q3:1 = vR1115[24,8];
	local q4:1 = vR1115[32,8];  local q5:1 = vR1115[40,8];
