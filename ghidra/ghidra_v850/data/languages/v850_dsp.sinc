}

# DUP.W imm1 (0x6DE, subop2 bits 4-3 == 11): broadcast word imm1.
:dup.w 0, vR1115, vR2731 is op0510=0x3F & op0304=3 & op0000=0 & vR1115; op1626=0x6DE & vR2731 {
	local w:8 = zext(vR1115[0,32]);
	vR2731 = w | (w << 32);
}

:dup.w 1, vR1115, vR2731 is op0510=0x3F & op0304=3 & op0000=1 & vR1115; op1626=0x6DE & vR2731 {
