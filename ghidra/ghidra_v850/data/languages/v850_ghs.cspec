<?xml version="1.0" encoding="UTF-8"?>

<!--
  Renesas V850/RH850 compiler specification — Green Hills MULTI (RH850 ABI).

  Models the GHS MULTI RH850 ABI as classified by the IDA nec850 module
  (ABI_RH850 + abi_align8) and the GHS ABI notes:

    r0        reads-as-zero; volatile
    r1,r2     volatile (assembler temporary)
    sp  (r3)  stack pointer (preserved)
    gp  (r4)  global pointer (preserved; set once at reset)
    tp  (r5)  text/small-data pointer (preserved)
    r6..r9    integer/pointer argument registers (volatile)
    r10       return value, low word (volatile)
    r11       return value, high word / 64-bit (volatile)
    r12..r19  volatile scratch
    r20..r29  callee-saved "save registers"
    ep  (r30) element pointer (volatile)
    lp  (r31) link pointer (clobbered by every jarl/call)

  GHS scalar/aggregate placement:
    - 8-byte scalar arguments occupy even-aligned register pairs;
    - structures and unions use a hidden return buffer pointer in r6;
      r6/r10 are caller-clobbered on return, not a returned pointer/value.

  Aggregate arguments larger than the available registers split across the
  remaining registers and then the stack (register-stack split), matching
  the scattered argloc allocation of the reference module.

  Varargs keep the integer register sequence; callers promote arguments.
-->
<compiler_spec>
  <data_organization>
     <absolute_max_alignment value="0" />
     <machine_alignment value="4" />
     <default_alignment value="1" />
     <default_pointer_alignment value="4" />
     <pointer_size value="4" />
     <wchar_size value="4" />
     <short_size value="2" />
     <integer_size value="4" />
     <long_size value="4" />
     <long_long_size value="8" />
     <float_size value="4" />
     <double_size value="8" />
     <long_double_size value="8" />
     <size_alignment_map>
          <entry size="1" alignment="1" />
          <entry size="2" alignment="2" />
          <entry size="4" alignment="4" />
          <entry size="8" alignment="8" />
     </size_alignment_map>
  </data_organization>
  <global>
    <range space="ram"/>
  </global>
  <stackpointer register="sp" space="ram" growth="negative"/>
  <returnaddress>
    <register name="lp"/>
  </returnaddress>

  <default_proto>
    <prototype name="__stdcall" extrapop="0" stackshift="0">
      <!-- Integer args in r6..r9, then the caller's stack (extrapop=0). -->
      <input>
        <group>
          <pentry minsize="4" maxsize="4" storage="hiddenret">
            <register name="r6"/>
          </pentry>
          <pentry minsize="1" maxsize="4" extension="inttype">
            <register name="r6"/>
          </pentry>
        </group>
        <pentry minsize="1" maxsize="4" extension="inttype">
          <register name="r7"/>
        </pentry>
        <pentry minsize="1" maxsize="4" extension="inttype">
          <register name="r8"/>
        </pentry>
        <pentry minsize="1" maxsize="4" extension="inttype">
          <register name="r9"/>
        </pentry>
        <pentry minsize="1" maxsize="500" align="4">
          <addr offset="0" space="stack"/>
        </pentry>
        <!-- GHS 8-byte alignment: 8-byte scalars take even-aligned
             register pairs (r6:r7 or r8:r9). The datatype filter splits
             by signedness in Ghidra, so int and uint both need the rule. -->
        <rule>
          <datatype name="int" minsize="5" maxsize="8"/>
          <join align="true"/>
        </rule>
        <rule>
          <datatype name="uint" minsize="5" maxsize="8"/>
          <join align="true"/>
        </rule>
        <rule>
          <datatype name="float" minsize="5" maxsize="8"/>
          <join align="true"/>
        </rule>
        <!-- Any other multi-word value splits across remaining registers
             and then the stack. -->
        <rule>
          <datatype name="any"/>
          <join/>
        </rule>
      </input>
      <output>
        <pentry minsize="1" maxsize="4" extension="inttype">
          <register name="r10"/>
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="r11"/>
        </pentry>
        <!-- GHS RH850: structures and unions are returned through a hidden
             return buffer pointer in r6 (ABI_RH850), never in registers. -->
        <rule>
          <datatype name="struct"/>
          <hidden_return voidlock="true"/>
        </rule>
        <rule>
          <datatype name="union"/>
          <hidden_return voidlock="true"/>
        </rule>
        <rule>
          <datatype name="any"/>
          <join/>
        </rule>
      </output>
      <unaffected>
        <register name="sp"/>
        <register name="gp"/>
        <register name="tp"/>
        <register name="r20"/>
        <register name="r21"/>
        <register name="r22"/>
        <register name="r23"/>
        <register name="r24"/>
        <register name="r25"/>
        <register name="r26"/>
        <register name="r27"/>
        <register name="r28"/>
        <register name="r29"/>
      </unaffected>
      <killedbycall>
        <register name="r0"/>
        <register name="r1"/>
        <register name="r2"/>
        <register name="r6"/>
        <register name="r7"/>
        <register name="r8"/>
        <register name="r9"/>
        <register name="r10"/>
        <register name="r11"/>
        <register name="r12"/>
        <register name="r13"/>
        <register name="r14"/>
        <register name="r15"/>
        <register name="r16"/>
        <register name="r17"/>
        <register name="r18"/>
        <register name="r19"/>
        <register name="ep"/>
        <register name="lp"/>
      </killedbycall>
    </prototype>
  </default_proto>

  <!-- Interrupt / exception handler prototype: no ABI arguments, returns to
       a saved EIPC/FEPC context via eiret/reti/feret; preserves every GPR. -->
  <prototype name="__interrupt" extrapop="0" stackshift="0">
    <input></input>
    <output killedbycall="true"></output>
    <unaffected>
      <register name="r1"/>
      <register name="r2"/>
      <register name="sp"/>
      <register name="gp"/>
      <register name="tp"/>
      <register name="r6"/>
      <register name="r7"/>
      <register name="r8"/>
      <register name="r9"/>
      <register name="r10"/>
      <register name="r11"/>
      <register name="r12"/>
      <register name="r13"/>
      <register name="r14"/>
      <register name="r15"/>
      <register name="r16"/>
      <register name="r17"/>
      <register name="r18"/>
      <register name="r19"/>
      <register name="r20"/>
      <register name="r21"/>
      <register name="r22"/>
      <register name="r23"/>
      <register name="r24"/>
      <register name="r25"/>
      <register name="r26"/>
      <register name="r27"/>
      <register name="r28"/>
      <register name="r29"/>
      <register name="ep"/>
      <register name="lp"/>
    </unaffected>
  </prototype>
</compiler_spec>
