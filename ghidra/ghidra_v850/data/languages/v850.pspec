<?xml version="1.0" encoding="UTF-8"?>

<processor_spec>
  <programcounter register="PC"/>
  <data_space space="ram"/>
  <volatile outputop="write" inputop="read">
    <!-- P1M-E R01UH0585EJ0120 Table 4.1: on-chip I/O. Leave the flash
         apertures (including configuration and OTP) outside these ranges. -->
    <range space="ram" first="0x10000000" last="0x1FFFFFFF"/>
    <range space="ram" first="0xFF000000" last="0xFF1FFFFF"/>
    <range space="ram" first="0xFF400000" last="0xFFFDFFFF"/>
    <range space="ram" first="0xFFFEE000" last="0xFFFEFFFF"/>
    <range space="ram" first="0xFFFF5000" last="0xFFFFFFFF"/>
  </volatile>
  <register_data>
    <!-- G3M Table 3-60: ICHCLR stays 1 until hardware clears the cache;
         ICHEN/D1EIV also need not reflect a write immediately. Native
         volatility keeps reads independent without inventing a completion
         time. Executors still read/write register state; their hardware
         model must supply completion. G4MH has a different ICHCLR contract. -->
    <register name="ICCTRL" volatile="true"/>
    <!-- G3M Table 3-64: retain externally observable data-buffer commands
         and enable/disable writes. Volatility does not make CDBCLR a busy
         status bit: STSR independently masks its write-only bit 1 to zero. -->
    <register name="CDBCR" volatile="true"/>
    <!-- PMR writes control externally visible interrupt acceptance even when
         no later instruction reads the register. Retain that effect through
         native volatility; this does not model asynchronous PMR mutation or
         change pending-FPI delivery in the instruction semantics. -->
    <register name="PMR" volatile="true"/>
    <!-- Exception-vector selection is observable even without a later STSR. -->
    <register name="EBASE" volatile="true"/>
  </register_data>
</processor_spec>
