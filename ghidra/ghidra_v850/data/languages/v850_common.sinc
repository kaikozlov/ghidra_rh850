@if defined(V850SIMD)
attach variables [ SR0004_a SR1115_a ] [
    _ _ _ _ _ _ FXSR _
    FXST FXINFO FXCFG _ FXXC FXXP _ _
    _ _ _ _ _ _ _ _
    _ _ _ _ _ _ _ _
];
attach variables [ SR0004_9 SR1115_9 ] [
    _ _ _ _ _ _ _ _
    _ _ _ _ _ _ _ _
    MPIDX MPBK _ _ MPLA MPUA MPAT _
    _ _ _ _ _ _ _ _
];
@endif


attach variables [op0_1720] [r0 r2 gp r6 r8 r10 r12 r14 r16 r18 r20 r22 r24 r26 r28 ep];
attach variables [op1_1720] [r1 sp tp r7 r9 r11 r13 r15 r17 r19 r21 r23 r25 r27 r29 lp];

@if defined(V850E2M)
# E2M Format F:I reg4: bits 20..17 supply the high bits; bit 23 is the LSB.
reg4: "r0" is op2323=0 & op1720=0 { local discard:4 = 0; export discard; }
reg4: op0_1720 is op2323=0 & op0_1720 & op1720!=0 { export op0_1720; }
reg4: op1_1720 is op2323=1 & op1_1720 { export op1_1720; }
@endif

attach variables [ xR0004 xR1115 xR2731]
	[ r0 r1 r2 sp gp tp r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 r16 r17 r18 r19 r20 r21 r22 r23 r24 r25 r26 r27 r28 r29 ep lp ];
attach variables [ r0004 r1115 r1620 prep1620r ]
	[ _  r1 r2 sp gp tp r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 r16 r17 r18 r19 r20 r21 r22 r23 r24 r25 r26 r27 r28 r29 ep lp ];
attach variables [ xR0004pair xR1115pair xR1620pair xR2731pair ]
	[ r0r1 _ r2sp _ gptp _ r6r7 _ r8r9 _ r10r11 _ r12r13 _ r14r15 _ r16r17 _ r18r19 _ r20r21 _ r22r23 _ r24r25 _ r26r27 _ r28r29 _ eplp _ ];
attach variables [ xR2731pairEx ]  # the same as xR2731pair, but LSB is ignored
	[ r0r1 r2sp gptp r6r7 r8r9 r10r11 r12r13 r14r15 r16r17 r18r19 r20r21 r22r23 r24r25 r26r27 r28r29 eplp ];

# Pair-register operand views, mirroring the scalar R0004/R1115/R2731
# zero handling above. The x...pair fields export the raw 8-byte window
# and are used where an instruction WRITES a pair: that is exact for every
# pair except r0:r1, whose write commits the high word to r1 and discards
# the low word into r0sink (writes to r0 are architecturally discarded).
# Reading is different -- r0 always reads as zero -- so these read views
# yield (0 || r1) for the r0:r1 pair regardless of the discarded sink
# contents, and the raw window for every other pair. The attach-list index
# of r0r1 is 0, hence the "=0" match, the same idiom the scalar zero tests
# use. xR1620pair needs no read view (MAC/MACU only ever write reg4).
@if !(defined(V850E1F))
R0004pair: xR0004pair is xR0004pair & xR0004pair=0	{ local x:8 = zext(r1) << 32; export x; }
R0004pair: xR0004pair is xR0004pair					{ export xR0004pair; }

R1115pair: xR1115pair is xR1115pair & xR1115pair=0	{ local x:8 = zext(r1) << 32; export x; }
R1115pair: xR1115pair is xR1115pair					{ export xR1115pair; }
@endif

R2731pair: xR2731pair is xR2731pair & xR2731pair=0	{ local x:8 = zext(r1) << 32; export x; }
R2731pair: xR2731pair is xR2731pair					{ export xR2731pair; }

@if defined(V850E3)
R2731pairEx: xR2731pairEx is xR2731pairEx & xR2731pairEx=0	{ local x:8 = zext(r1) << 32; export x; }
R2731pairEx: xR2731pairEx is xR2731pairEx					{ export xR2731pairEx; }
@endif

attach names [fcond2730]
  ["f" "un" "eq" "ueq" "olt" "ult" "ole" "ule" "sf" "ngle" "seq" "ngl" "lt" "nge" "le" "ngt"];

@if defined(V850VECTOR)
attach variables [ vR0004 vR1115 vR2731 ]
	[ v0 v1 v2 v3 v4 v5 v6 v7 v8 v9 v10 v11 v12 v13 v14 v15
	  v16 v17 v18 v19 v20 v21 v22 v23 v24 v25 v26 v27 v28 v29 v30 v31 ];
attach variables [ vR0003 vR1114 vR2730 vR2831 ]
	[ v0 v1 v2 v3 v4 v5 v6 v7 v8 v9 v10 v11 v12 v13 v14 v15 ];
attach variables [ wR0004 wR1115 wR2731 wR3236 wR4347 ]
	[ w0 w1 w2 w3 w4 w5 w6 w7 w8 w9 w10 w11 w12 w13 w14 w15
	  w16 w17 w18 w19 w20 w21 w22 w23 w24 w25 w26 w27 w28 w29 w30 w31 ];
# GPR pairs for MODADD and vector modulo addressing: the 4-bit field value v
# addresses the pair (2v, 2v+1), matching the binutils simulator reg2e = v<<1.
attach variables [ xr1215 ]
	[ r0r1 r2sp gptp r6r7 r8r9 r10r11 r12r13 r14r15 r16r17 r18r19 r20r21
	  r22r23 r24r25 r26r27 r28r29 eplp ];
# Modulo/bit-reverse pair read view (MODADD and the vector "mod" forms):
# the r0 half reads as zero like the R...pair views above. MODADD also
# rewrites the inc/value low half -- for r0:r1 that write lands in the
# discard sink (or the dead low word of this view), so the write stays
# discarded while nonzero pairs keep their raw window.
r1215: xr1215 is xr1215 & xr1215=0	{ local x:8 = zext(r1) << 32; export x; }
r1215: xr1215 is xr1215			{ export xr1215; }
# Floating-point condition names for the SIMD compare (bits 17-20).
attach names [fcond1720]
  ["f" "un" "eq" "ueq" "olt" "ult" "ole" "ule" "sf" "ngle" "seq" "ngl" "lt" "nge" "le" "ngt"];
@endif


@if defined(V850E2M)
attach variables [ SR0004 SR1115 ] [
    EIPC    EIPSW   FEPC    FEPSW   ECR     PSW     FPSR    FPEPC
    FPST    FPCC    FPCFG   SCCFG   SCBP    EIIC    FEIC    DBIC
    CTPC    CTPSW   DBPC    DBPSW   CTBP    DIR     DBG22   DBG23
    DBG24   DBG25   DBG26   DBG27   EIWR    FEWR    DBWR    BSEL
];
@elif defined(V850E3)
# RH850G3M selection ID 0 (R01US0123EJ0140 Table 3-3).
attach variables [ SR0004 SR1115 ] [
    EIPC    EIPSW   FEPC    FEPSW   _       PSW     FPSR    FPEPC
    FPST    FPCC    FPCFG   FPEC    _       EIIC    FEIC    _
    CTPC    CTPSW   _       _       CTBP    _       _       _
    _       _       _       _       EIWR    FEWR    _       BSEL
];
@elif defined(V850E1F)
# V850E/PHO3 E1F register IDs (R01UH0128ED0730 Table 3-3).
attach variables [ SR0004 SR1115 ] [
    EIPC    EIPSW   FEPC    FEPSW   ECR     PSW     _       _
    _       _       _       _       _       _       _       _
    CTPC    CTPSW   DBPC    DBPSW   CTBP    _       _       _
    _       _       _       _       _       _       _       _
];
@endif



addr9: rel is op0406 & s1115
[ rel = ((s1115 << 4) | (op0406 << 1)) + inst_start; ] { export *:4 rel; }
addr22: rel is s0005; op1631 & op1616=0
[ rel = ((s0005 << 16) | op1631) + inst_start; ] { export *:4 rel; }
addr32: rel is op1731 & op1616=0; op3247
[ rel = ((op3247 << 16) | op1731 << 1) + inst_start; ] { export *:4 rel; }
addr32abs: rel is op1731 & op1616=0; op3247
[ rel = ((op3247 << 16) | op1731 << 1); ] { export *[const]:4 rel; }

@if defined (V850E3)
addr17b: rel is s0404 ; op1731 & op1616=1
[ rel = ((s0404 << 16) | (op1731 << 1)) + inst_start; ] { export *:4 rel; }

addr16loop: rel is op1731
[ rel = inst_start - (op1731 << 1); ] { export *:4 rel; }

@endif


# PSW flags manipulations
macro setZ(res) 		{	$(PSW_Z) = ((res) == 0);	}
macro setS(res) 		{	$(PSW_S) = ((res) s< 0);	}
macro setOV(res)		{	$(PSW_OV) = res;	}
macro clrOV() 			{	$(PSW_OV) = 0;		}
macro set_S_Z(res)		{	setS(res); setZ(res);	}
macro set_nOV_S_Z(res)	{	clrOV(); set_S_Z(res);	}
macro set_C(res) 		{	$(PSW_CY) = (res != 0);	}
macro flags_add(op1,op2) {
	local A:4 = op1;		local B:4 = op2;		local R = A + B;
	local sA  = A s< 0;		local sB  = B s< 0;		local sR = R s< 0;
	$(PSW_OV) = (sA == sB) && (sB != sR);
	$(PSW_CY) = carry(A, B);
	set_S_Z (R);
}
macro flags_sub(op1,op2) {
	local A:4 = op1;		local B:4 = op2;		local R = A - B;
	local sA  = A s< 0;		local sB  = B s< 0;		local sR = R s< 0;
	$(PSW_OV) = (sA != sB) && (sB == sR);
	$(PSW_CY) = (A < B);
	set_S_Z (R);
}

# read r0 always return zero
R0004: xR0004 is xR0004 & xR0004=0	{	local x:4=0; export x;	}
R0004: xR0004 is xR0004				{	export xR0004;	}

R1115: xR1115 is xR1115 & xR1115=0	{	local x:4=0; export x;	}
R1115: xR1115 is xR1115				{	export xR1115;	}

R2731: xR2731 is xR2731 & xR2731=0	{	local x:4=0; export x;	}
R2731: xR2731 is xR2731				{	export xR2731;	}

