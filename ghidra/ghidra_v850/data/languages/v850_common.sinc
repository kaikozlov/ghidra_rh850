# sleigh specification file for Renesas v850
#   >> see docs/languages/sleigh.htm or sleigh.pdf for Sleigh syntax

define endian=little;
define alignment=2;

define space ram      type=ram_space      size=4  default;
define space register type=register_space size=4;

# general purpose registers
# r0 is architecturally fixed zero: the scalar operand subtables below read
# it as constant 0 and discard writes, so its raw storage is display-only.
# It therefore lives OUTSIDE the 8-byte pair window at offset 0x00: the
# r0r1 pair spans [r0sink | r1], so writing the r0:r1 pair commits the high
# word to r1 and the architecturally discarded low word lands in r0sink --
# no instruction ever writes r0's own storage. r1..lp keep their offsets,
# and the r0sink low half is never read back through any pair view (see
# the R0004pair/R1115pair/R2731pair read subtables below).
define register offset=0x00 size=4 
	[ r0sink r1 r2 sp gp tp r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 r16 r17 r18 r19 r20 r21 r22 r23 r24 r25 r26 r27 r28 r29 ep lp ];
define register offset=0x00 size=8 
	[ r0r1  r2sp  gptp  r6r7  r8r9  r10r11  r12r13  r14r15  r16r17  r18r19  r20r21  r22r23  r24r25  r26r27  r28r29  eplp  ];
define register offset=0x1080 size=4 [ r0 ];

# special registers
@if defined(V850E2M)
define register offset=0x80 size=4 [
    EIPC    EIPSW   FEPC    FEPSW   ECR     PSW     FPSR    FPEPC
    FPST    FPCC    FPCFG   SCCFG   SCBP    EIIC    FEIC    DBIC
    CTPC    CTPSW   DBPC    DBPSW   CTBP    DIR     DBG22   DBG23
    DBG24   DBG25   DBG26   DBG27   EIWR    FEWR    DBWR    BSEL
];
@elif defined(V850E3)
define register offset=0x80 size=4 [
    EIPC    EIPSW   FEPC    FEPSW   _       PSW     FPSR    FPEPC
    FPST    FPCC    FPCFG   FPEC    _       EIIC    FEIC    _
    CTPC    CTPSW   _       _       CTBP    _       _       _
    _       _       _       _       EIWR    FEWR    _       BSEL
];
@elif defined(V850E1F)
# V850E/PHO3 E1F register IDs (R01UH0128ED0730 Table 3-3).
define register offset=0x80 size=4 [
    EIPC    EIPSW   FEPC    FEPSW   ECR     PSW     _       _
    _       _       _       _       _       _       _       _
    CTPC    CTPSW   DBPC    DBPSW   CTBP    _       _       _
    _       _       _       _       _       _       _       _
];
# E1F floating-point arithmetic flag and control registers.
define register offset=0x1010 size=4 [ EFG ECT ];
@endif

define register offset=0x1000 size=4 [ PC ];

@if defined(V850E2M)
# FPU-bank SR11 (BSEL=0x2000), distinct from the legacy CPU-bank SR11.
define register offset=0x1010 size=4 [ FPEC ];
@endif

@if defined(V850E3)
# Internal state used to model multi-register stack operations and the
# architectural load-link monitor. These are not software-visible registers.
define register offset=0x10000 size=4 [
	mult_addr
	popspContext
	ll_addr
	ll_valid
];
define context popspContext
	regNum = (0,4)
	counter	= (5,9)
;
@endif

# RH850G3M Table 5-3: local writes invalidate reservations in 32-byte units.
# Check both endpoints so an unaligned write spanning two units hits either.
# The legacy V850E2 language has no load-link monitor.
macro invalidate_link_store(addr, width) {
@if defined(V850E3)
	local last:4 = addr + width - 1;
	local linked_unit:4 = ll_addr & 0xffffffe0;
	ll_valid = ll_valid & zext((addr & 0xffffffe0) != linked_unit)
		& zext((last & 0xffffffe0) != linked_unit);
@endif
}

macro clear_link() {
@if defined(V850E3)
	ll_valid = 0;
@endif
}

@if defined(V850VECTOR)
# DSP SESR is SR12,0 in the public V850E3V5 simulator model
# (sim/v850/v850-sim.h): OV bit 0, accumulated SOV bit 1.
define register offset=0xb0 size=4 [ SESR ];
# RH850 DSP vector registers (64-bit) and SIMD FPU registers (128-bit).
# Separate architectural register files: V0-V31 hold packed 16/32/64-bit
# integer lanes; W0-W31 hold four 32-bit floating-point lanes.
define register offset=0x2000 size=8 [
	v0 v1 v2 v3 v4 v5 v6 v7 v8 v9 v10 v11 v12 v13 v14 v15
	v16 v17 v18 v19 v20 v21 v22 v23 v24 v25 v26 v27 v28 v29 v30 v31
];
define register offset=0x2100 size=16 [
	w0 w1 w2 w3 w4 w5 w6 w7 w8 w9 w10 w11 w12 w13 w14 w15
	w16 w17 w18 w19 w20 w21 w22 w23 w24 w25 w26 w27 w28 w29 w30 w31
];
# Debug-mode return context (DBPC/DBPSW equivalents); not software-visible
# through LDSR/STSR on the RH850 profiles modeled here.
define register offset=0x1020 size=4 [ dbg_pc dbg_psw dbg_dir ];

# G4MH SIMD floating-point status/control (broad-language only): mirrors the
# G3M FPSR bit layout so the scalar fp32_fused helper can consume it directly.
@if defined(V850SIMD)
# Extended floating-point function system registers (R01UH0770EJ0121
# Table 3.54; selID 10): FXSR regID 6, FXST 8, FXINFO 9, FXCFG 10, FXXC 12,
# FXXP 13. FXSR is the only storage; its canonical value is
# (v & 0x00ceffff) | 0x00200000 (FN23, IF22, RM19:18, FS17, XC15:10, XE9:5,
# XP4:0 writable, bit 21 reads 1, Table 3.55). FXST/FXCFG project FXSR
# fields and FXINFO reads as constant 3, so those three varnodes hold no
# state of their own -- they exist so the selID-10 constructors can display
# the Table 3.54 names through the SR0004_a/SR1115_a attachment. FXXC/FXXP
# carry the per-arithmetic-way cause/preservation bits (Tables 3.59-3.60)
# and never alias FXSR.
define register offset=0x1030 size=4 [ FXSR FXST FXINFO FXCFG FXXC FXXP ];
# Indexed MPU descriptor state (R01UH0770EJ0121 Tables 3.61, 3.69-3.72;
# R01UH0865EJ0140 Tables 2.5/3.12/3.13 and Section 5.1.8): MPIDX (SR16,5)
# holds the 5-bit index of the region whose {MPLA, MPUA, MPAT} (SR20-22,5)
# is exposed through the indexed system-register interface, and MPBK
# (SR17,5, SV permission; HV when virtualization is enabled) selects the
# descriptor bank processed by LDM.MP/STM.MP, the indexed views, and the
# protection checks -- the architecture allows two banks (MPCFG.NBK =
# banks minus one). MPBK.BK occupies bits 1:0, not just bit 0
# (R01UH0864EJ0150 Table 3.72): an out-of-range write is ignored,
# preserving the old bank. This broad profile models the two-bank extent.
# The G4MH virtualization profile that defines MPBK implements 32 entries
# (Table 3.13 NMPUE = 31), so the whole 5-bit region range is
# architecturally addressable and the per-region, per-bank descriptor file
# is addressed directly in register space as 0x1100 + bank*0x180 +
# region*12 (+0 MPLA, +4 MPUA, +8 MPAT); E2x-FCC2 implements only 24
# entries (its regions 24-31 are an undefined-register window, R01UH0770
# Table 3.69). The MPLA/MPUA/MPAT varnodes are display anchors only: every
# access projects that backing.
define register offset=0x1050 size=4 [ MPIDX MPLA MPUA MPAT MPBK ];
@endif
@endif


@define PSW_PP  "PSW[19,1]"
@define PSW_NPW "PSW[18,1]"
@define PSW_DMP "PSW[17,1]"
@define PSW_IMP "PSW[16,1]"
@define PSW_EBV "PSW[15,1]"
@define PSW_UM  "PSW[30,1]"
@define PSW_NP  "PSW[7,1]"
@define PSW_EP  "PSW[6,1]"
@define PSW_ID  "PSW[5,1]"
@define PSW_SAT "PSW[4,1]"
@define PSW_CY  "PSW[3,1]"
@define PSW_OV  "PSW[2,1]"
@define PSW_S   "PSW[1,1]"
@define PSW_Z   "PSW[0,1]"




define pcodeop __synchronize;
define pcodeop __halt;
define pcodeop __snooze;
define pcodeop __disable_irq;
define pcodeop __enable_irq;
# Named G3M cache/prefetch operations (R01US0123EJ0140 Tables 7-7 and 7-8).
define pcodeop __chbii;
define pcodeop __cibii;
define pcodeop __cfali;
define pcodeop __cisti;
define pcodeop __cildi;
define pcodeop __prefi;

# Analysis-only nondeterministic result of an ABI-clobbered register.
# A callfixup replaces CALL, so the native call's kill effects must be
# retained explicitly. This is not an instruction or a physical helper.
define pcodeop __v850_abi_clobber;


macro ternary(res, cond, avar, bvar) {
	res = (avar * zext(cond != 0)) + (bvar * zext(cond == 0));
}
macro condition(res, cond, true_val, false_val) {
	if (cond) goto <true>;
		res = false_val;
		goto <end>;
	<true>
		res = true_val;
	<end>
}

