<?xml version="1.0" encoding="UTF-8"?>

<!--
  Renesas V850/RH850 compiler specification — Renesas CC-RH.

  Models the CC-RH (Renesas rh850) ABI as classified by the IDA nec850
  module (ABI_RH850 without abi_align8) and the CC-RH Compiler User's
  Manual:

    - arguments in r6..r9, then the caller's stack;
    - NO 8-byte pair alignment: 64-bit values simply take the next two
      argument registers / consecutive stack slots;
    - aggregates larger than the available registers split across the
      remaining registers and then the stack (register-stack split) —
      CC-RH passes large aggregates by value, not by reference;
    - scalar returns in r10 (32-bit) or r10:r11 (64-bit);
    - ALL structures and unions are returned through a hidden return
      buffer pointer in r6 (CC-RH manual section on return values),
      regardless of size;
    - varargs: 4-byte floating-point arguments in the variable part are
      promoted to 8-byte doubles (not expressible in a cspec prototype;
      handled by signatures/callfixups);
    - callee-saves: r20..r29, sp, gp, tp AND ep (r30): CC-RH V2.08
      documents r30 as a fixed/callee-saved register, so ep is
      preserved here by default rather than volatile.

  The default GHS MULTI specification uses volatile ep. This selectable
  variant follows the documented CC-RH classification. The analyzer's
  exact callee-save policy option can still override {ep, gp, tp, r2}
  per program at runtime.
-->
<compiler_spec>
  <data_organization>
     <absolute_max_alignment value="0" />
     <machine_alignment value="4" />
     <default_alignment value="1" />
     <default_pointer_alignment value="4" />
     <pointer_size value="4" />
     <wchar_size value="4" />
     <short_size value="2" />
     <integer_size value="4" />
     <long_size value="4" />
     <long_long_size value="8" />
     <float_size value="4" />
     <double_size value="8" />
     <long_double_size value="8" />
     <size_alignment_map>
          <entry size="1" alignment="1" />
          <entry size="2" alignment="2" />
          <entry size="4" alignment="4" />
          <entry size="8" alignment="8" />
     </size_alignment_map>
  </data_organization>
  <global>
    <range space="ram"/>
  </global>
  <stackpointer register="sp" space="ram" growth="negative"/>
  <returnaddress>
    <register name="lp"/>
  </returnaddress>

  <default_proto>
    <prototype name="__stdcall" extrapop="0" stackshift="0">
      <input>
        <group>
          <pentry minsize="4" maxsize="4" storage="hiddenret">
            <register name="r6"/>
          </pentry>
          <pentry minsize="1" maxsize="4" extension="inttype">
            <register name="r6"/>
          </pentry>
        </group>
        <pentry minsize="1" maxsize="4" extension="inttype">
          <register name="r7"/>
        </pentry>
        <pentry minsize="1" maxsize="4" extension="inttype">
          <register name="r8"/>
        </pentry>
        <pentry minsize="1" maxsize="4" extension="inttype">
          <register name="r9"/>
        </pentry>
        <pentry minsize="1" maxsize="500" align="4">
          <addr offset="0" space="stack"/>
        </pentry>
        <!-- CC-RH: no 8-byte pair alignment; multi-word values split
             across remaining registers and then the stack. -->
        <rule>
          <datatype name="any"/>
          <join/>
        </rule>
      </input>
      <output>
        <pentry minsize="1" maxsize="4" extension="inttype">
          <register name="r10"/>
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="r11"/>
        </pentry>
        <!-- CC-RH: ALL structures and unions are returned through a hidden
             return buffer pointer in r6, regardless of size. -->
        <rule>
          <datatype name="struct"/>
          <hidden_return voidlock="true"/>
        </rule>
        <rule>
          <datatype name="union"/>
          <hidden_return voidlock="true"/>
        </rule>
        <rule>
          <datatype name="any"/>
          <join/>
        </rule>
      </output>
      <!-- CC-RH: r30 (ep) is documented fixed/callee-saved. -->
      <unaffected>
        <register name="sp"/>
        <register name="gp"/>
        <register name="tp"/>
        <register name="r20"/>
        <register name="r21"/>
        <register name="r22"/>
        <register name="r23"/>
        <register name="r24"/>
        <register name="r25"/>
        <register name="r26"/>
        <register name="r27"/>
        <register name="r28"/>
        <register name="r29"/>
        <register name="ep"/>
      </unaffected>
      <killedbycall>
        <register name="r0"/>
        <register name="r1"/>
        <register name="r2"/>
        <register name="r6"/>
        <register name="r7"/>
        <register name="r8"/>
        <register name="r9"/>
        <register name="r10"/>
        <register name="r11"/>
        <register name="r12"/>
        <register name="r13"/>
        <register name="r14"/>
        <register name="r15"/>
        <register name="r16"/>
        <register name="r17"/>
        <register name="r18"/>
        <register name="r19"/>
        <register name="lp"/>
      </killedbycall>
    </prototype>
  </default_proto>

  <!-- Interrupt / exception handler prototype: no ABI arguments, returns to
       a saved EIPC/FEPC context via eiret/reti/feret; preserves every GPR. -->
  <prototype name="__interrupt" extrapop="0" stackshift="0">
    <input></input>
    <output killedbycall="true"></output>
    <unaffected>
      <register name="r1"/>
      <register name="r2"/>
      <register name="sp"/>
      <register name="gp"/>
      <register name="tp"/>
      <register name="r6"/>
      <register name="r7"/>
      <register name="r8"/>
      <register name="r9"/>
      <register name="r10"/>
      <register name="r11"/>
      <register name="r12"/>
      <register name="r13"/>
      <register name="r14"/>
      <register name="r15"/>
      <register name="r16"/>
      <register name="r17"/>
      <register name="r18"/>
      <register name="r19"/>
      <register name="r20"/>
      <register name="r21"/>
      <register name="r22"/>
      <register name="r23"/>
      <register name="r24"/>
      <register name="r25"/>
      <register name="r26"/>
      <register name="r27"/>
      <register name="r28"/>
      <register name="r29"/>
      <register name="ep"/>
      <register name="lp"/>
    </unaffected>
  </prototype>
</compiler_spec>
