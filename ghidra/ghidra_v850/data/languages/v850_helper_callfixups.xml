  <!-- These three payloads preserve the complete pinned GCC 16.2 V850
       helper machine behavior, including counts outside the C-defined
       0..63 domain. The reference first computes 32-count modulo 2^32,
       chooses an arm by its signed value, then uses 32-bit shifts with
       the hardware low-five-bit count. Count zero is a separate arm.
       data/arithmetic/v850_arithmetic_reference_templates.json owns the
       exact whole-body recognition inputs; do not reuse the GHS payload. -->
  <callfixup name="v850_gcc_ashldi3">
    <pcode>
      <body><![CDATA[
        local low:4 = r6;
        local high:4 = r7;
        local count:4 = r8 & 0x1f;
        local remaining:4 = 32 - r8;
        if (r8 == 0) goto <done>;
        if (remaining s<= 0) goto <large>;
        high = (high << count) | (low >> (remaining & 0x1f));
        low = low << count;
        goto <done>;
        <large>
        high = low << count;
        low = 0;
        <done>
        r10 = low;
        r11 = high;
      ]]></body>
    </pcode>
  </callfixup>

