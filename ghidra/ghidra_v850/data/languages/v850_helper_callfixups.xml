  <!-- GCC libgcc three-way compares: 0 (a<b), 1 (a==b), 2 (a>b) in r10.
       The other libgcc DI helpers (__adddi3 and family) reuse the GHS
       payloads above; their register ABI and results are identical.
       The payload is deliberately branch-free: 1 + (a>b) - (a<b) is the
       exact three-way contract, and the decompiler never prunes an
       untaken constant-condition CBRANCH arm, so a branchy encoding can
       never constant-fold at constant call sites (the result would stay
       a MULTIEQUAL of the three arms). The straight-line form keeps the
       two relation ops live for variable arguments and folds 0/1/2 for
       constant arguments. `a s> b` lowers to a REVERSED INT_SLESS, so
       each payload contributes exactly two comparison ops. -->
  <callfixup name="v850_gcc_cmpdi2">
    <target name="__cmpdi2"/>
    <pcode>
      <body><![CDATA[
        local a:8 = (zext(r7) << 32) | zext(r6);
        local b:8 = (zext(r9) << 32) | zext(r8);
        local lt:1 = a s< b;
        local gt:1 = a s> b;
        local ltv:4 = zext(lt);
        local gtv:4 = zext(gt);
        r10 = 1 + gtv - ltv;
      ]]></body>
    </pcode>
  </callfixup>

