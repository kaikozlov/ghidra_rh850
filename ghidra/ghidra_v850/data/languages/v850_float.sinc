@include "v850_fused.sinc"

# Commit only when no enabled exception occurred. XC/FPEPC retain the last
# enabled exception; XP and G3M IF are sticky. Negation is in the numeric core.
macro fp_multiply_add(destination, a, b, c, operation, instruction_pc, next_pc) {
  if ((FPEC & 1) != 0) goto <done>;
  local result:4 = 0;
  local raised:4 = 0;
  local flushed:4 = 0;
  fp32_fused(result, raised, flushed, a, b, c, operation, FPSR);
@if defined(V850E3)
  FPSR = FPSR | (flushed << 22);
@endif
  local enabled:1 = ((raised & 0x20) != 0) || ((raised & (FPSR >> 5) & 0x1f) != 0);
  if (enabled) goto <exception>;
    destination = result;
    FPSR = FPSR | (raised & 0x1f);
    fp_refresh_views();
    goto <done>;
  <exception>
  FPSR = (FPSR & 0xffff03ff) | (raised << 10);
  FPEPC = instruction_pc;
@if defined(V850E2M)
  local precise:4 = (FPSR >> 20) & 1;
  FPSR = (FPSR & 0xfffeffff) | (precise << 16);
@else
  local precise:4 = (FPSR >> 21) & 1;
@endif
  fp_refresh_views();
  if (precise == 0) goto <imprecise>;
    local handler:4 = 0;
    enter_ei_exception(instruction_pc, 0x71, 0x70, handler);
@if defined(V850E2M)
    ECR = (ECR & 0xffff0000) | 0x71;
@endif
    call [handler];
    goto <done>;
  <imprecise>
  FPEC = 1;
  fp_acknowledge_pending(next_pc);
  <done>
}

# ABSF.D reg2, reg3
:absf.d R1115pair, R2731pair is R1115pair & op0510=0x3F & op0004=0b00000; R2731pair & op2126=0b100010 & op1620=0b11000 {
  if ((FPEC & 1) != 0) goto <fp_invalidated>;
  R2731pair = abs(R1115pair);
  <fp_invalidated>
}

# ABSF.S reg2, reg3
:absf.s R1115, R2731 is R1115 & op0510=0x3F & op0004=0b00000; R2731 & op2126=0b100010 & op1620=0b01000 {
  if ((FPEC & 1) != 0) goto <fp_invalidated>;
  R2731 = abs(R1115);
  <fp_invalidated>
}

# ADDF.D reg1, reg2, reg3
:addf.d R0004pair, R1115pair, R2731pair is R1115pair & op0510=0x3F & R0004pair ; R2731pair & op2126=0b100011 & op1620=0b10000 {
  if ((FPEC & 1) != 0) goto <fp_invalidated>;
  R2731pair = R1115pair f+ R0004pair;
  <fp_invalidated>
}

# ADDF.S reg1, reg2, reg3
:addf.s R0004, R1115, R2731 is R1115 & op0510=0x3F & R0004 ; R2731 & op2126=0b100011 & op1620=0b00000 {
  if ((FPEC & 1) != 0) goto <fp_invalidated>;
  R2731 = R1115 f+ R0004;
  <fp_invalidated>
}

# CEILF.DL reg2, reg3
:ceilf.dl R1115pair, R2731pair is R1115pair & op0510=0x3F & op0004=0b00010; R2731pair & op2126=0b100010 & op1620=0b10100 {
  if ((FPEC & 1) != 0) goto <fp_invalidated>;
  local tmp:8 = ceil(float2float(R1115pair));
  R2731pair = trunc(tmp);
  <fp_invalidated>
}

