# Round-to-nearest, ties-to-even conversions. The p-code round() primitive
# does NOT implement ties-to-even, so the tie cases are selected explicitly
# (R01US0209EJ0220 2.4.4.68 p.354 for the scalar form).
# SLEIGH has no floating-point literals: thresholds and limits are carried
# as IEEE-754 bit patterns via sized locals. Masked-exception datapath
# results follow the G4MH ROUNDF descriptions: NaN/negative inputs to the
# unsigned forms produce 0, positive overflow (including +inf) produces the
# unsigned maximum; signed forms saturate to the matching signed extreme,
# NaN produces the signed minimum (pp.346/354).
macro round_ieee_to_signed64(dest, source) {
	local value:8 = source;
	local half:8 = 0x3fe0000000000000;
	local nhalf:8 = 0xbfe0000000000000;
	local integer:8 = trunc(value);
	local integral:8 = int2float(integer);
	local fraction:8 = value f- integral;
	if ((fraction f> half) || ((fraction f== half) && ((integer & 1) != 0))) goto <round_up>;
	if ((fraction f< nhalf) || ((fraction f== nhalf) && ((integer & 1) != 0))) goto <round_down>;
	goto <rounded>;
	<round_up>
	integer = integer + 1;
	goto <rounded>;
	<round_down>
	integer = integer - 1;
	<rounded>
	dest = integer;
}

macro round_f64_to_word_ne(dest, source, unsigned_mode) {
	local value:8 = source;
	local unsigned:1 = unsigned_mode;
	local maximum:4 = 0x7fffffff;
	local minimum:4 = 0x80000000;
	local positive_limit:8 = 0x41e0000000000000;
	local negative_limit:8 = 0xc1e0000000000000;
	if (unsigned == 0) goto <limits_ready>;
	maximum = 0xffffffff;
	minimum = 0;
	positive_limit = 0x41f0000000000000;
	negative_limit = 0;
	<limits_ready>
	dest = minimum;
	if (nan(value)) goto <done>;
	if (value f< negative_limit) goto <done>;
	if (!(value f< positive_limit)) goto <saturate_upper>;
	local integer:8 = 0;
	round_ieee_to_signed64(integer, value);
	if (unsigned != 0) goto <unsigned_value>;
	if (integer s> 0x7fffffff) goto <saturate_upper>;
	goto <in_range>;
	<unsigned_value>
	if (integer > 0xffffffff) goto <saturate_upper>;
	<in_range>
	dest = integer:4;
	goto <done>;
	<saturate_upper>
	dest = maximum;
	<done>
}


macro round_f64_to_long_ne(dest, source) {
	local value:8 = source;
	local positive_limit:8 = 0x43e0000000000000;
	local negative_limit:8 = 0xc3e0000000000000;
	dest = 0x8000000000000000;
	if (nan(value)) goto <done>;
	if (value f< negative_limit) goto <done>;
	if (!(value f< positive_limit)) goto <maximum>;
	round_ieee_to_signed64(dest, value);
	goto <done>;
	<maximum>
	dest = 0x7fffffffffffffff;
	<done>
}

macro round_f64_to_ulong_ne(dest, source) {
	local value:8 = source;
	local positive_limit:8 = 0x43f0000000000000;
	local signed_limit:8 = 0x43e0000000000000;
	dest = 0;
	if (nan(value)) goto <done>;
	if (value f< 0) goto <done>;
	if (!(value f< positive_limit)) goto <maximum>;
	if (!(value f< signed_limit)) goto <upper_half>;
	round_ieee_to_signed64(dest, value);
	goto <done>;
	<upper_half>
	# Binary64 spacing is at least 1024 here: every input is integral.
	local low:8 = value f- signed_limit;
	dest = trunc(low) + 0x8000000000000000;
	goto <done>;
	<maximum>
	dest = 0xffffffffffffffff;
	<done>
}

# ROUNDF has a fixed nearest-even mode, independent of FPSR.RM.
# Invalid (V) supersedes inexact (I); FS-clear subnormal inputs raise E.
# Numeric limits and exception rules: R01US0209EJ0220 pp.340-355;
# input flushing/status precedence: R01US0123EJ0140 §§3.4/6.1.
macro fp_round_integer(result, raised, flushed, source, unsigned_mode, wide_mode, double_source) {
	local value:8 = source;
	local unsigned:1 = unsigned_mode;
	local wide:1 = wide_mode;
	local is_double:1 = double_source;
	local magnitude:8 = value & 0x7fffffffffffffff;
	local normal_limit:8 = 0x0010000000000000;
	if (is_double != 0) goto <normal_limit_ready>;
	normal_limit = 0x3810000000000000;
	<normal_limit_ready>
	raised = 0;
	flushed = 0;
	if ((magnitude == 0) || (magnitude >= normal_limit)) goto <input_ready>;
	if ((FPSR & 0x20000) != 0) goto <flush_input>;
	raised = 0x20;
	result = 0;
	goto <done>;
	<flush_input>
	flushed = 1;
	value = value & 0x8000000000000000;
	<input_ready>
	if (wide != 0) goto <wide_result>;
	local word:4 = 0;
	round_f64_to_word_ne(word, value, unsigned);
	result = sext(word);
	if (unsigned == 0) goto <numeric_ready>;
	result = zext(word);
	goto <numeric_ready>;
	<wide_result>
	if (unsigned != 0) goto <unsigned_result>;
	round_f64_to_long_ne(result, value);
	goto <numeric_ready>;
	<unsigned_result>
	round_f64_to_ulong_ne(result, value);
	<numeric_ready>
	if (nan(value)) goto <invalid>;
	if ((unsigned != 0) && (value f< 0)) goto <invalid>;
	if ((wide != 0) && (unsigned != 0)) goto <unsigned_wide_range>;
	local positive_limit:8 = 0x43e0000000000000;
	local negative_limit:8 = 0xc3e0000000000000;
	if (!(value f< positive_limit)) goto <invalid>;
	if (value f< negative_limit) goto <invalid>;
	if (wide != 0) goto <in_range>;
	local integer:8 = 0;
	round_ieee_to_signed64(integer, value);
	if (unsigned != 0) goto <unsigned_word_range>;
	if ((integer s< -0x80000000) || (integer s> 0x7fffffff)) goto <invalid>;
	goto <in_range>;
	<unsigned_word_range>
	if (integer > 0xffffffff) goto <invalid>;
	goto <in_range>;
	<unsigned_wide_range>
	local unsigned_limit:8 = 0x43f0000000000000;
	if (!(value f< unsigned_limit)) goto <invalid>;
	<in_range>
	local converted:8 = int2float(result);
	if ((unsigned == 0) || ((result & 0x8000000000000000) == 0)) goto <conversion_ready>;
	local folded:8 = (result >> 1) | (result & 1);
	converted = int2float(folded);
	local two:8 = 0x4000000000000000;
	converted = converted f* two;
	<conversion_ready>
	raised = zext((converted f!= value) || (flushed != 0));
	goto <done>;
	<invalid>
	raised = 0x10;
	<done>
}

