# CMOVF.D fcbit, reg1, reg2, reg3
:cmovf.d fcbit1719, R0004pair, R1115pair, xR2731pair is R1115pair & op0510=0x3F & R0004pair; xR2731pair & op2126=0b100000 & op2020=1 & fcbit1719 & op1616=0 {
  if ((FPEC & 1) != 0) goto <fp_invalidated>;
  local tmp:8 = zext(FPSR >> (fcbit1719:1 + 24:1)) & 0x1;
  xR2731pair = (tmp * R0004pair) | ((1-tmp) * R1115pair);
  <fp_invalidated>
}

# CMOVF.S fcbit, reg1, reg2, reg3
:cmovf.s fcbit1719, R0004, R1115, R2731 is R1115 & op0510=0x3F & R0004; R2731 & op2126=0b100000 & op2020=0 & fcbit1719 & op1616=0 {
  if ((FPEC & 1) != 0) goto <fp_invalidated>;
  local tmp:4 = (FPSR >> (fcbit1719:1 + 24:1)) & 0x1;
  R2731 = (tmp * R0004) | ((1-tmp) * R1115);
  <fp_invalidated>
}

macro compare_float(fcond, reg2, reg1, result) {
  local un = (fcond & 1)        && (nan(reg2) || nan(reg1));
  local eq = ((fcond & 6) == 2) && (reg2 f== reg1);
  local lt = ((fcond & 6) == 4) && (reg2 f<  reg1);
  local le = ((fcond & 6) == 6) && (reg2 f<= reg1);
  # Trap delivery for enabled IEEE-754 invalid-operation exceptions is outside
  # SLEIGH p-code; the non-trapping comparison result and FPSR.CC update are modeled.
  result = zext(un || eq || lt || le);
}

# CMPF.D reg2, reg3
:cmpf.d fcond2730, R1115pair, R0004pair, fcbit1719 is R1115pair & op0510=0x3F & R0004pair; op3131=0 & fcond2730 & op2126=0b100001 & op2020=1 & fcbit1719 & op1616=0 {
  if ((FPEC & 1) != 0) goto <fp_invalidated>;
  local res:4 = 0;
  compare_float (fcond2730:1, R1115pair, R0004pair, res);

  local newbit:4 = res << (24 + fcbit1719);
  local ones:4 = 1 << (24 + fcbit1719);
  FPSR = (FPSR & ~ones) | newbit;
  fp_refresh_views();
  <fp_invalidated>
}

# CMPF.S reg2, reg3
:cmpf.s fcond2730, R1115, R0004, fcbit1719 is R1115 & op0510=0x3F & R0004; op3131=0 & fcond2730 & op2126=0b100001 & op2020=0 & fcbit1719 & op1616=0 {
  if ((FPEC & 1) != 0) goto <fp_invalidated>;
  local res:4 = 0;
  compare_float (fcond2730:1, R1115, R0004, res);

  local newbit:4 = res << (24 + fcbit1719);
  local ones:4 = 1 << (24 + fcbit1719);
  FPSR = (FPSR & ~ones) | newbit;
  fp_refresh_views();
  <fp_invalidated>
}

# P-code has no dynamic rounding-mode input; conversions use Ghidra's floating
# primitive while preserving the architectural operand and result widths.
# CVTF.DL reg2, reg3
:cvtf.dl R1115pair, xR2731pair is R1115pair & op0510=0x3F & op0004=0b00100; xR2731pair & op2126=0b100010 & op1620=0b10100 {
  if ((FPEC & 1) != 0) goto <fp_invalidated>;
  xR2731pair = trunc(R1115pair);
  <fp_invalidated>
}

