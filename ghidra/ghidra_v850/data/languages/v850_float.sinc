# CVTF.ULD reg2, reg3
:cvtf.uld R1115pair, xR2731pair is R1115pair & op0510=0x3F & op0004=0b10001; xR2731pair & op2126=0b100010 & op1620=0b10010 {
  if ((FPEC & 1) != 0) goto <fp_invalidated>;
  if ((R1115pair >> 63) == 0) goto <small>;
    local folded:8 = (R1115pair >> 1) | (R1115pair & 1);
    local two:8 = 2;
    local folded_float:8 = int2float(folded);
    local two_float:8 = int2float(two);
    xR2731pair = folded_float f* two_float;
    goto <done>;
  <small>
    xR2731pair = int2float(R1115pair);
  <done>
  <fp_invalidated>
}

# CVTF.ULS reg2, reg3
:cvtf.uls R1115pair, R2731 is R1115pair & op0510=0x3F & op0004=0b10001; R2731 & op2126=0b100010 & op1620=0b00010 {
  if ((FPEC & 1) != 0) goto <fp_invalidated>;
  if ((R1115pair >> 63) == 0) goto <small>;
    local folded:8 = (R1115pair >> 1) | (R1115pair & 1);
    local two:8 = 2;
    local folded_float:4 = int2float(folded);
    local two_float:4 = int2float(two);
    R2731 = folded_float f* two_float;
    goto <done>;
  <small>
    R2731 = int2float(R1115pair);
  <done>
  <fp_invalidated>
}

