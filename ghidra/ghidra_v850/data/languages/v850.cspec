<?xml version="1.0" encoding="UTF-8"?>

<!--
  Renesas V850 / RH850 compiler specification.

  Calling convention matches the G3-family software ABI shared by the Renesas
  CC-RH and GCC v850 toolchains. Register classification (verified against GCC
  v850 CALL_USED_REGISTERS and against the firmware's own prepare/dispose save
  set r20..r29 + ep + lp):

    r0        reads-as-zero (see v850_common.sinc); volatile
    r1,r2     volatile (assembler temporary)
    sp  (r3)  stack pointer (preserved)
    gp  (r4)  global pointer (preserved; set once at reset)
    tp  (r5)  text/small-data pointer (preserved)
    r6..r9    integer argument registers (volatile)
    r10       return value, low word (volatile)
    r11       return value, high word / 64-bit (volatile)
    r12..r19  volatile scratch
    r20..r29  callee-saved "save registers"
    ep (r30)  element pointer (volatile)
    lp (r31)  link pointer / return address (clobbered by every jarl/call)

  Subroutine calls use `jarl ..., reg` (compiler emits lp); returns use
  `jmp [lp]` or `dispose ..., [reg]` (see v850_func.sinc). Interrupt/exception
  handlers exit via eiret/reti/feret to a saved EIPC/FEPC context
  (see v850_special.sinc), not via lp.
-->
<compiler_spec>
  <data_organization>
     <absolute_max_alignment value="0" />
     <machine_alignment value="4" />
     <default_alignment value="1" />
     <default_pointer_alignment value="4" />
     <pointer_size value="4" />
     <wchar_size value="4" />
     <short_size value="2" />
     <integer_size value="4" />
     <long_size value="4" />
     <long_long_size value="8" />
     <float_size value="4" />
     <double_size value="8" />
     <long_double_size value="8" />
     <size_alignment_map>
          <entry size="1" alignment="1" />
          <entry size="2" alignment="2" />
          <entry size="4" alignment="4" />
          <entry size="8" alignment="8" />
     </size_alignment_map>
  </data_organization>
  <global>
    <range space="ram"/>
  </global>
  <stackpointer register="sp" space="ram" growth="negative"/>

  <default_proto>
    <prototype name="__stdcall" extrapop="0" stackshift="0">
      <!-- Integer args in r6..r9, then the caller's stack (decrementing sp).
           The caller owns and cleans up any stack arguments (extrapop=0). -->
      <input>
        <pentry minsize="1" maxsize="4" extension="inttype">
          <register name="r6"/>
        </pentry>
        <pentry minsize="1" maxsize="4" extension="inttype">
          <register name="r7"/>
        </pentry>
        <pentry minsize="1" maxsize="4" extension="inttype">
          <register name="r8"/>
        </pentry>
        <pentry minsize="1" maxsize="4" extension="inttype">
          <register name="r9"/>
        </pentry>
        <pentry minsize="1" maxsize="500" align="4">
          <addr offset="0" space="stack"/>
        </pentry>
        <!-- Values larger than one register span consecutive arg registers
             (e.g. a 64-bit arg in r6:r7, r8:r9). -->
        <rule>
          <datatype name="any"/>
          <join align="true"/>
        </rule>
      </input>
      <output>
        <pentry minsize="1" maxsize="4" extension="inttype">
          <register name="r10"/>
        </pentry>
        <pentry minsize="1" maxsize="4" extension="inttype">
          <register name="r11"/>
        </pentry>
        <!-- A 64-bit return value occupies r10:r11. -->
        <rule>
          <datatype name="any"/>
          <join/>
        </rule>
      </output>
      <!-- Callee-saved: survive every call. -->
      <unaffected>
        <register name="sp"/>
        <register name="gp"/>
        <register name="tp"/>
        <register name="r20"/>
        <register name="r21"/>
        <register name="r22"/>
        <register name="r23"/>
        <register name="r24"/>
        <register name="r25"/>
        <register name="r26"/>
        <register name="r27"/>
        <register name="r28"/>
        <register name="r29"/>
      </unaffected>
      <!-- Caller-saved (volatile): clobbered by a call. -->
      <killedbycall>
        <register name="r0"/>
        <register name="r1"/>
        <register name="r2"/>
        <register name="r6"/>
        <register name="r7"/>
        <register name="r8"/>
        <register name="r9"/>
        <register name="r10"/>
        <register name="r11"/>
        <register name="r12"/>
        <register name="r13"/>
        <register name="r14"/>
        <register name="r15"/>
        <register name="r16"/>
        <register name="r17"/>
        <register name="r18"/>
        <register name="r19"/>
        <register name="ep"/>
        <register name="lp"/>
      </killedbycall>
    </prototype>
  </default_proto>

  <!-- Interrupt / exception handler prototype.
       An EIINT / FE / DIR handler takes no ABI arguments and returns to a
       saved EIPC/FEPC context via eiret/reti/feret, not via lp. Because it
       interrupts arbitrary code it must preserve every GPR it touches, so all
       general registers are unaffected. Apply manually to handler functions
       (e.g. the EIINT 292/293 crypto-driver callback wrappers). -->
  <prototype name="__interrupt" extrapop="0" stackshift="0">
    <input></input>
    <output killedbycall="true"></output>
    <unaffected>
      <register name="r1"/>
      <register name="r2"/>
      <register name="sp"/>
      <register name="gp"/>
      <register name="tp"/>
      <register name="r6"/>
      <register name="r7"/>
      <register name="r8"/>
      <register name="r9"/>
      <register name="r10"/>
      <register name="r11"/>
      <register name="r12"/>
      <register name="r13"/>
      <register name="r14"/>
      <register name="r15"/>
      <register name="r16"/>
      <register name="r17"/>
      <register name="r18"/>
      <register name="r19"/>
      <register name="r20"/>
      <register name="r21"/>
      <register name="r22"/>
      <register name="r23"/>
      <register name="r24"/>
      <register name="r25"/>
      <register name="r26"/>
      <register name="r27"/>
      <register name="r28"/>
      <register name="r29"/>
      <register name="ep"/>
      <register name="lp"/>
    </unaffected>
  </prototype>
</compiler_spec>
