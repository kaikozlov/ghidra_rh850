  local ra0:4 = 0; local ra1:4 = 0; local ra2:4 = 0; local ra3:4 = 0;
  simd_cvt_hs_lane(ra0, o0, x0[0,16]);
  simd_cvt_hs_lane(ra1, o1, x1[0,16]);
  simd_cvt_hs_lane(ra2, o2, x2[0,16]);
  simd_cvt_hs_lane(ra3, o3, x3[0,16]);
  simd_vector_commit(wR2731, o0, o1, o2, o3, ra0, ra1, ra2, ra3, inst_start);
}

# CVTF.SH4: results are zero-extended to word lanes.
:cvtf.sh4 wR1115, wR2731 is op0510=0x3F & op0004=13 & wR1115; op1626=0x5A0 & wR2731 {
  fxu_check(inst_start);
  local x0:4 = wR1115[0,32]; local x1:4 = wR1115[32,32];
  local x2:4 = wR1115[64,32]; local x3:4 = wR1115[96,32];
  local h0:2 = 0; local h1:2 = 0; local h2:2 = 0; local h3:2 = 0;
  local ra0:4 = 0; local ra1:4 = 0; local ra2:4 = 0; local ra3:4 = 0;
  simd_cvt_sh_lane(ra0, h0, x0);
  simd_cvt_sh_lane(ra1, h1, x1);
  simd_cvt_sh_lane(ra2, h2, x2);
  simd_cvt_sh_lane(ra3, h3, x3);
  local o0:4 = zext(h0);
  local o1:4 = zext(h1);
  local o2:4 = zext(h2);
  local o3:4 = zext(h3);
  simd_vector_commit(wR2731, o0, o1, o2, o3, ra0, ra1, ra2, ra3, inst_start);
}

# ABSF/NEGF: pure sign-bit operations on every lane - not arithmetic
# operations for exception purposes (R01UH0770 3.2.6.2(6)(b), Table 3.125
# note 3: a NaN operand is transformed on the sign bit alone), never
# flushed, never E.
:absf.s4 wR1115, wR2731 is op0510=0x3F & op0004=16 & wR1115; op1626=0x5A0 & wR2731 {
  fxu_check(inst_start);
  wR2731[0,32] = wR1115[0,32] & 0x7fffffff;
  wR2731[32,32] = wR1115[32,32] & 0x7fffffff;
  wR2731[64,32] = wR1115[64,32] & 0x7fffffff;
  wR2731[96,32] = wR1115[96,32] & 0x7fffffff;
}

:negf.s4 wR1115, wR2731 is op0510=0x3F & op0004=17 & wR1115; op1626=0x5A0 & wR2731 {
  fxu_check(inst_start);
  wR2731[0,32] = wR1115[0,32] ^ 0x80000000;
  wR2731[32,32] = wR1115[32,32] ^ 0x80000000;
  wR2731[64,32] = wR1115[64,32] ^ 0x80000000;
  wR2731[96,32] = wR1115[96,32] ^ 0x80000000;
}

:sqrtf.s4 wR1115, wR2731 is op0510=0x3F & op0004=18 & wR1115; op1626=0x5A0 & wR2731 {
  fxu_check(inst_start);
  local x0:4 = wR1115[0,32]; local x1:4 = wR1115[32,32];
  local x2:4 = wR1115[64,32]; local x3:4 = wR1115[96,32];
  local o0:4 = 0; local o1:4 = 0; local o2:4 = 0; local o3:4 = 0;
  local ra0:4 = 0; local ra1:4 = 0; local ra2:4 = 0; local ra3:4 = 0;
  simd_fp_unary(ra0, o0, x0, 0);
  simd_fp_unary(ra1, o1, x1, 0);
  simd_fp_unary(ra2, o2, x2, 0);
  simd_fp_unary(ra3, o3, x3, 0);
  simd_vector_commit(wR2731, o0, o1, o2, o3, ra0, ra1, ra2, ra3, inst_start);
}

# RECIPF.S4 computes 1/x exactly like DIVF.S4 with a 1.0 dividend
# (R01UH0770 3.2.6.2(10)(d)); the DIVF lane op therefore provides the
# complete Z/V/U/I/E accounting.
:recipf.s4 wR1115, wR2731 is op0510=0x3F & op0004=19 & wR1115; op1626=0x5A0 & wR2731 {
  fxu_check(inst_start);
  # Numeric literals in float context are RAW BIT PATTERNS in SLEIGH:
  # 0x3f800000 is 1.0f.
  local f_one:4 = 0x3f800000;
  local x0:4 = wR1115[0,32]; local x1:4 = wR1115[32,32];
  local x2:4 = wR1115[64,32]; local x3:4 = wR1115[96,32];
  local o0:4 = 0; local o1:4 = 0; local o2:4 = 0; local o3:4 = 0;
  local ra0:4 = 0; local ra1:4 = 0; local ra2:4 = 0; local ra3:4 = 0;
  simd_fp_op(ra0, o0, f_one, x0, 2);
  simd_fp_op(ra1, o1, f_one, x1, 2);
  simd_fp_op(ra2, o2, f_one, x2, 2);
  simd_fp_op(ra3, o3, f_one, x3, 2);
  simd_vector_commit(wR2731, o0, o1, o2, o3, ra0, ra1, ra2, ra3, inst_start);
}

:rsqrtf.s4 wR1115, wR2731 is op0510=0x3F & op0004=20 & wR1115; op1626=0x5A0 & wR2731 {
  fxu_check(inst_start);
  local x0:4 = wR1115[0,32]; local x1:4 = wR1115[32,32];
  local x2:4 = wR1115[64,32]; local x3:4 = wR1115[96,32];
  local o0:4 = 0; local o1:4 = 0; local o2:4 = 0; local o3:4 = 0;
  local ra0:4 = 0; local ra1:4 = 0; local ra2:4 = 0; local ra3:4 = 0;
  simd_fp_unary(ra0, o0, x0, 1);
  simd_fp_unary(ra1, o1, x1, 1);
  simd_fp_unary(ra2, o2, x2, 1);
  simd_fp_unary(ra3, o3, x3, 1);
  simd_vector_commit(wR2731, o0, o1, o2, o3, ra0, ra1, ra2, ra3, inst_start);
}

:movv.w4 wR1115, wR2731 is op0510=0x3F & op0004=0x1E & wR1115; op1626=0x5A0 & wR2731 {
  fxu_check(inst_start);
  wR2731 = wR1115;
}

# TRFSRV.W4 imm3, wreg2: publish per-lane (lane != 0) bits to PSW.Z per the
# 3-bit immediate (G4MH p.494 [Operation]): 0-3 select a lane, 4 = AND of
# lanes, 5 = OR of lanes. For 6-7 the manual NOTE is explicit: "The value
# of PSW.Z becomes 0 if 6 or 7 is specified in imm3." Only PSW.Z is
# written; no other PSW bit is touched. No floating-point exceptions.
:trfsrv.w4 op2729, wR1115 is op0510=0x3F & op0004=0x1F & wR1115; op1626=0x5A0 & op2729 & op3031=0 {
  fxu_check(inst_start);
  local val0:1 = wR1115[0,32] != 0;
  local val1:1 = wR1115[32,32] != 0;
  local val2:1 = wR1115[64,32] != 0;
  local val3:1 = wR1115[96,32] != 0;
  local selector:4 = op2729;
  local z:1 = 0;
  if (selector == 0) goto <s0>;
  if (selector == 1) goto <s1>;
  if (selector == 2) goto <s2>;
  if (selector == 3) goto <s3>;
  if (selector == 4) goto <sand>;
  if (selector == 5) goto <sor>;
  z = 0;
  goto <done>;
  <s0> z = val0; goto <done>;
  <s1> z = val1; goto <done>;
  <s2> z = val2; goto <done>;
  <s3> z = val3; goto <done>;
  <sand> z = val0 && val1 && val2 && val3; goto <done>;
  <sor> z = val0 || val1 || val2 || val3;
  <done>
  $(PSW_Z) = z;
}

# FLPV.S4 imm2, wreg2, wreg3: alternating-negation flip transform; the
# exact per-lane layout follows the manual's [Operation] block.
:flpv.s4 0, wR1115, wR2731 is op0510=0x3F & op0002=0 & wR1115; op1626=0x5A0 & wR2731 {
  fxu_check(inst_start);
  wR2731[96,32] = wR1115[96,32];
  wR2731[64,32] = wR1115[64,32] ^ 0x80000000;
  wR2731[32,32] = wR1115[32,32];
  wR2731[0,32] = wR1115[0,32] ^ 0x80000000;
}

:flpv.s4 1, wR1115, wR2731 is op0510=0x3F & op0002=1 & wR1115; op1626=0x5A0 & wR2731 {
  fxu_check(inst_start);
  local b0:4 = wR1115[0,32]; local b1:4 = wR1115[32,32];
  local b2:4 = wR1115[64,32]; local b3:4 = wR1115[96,32];
  wR2731[96,32] = b2;
  wR2731[64,32] = b3 ^ 0x80000000;
  wR2731[32,32] = b0;
  wR2731[0,32] = b1 ^ 0x80000000;
}

:flpv.s4 2, wR1115, wR2731 is op0510=0x3F & op0002=2 & wR1115; op1626=0x5A0 & wR2731 {
  fxu_check(inst_start);
  wR2731[96,32] = wR1115[96,32] ^ 0x80000000;
  wR2731[64,32] = wR1115[64,32];
  wR2731[32,32] = wR1115[32,32] ^ 0x80000000;
  wR2731[0,32] = wR1115[0,32];
}

:flpv.s4 3, wR1115, wR2731 is op0510=0x3F & op0002=3 & wR1115; op1626=0x5A0 & wR2731 {
  fxu_check(inst_start);
  local b0:4 = wR1115[0,32]; local b1:4 = wR1115[32,32];
  local b2:4 = wR1115[64,32]; local b3:4 = wR1115[96,32];
  wR2731[96,32] = b2 ^ 0x80000000;
  wR2731[64,32] = b3;
  wR2731[32,32] = b0 ^ 0x80000000;
  wR2731[0,32] = b1;
}

# ---------------------------------------------------------------------
# 48-bit extended SIMD instructions (format X, op=0x3D, instr2 bit16=1,
# subop4 0xE). All displacements drop their low alignment bits, and the
# manual notes the upper subop bits beyond the register fields are ignored.
# CMOVF.W4 is exempt from flushing and from every floating-point exception
# (R01UH0770 3.2.6.2(6)(b), 3.2.6.2(8)(c)/(d)).
:cmovf.w4 wR3236, wR0004, wR1115, wR2731 is op0510=0x3D & wR0004 & wR1115;
	op1620=0x1D & op2426=6 & op2323=0 & op2222=0 & op2121=0 & wR2731; wR3236 {
  fxu_check(inst_start);
  local cond0:4 = zext(wR3236[0,32] != 0);
  wR2731[0,32] = (wR0004[0,32] * cond0) + (wR1115[0,32] * zext(cond0 == 0));
  local cond1:4 = zext(wR3236[32,32] != 0);
  wR2731[32,32] = (wR0004[32,32] * cond1) + (wR1115[32,32] * zext(cond1 == 0));
  local cond2:4 = zext(wR3236[64,32] != 0);
  wR2731[64,32] = (wR0004[64,32] * cond2) + (wR1115[64,32] * zext(cond2 == 0));
  local cond3:4 = zext(wR3236[96,32] != 0);
  wR2731[96,32] = (wR0004[96,32] * cond3) + (wR1115[96,32] * zext(cond3 == 0));
}

# SHFLV.W4 imm12, wreg1, wreg2, wreg3: per-lane 8-way select; selectors 0-3
# read wreg1 lanes, 4-7 read wreg2 lanes.
:shflv.w4 imm12, wR0004, wR1115, wR2731 is op0510=0x3D & wR0004 & wR1115;
	op1620=0x1D & op2426=6 & op2323=1 & op2222=0 & op2121 & wR2731; imm3242
[ imm12 = (op2121 << 11) | imm3242; ] {
  fxu_check(inst_start);
  local sel0:4 = (imm12 >> 0) & 7;
  local sel1:4 = (imm12 >> 3) & 7;
  local sel2:4 = (imm12 >> 6) & 7;
  local sel3:4 = (imm12 >> 9) & 7;
  local s0:4 = wR0004[0,32]; local s1:4 = wR0004[32,32];
  local s2:4 = wR0004[64,32]; local s3:4 = wR0004[96,32];
  local s4:4 = wR1115[0,32]; local s5:4 = wR1115[32,32];
  local s6:4 = wR1115[64,32]; local s7:4 = wR1115[96,32];
  wR2731[0,32] = (s0 * zext(sel0 == 0)) + (s1 * zext(sel0 == 1))
    + (s2 * zext(sel0 == 2)) + (s3 * zext(sel0 == 3))
    + (s4 * zext(sel0 == 4)) + (s5 * zext(sel0 == 5))
    + (s6 * zext(sel0 == 6)) + (s7 * zext(sel0 == 7));
  wR2731[32,32] = (s0 * zext(sel1 == 0)) + (s1 * zext(sel1 == 1))
    + (s2 * zext(sel1 == 2)) + (s3 * zext(sel1 == 3))
    + (s4 * zext(sel1 == 4)) + (s5 * zext(sel1 == 5))
    + (s6 * zext(sel1 == 6)) + (s7 * zext(sel1 == 7));
  wR2731[64,32] = (s0 * zext(sel2 == 0)) + (s1 * zext(sel2 == 1))
    + (s2 * zext(sel2 == 2)) + (s3 * zext(sel2 == 3))
    + (s4 * zext(sel2 == 4)) + (s5 * zext(sel2 == 5))
    + (s6 * zext(sel2 == 6)) + (s7 * zext(sel2 == 7));
  wR2731[96,32] = (s0 * zext(sel3 == 0)) + (s1 * zext(sel3 == 1))
    + (s2 * zext(sel3 == 2)) + (s3 * zext(sel3 == 3))
    + (s4 * zext(sel3 == 4)) + (s5 * zext(sel3 == 5))
    + (s6 * zext(sel3 == 6)) + (s7 * zext(sel3 == 7));
}

# LDV.QW disp16[reg1], wreg3: quad-word load (disp low 4 bits read as 0).
:ldv.qw s4863[R0004], wR2731 is op0510=0x3D & R0004; op1620=0x1D & op2426=2 & op2323=1 & op2122=0 & wR2731; s4863 {
  fxu_check(inst_start);
  wR2731 = *:16 (R0004 + (s4863 & 0xfffffff0));
}

:stv.qw wR2731, s4863[R0004] is op0510=0x3D & R0004; op1620=0x1D & op2426=2 & op2323=1 & op2122=1 & wR2731; s4863 {
  fxu_check(inst_start);
  *:16 (R0004 + (s4863 & 0xfffffff0)) = wR2731;
}

:stv.qw wR2731, s4863[R0004] is op0510=0x3D & R0004; op1620=0x1D & op2426=2 & op2323=1 & op2122=2 & wR2731; s4863 {
  fxu_check(inst_start);
  *:16 (R0004 + (s4863 & 0xfffffff0)) = wR2731;
}

:stv.qw wR2731, s4863[R0004] is op0510=0x3D & R0004; op1620=0x1D & op2426=2 & op2323=1 & op2122=3 & wR2731; s4863 {
  fxu_check(inst_start);
  *:16 (R0004 + (s4863 & 0xfffffff0)) = wR2731;
}

# LDV.W imm4, disp16[reg1], wreg3: one word load broadcast to the lanes
# selected by imm4 (disp low 2 bits read as 0).
:ldv.w imm4, s4863[R0004], wR2731 is op0510=0x3D & R0004; op1620=0x1D & op2626=0 & op2525=0 & op2424 & op2323 & op2222 & op2121 & wR2731; s4863
[ imm4 = (op2424 << 3) | (op2323 << 2) | (op2222 << 1) | op2121; ] {
  fxu_check(inst_start);
  local val:4 = *:4 (R0004 + (s4863 & 0xfffffffc));
  local m0:4 = imm4 & 1;
  local m1:4 = (imm4 >> 1) & 1;
  local m2:4 = (imm4 >> 2) & 1;
  local m3:4 = (imm4 >> 3) & 1;
  wR2731[0,32] = (val * m0) + (wR2731[0,32] * zext(m0 == 0));
  wR2731[32,32] = (val * m1) + (wR2731[32,32] * zext(m1 == 0));
  wR2731[64,32] = (val * m2) + (wR2731[64,32] * zext(m2 == 0));
  wR2731[96,32] = (val * m3) + (wR2731[96,32] * zext(m3 == 0));
}

# STV.W imm2, wreg3, disp16[reg1]: store the single word lane imm2.
:stv.w op2122, wR2731, s4863[R0004] is op0510=0x3D & R0004; op1620=0x1D & op2426=2 & op2323=0 & op2122 & wR2731; s4863 {
  fxu_check(inst_start);
  local lane:4 = op2122;
  local val:4 = (wR2731[0,32] * zext(lane == 0)) + (wR2731[32,32] * zext(lane == 1))
    + (wR2731[64,32] * zext(lane == 2)) + (wR2731[96,32] * zext(lane == 3));
  *:4 (R0004 + (s4863 & 0xfffffffc)) = val;
}

# LDV.DW imm2, disp16[reg1], wreg3: one double-word load broadcast to the
# double-word lanes selected by imm2 (disp low 3 bits read as 0).
:ldv.dw op2122, s4863[R0004], wR2731 is op0510=0x3D & R0004; op1620=0x1D & op2426=3 & op2323=0 & op2122 & wR2731; s4863 {
  fxu_check(inst_start);
  local val:8 = *:8 (R0004 + (s4863 & 0xfffffff8));
  local m0:4 = op2122 & 1;
  local m1:4 = (op2122 >> 1) & 1;
  wR2731[0,64] = (val * zext(m0)) + (wR2731[0,64] * zext(m0 == 0));
  wR2731[64,64] = (val * zext(m1)) + (wR2731[64,64] * zext(m1 == 0));
}

# STV.DW imm1, wreg3, disp16[reg1]: store double-word lane imm1.
:stv.dw op2121, wR2731, s4863[R0004] is op0510=0x3D & R0004; op1620=0x1D & op2426=3 & op2323=1 & op2222=0 & op2121 & wR2731; s4863 {
  fxu_check(inst_start);
  local lane:4 = op2121;
  local val:8 = (wR2731[0,64] * zext(lane == 0)) + (wR2731[64,64] * zext(lane == 1));
  *:8 (R0004 + (s4863 & 0xfffffff8)) = val;
}

# LDVZ.H4 disp16[reg1], wreg3: double-word load, 16-bit units zero-extended
# into the LOW half of each word lane.
:ldvz.h4 s4863[R0004], wR2731 is op0510=0x3D & R0004; op1620=0x1D & op2426=3 & op2323=1 & op2222=1 & op2121=0 & wR2731; s4863 {
  fxu_check(inst_start);
  local val:8 = *:8 (R0004 + (s4863 & 0xfffffff8));
  wR2731[0,32] = zext(val[0,16]);
  wR2731[32,32] = zext(val[16,16]);
  wR2731[64,32] = zext(val[32,16]);
  wR2731[96,32] = zext(val[48,16]);
}

# STVZ.H4 wreg3, disp16[reg1]: pack the four LOW halfword lanes into one
# double-word store.
:stvz.h4 wR2731, s4863[R0004] is op0510=0x3D & R0004; op1620=0x1D & op2426=3 & op2323=1 & op2222=1 & op2121=1 & wR2731; s4863 {
  fxu_check(inst_start);
  local val:8 = zext(wR2731[0,16]) | (zext(wR2731[32,16]) << 16)
    | (zext(wR2731[64,16]) << 32) | (zext(wR2731[96,16]) << 48);
  *:8 (R0004 + (s4863 & 0xfffffff8)) = val;
}
