# RH850 SIMD floating-point instructions (W registers, 128-bit, four
# single-precision lanes).
#
# PRIMARY AUTHORITIES:
#   - R01UH0770EJ0121 (RH850/E2x-FCC2 User's Manual: Hardware) section
#     3.2.6, the extended floating-point (FXU) architecture of this target:
#     exception detection/enable/preservation model (Figures 3.38/3.39),
#     per-cause rules 3.2.6.2(6), the input/result flush Tables 3.122-3.124,
#     the NaN result Table 3.125, the conversion result Table 3.126 and the
#     masked-exception initial values Table 3.121.
#   - R01US0209EJ0220 (RH850G4MH User's Manual: Software) chapter 2.5, the
#     per-instruction [Operation] blocks and operation-result tables
#     (pp. 387-496).
# Encodings are cross-checked against the installed IDA census
# (build/out/ida-v850-census.json).
#
# LANE/STATUS CONTRACT (every floating-point constructor below):
#   * fxu_check gates the whole constructor on PSW.CU1 (FE-level UCPOP,
#     cause 81H / vector 80H, no state change).
#   * ALL FOUR lanes are evaluated first; the commit macro then decides in
#     ONE place between writing every lane (no enabled exception: sticky
#     XP/FXXP accumulate the 5-bit causes, XC retained) and leaving the
#     destination unchanged with the EI-level extended floating-point
#     operation exception FXE (EIIC 75H, vector RBASE/EBASE+70H, EIPC = the
#     faulting instruction), which replaces FXSR.XC with the OR over lanes
#     and FXXC with the per-lane 6-bit packing (E,V,Z,O,U,I at bytes
#     0/8/16/24; R01UH0770 Table 3.59 and Figure 3.38).
#   * Input flushes set FXSR.IF (bit 22) immediately, so they accumulate
#     even on trapping instructions (R01UH0770 3.2.6.2(8) caution 4).
#     FXSR.XP is accumulated independently of FXXP and is never
#     reconstructed from software-modified FXXP state.
#   * Lane causes use the canonical encoding I=0x1, U=0x2, O=0x4, Z=0x8,
#     V=0x10, E=0x20, matching the FXSR.XC/XP bit order I,U,O,Z,V,E.
#   * Operands are snapshotted into locals before any write, so register
#     aliasing (wreg3 = wreg1/wreg2) is architecturally safe.
#
# Format M (bits 10..5 = 111111): category 10 => op1626 0x580..0x5DE,
# conversions/unary at 0x5A0 with the 5-bit selector in hw1 bits 4-0.
#
# Double-precision intermediates: add/sub/div/sqrt/rsqrt lanes are computed
# as a double-precision p-code operation and then rounded to single in the
# current FXSR.RM. This is exact for products of two singles and for
# sums/quotients whose exponent spread fits 53 bits; the residual
# double-rounding corners (sticky bits beyond 53) are the documented model
# limitation of p-code, consistent with the scalar float.sinc treatment.


# ---------------------------------------------------------------------
# Numeric neighbors of a finite single: next up/down in the total order
# (monotonic across subnormals and through ±0).
macro f32_next_up(out, bits) {
  if ((bits & 0x80000000) != 0) goto <nu_neg>;
  out = bits + 1;
  goto <nu_done>;
  <nu_neg>
  if (bits != 0x80000000) goto <nu_neg_nz>;
  out = 0;
  goto <nu_done>;
  <nu_neg_nz>
  out = bits - 1;
  <nu_done>
}

macro f32_next_down(out, bits) {
  if ((bits & 0x80000000) != 0) goto <nd_neg>;
  if (bits != 0) goto <nd_pos_nz>;
  out = 0x80000000;
  goto <nd_done>;
  <nd_pos_nz>
  out = bits - 1;
  goto <nd_done>;
  <nd_neg>
  out = bits + 1;
  <nd_done>
}

macro h16_next_up(out, bits) {
  if ((bits & 0x8000) != 0) goto <hnu_neg>;
  out = bits + 1;
  goto <hnu_done>;
  <hnu_neg>
  if (bits != 0x8000) goto <hnu_neg_nz>;
  out = 0;
  goto <hnu_done>;
  <hnu_neg_nz>
  out = bits - 1;
  <hnu_done>
}

macro h16_next_down(out, bits) {
  if ((bits & 0x8000) != 0) goto <hnd_neg>;
  if (bits != 0) goto <hnd_pos_nz>;
  out = 0x8000;
  goto <hnd_done>;
  <hnd_pos_nz>
  out = bits - 1;
  goto <hnd_done>;
  <hnd_neg>
  out = bits + 1;
  <hnd_done>
}

# Result negation for the N-suffix butterfly forms: finite results and
# infinities flip the sign bit; NaN results keep the value mandated by
# R01UH0770 Table 3.125 (7fffffff or a Q-NaN payload).
macro f32_neg_if_not_nan(r) {
  if ((r & 0x7fffffff) > 0x7f800000) goto <neg_skip>;
  r = r ^ 0x80000000;
  <neg_skip>
}

# Round a finite double-precision intermediate to single precision in the
# current FXSR rounding mode (0 RN, 1 RZ, 2 RP, 3 RM) and raise the inexact
# cause (I = 0x1) when the single result differs from the intermediate.
# Callers guarantee the value is nonzero, finite, and neither subnormal nor
# overflowing in single precision, so only precision rounding is needed.
# The RN pick comes from the p-code float2float conversion; directed modes
# step to the neighboring single with the correct orientation (RZ depends
# on the sign, RP always rounds up, RM always rounds down).
macro simd_round_d2s(cause, out, exact) {
  local mode:4 = (FXSR >> 18) & 3;
  local s:4 = float2float(exact);
  local s8:8 = float2float(s);
  out = s;
  if (s8 f== exact) goto <rd_done>;
  cause = cause | 0x1;
  if (mode == 0) goto <rd_done>;
  local neg:1 = exact f< 0;
  if (s8 f< exact) goto <rd_rounded_down>;
  # s sits above the intermediate: s is the upper neighbor
  if (mode == 2) goto <rd_done>;
  if (mode == 3) goto <rd_take_lower>;
  if (neg == 0) goto <rd_take_lower>;
  goto <rd_done>;
  <rd_rounded_down>
  # s sits below the intermediate: s is the lower neighbor
  if (mode == 3) goto <rd_done>;
  if (mode == 2) goto <rd_take_upper>;
  if (neg != 0) goto <rd_take_upper>;
  goto <rd_done>;
  <rd_take_lower>
  f32_next_down(out, s);
  goto <rd_done>;
  <rd_take_upper>
  f32_next_up(out, s);
  <rd_done>
}

# One lane of binary SIMD arithmetic. Per the G4MH [Operation] blocks the
# result is wreg2 op wreg1, so callers pass x = the wreg2 lane and y = the
# wreg1 lane; kind 0 = add, 1 = multiply, 2 = divide, 3 = subtract.
# Implements R01UH0770 3.2.6.2 in lane-local form: subnormal input flush
# (Table 3.122, IF + I) or the unimplemented operation exception (E);
# Table 3.125 NaN results (S-NaN or an invalid real-number operation give
# the canonical 7fffffff, Q-NaN-only keeps the wreg2 > wreg1 payload);
# division-by-zero; subnormal RESULT flush before rounding (Table 3.123,
# plus the FN flush-to-nearest half-minimum rule of Table 3.124) or E when
# FS = 0; overflow with the Table 3.121 initial values; RM-directed
# rounding; exact-zero sign rules (IEEE 754 6.3: only RM negates an exact
# add/sub cancellation).
macro simd_fp_op(cause, out, x, y, operation) {
  local kind:4 = operation;
  local a:4 = x;
  local b:4 = y;
  local aa:4 = a & 0x7fffffff;
  local bb:4 = b & 0x7fffffff;
  local flushed:1 = 0;
  cause = 0;
  out = 0;
  # -- subnormal inputs (R01UH0770 3.2.6.2(8)) --
  local sub_in:1 = ((aa != 0) && (aa < 0x00800000))
    || ((bb != 0) && (bb < 0x00800000));
  if (sub_in == 0) goto <inputs_ready>;
  if ((FXSR & 0x20000) != 0) goto <flush_inputs>;
  cause = 0x20;
  goto <op_done>;
  <flush_inputs>
  flushed = 1;
  FXSR = FXSR | 0x400000;
  if ((aa == 0) || (aa >= 0x00800000)) goto <a_ready>;
  a = a & 0x80000000;
  aa = 0;
  <a_ready>
  if ((bb == 0) || (bb >= 0x00800000)) goto <inputs_ready>;
  b = b & 0x80000000;
  bb = 0;
  <inputs_ready>
  # -- NaN operands (R01UH0770 Table 3.125) --
  if ((aa <= 0x7f800000) && (bb <= 0x7f800000)) goto <no_nan>;
  if (((aa > 0x7f800000) && ((aa & 0x400000) == 0))
    || ((bb > 0x7f800000) && ((bb & 0x400000) == 0))) goto <invalid_op>;
  if (aa > 0x7f800000) goto <qnan_a>;
  out = b;
  goto <op_done>;
  <qnan_a>
  out = a;
  goto <op_done>;
  <no_nan>
  # -- zero / infinity combinations (G4MH operation-result tables) --
  local a_inf:1 = aa == 0x7f800000;
  local b_inf:1 = bb == 0x7f800000;
  local a_zero:1 = aa == 0;
  local b_zero:1 = bb == 0;
  if (kind == 2) goto <div_combo>;
  if (kind == 1) goto <mul_combo>;
  # add/sub: inf + (-inf) and inf - inf are invalid; other inf cases and
  # the zero combinations fall through to the (exact) double computation
  if ((a_inf == 0) || (b_inf == 0)) goto <combo_ok>;
  local same_sign:1 = (a & 0x80000000) == (b & 0x80000000);
  if (kind == 0) goto <add_combo>;
  if (same_sign != 0) goto <invalid_op>;
  goto <combo_ok>;
  <add_combo>
  if (same_sign != 0) goto <combo_ok>;
  goto <invalid_op>;
  <mul_combo>
  if ((a_zero != 0) && (b_inf != 0)) goto <invalid_op>;
  if ((b_zero != 0) && (a_inf != 0)) goto <invalid_op>;
  goto <combo_ok>;
  <div_combo>
  if ((a_zero != 0) && (b_zero != 0)) goto <invalid_op>;
  if (a_inf != 0) goto <div_a_inf>;
  if (b_inf != 0) goto <div_b_inf>;
  if (b_zero == 0) goto <combo_ok>;
  # finite nonzero dividend over a zero divisor: Z with correctly signed inf
  cause = cause | 0x8;
  out = ((a ^ b) & 0x80000000) | 0x7f800000;
  goto <op_done>;
  <div_a_inf>
  if (b_inf != 0) goto <invalid_op>;
  out = ((a ^ b) & 0x80000000) | 0x7f800000;
  goto <op_done>;
  <div_b_inf>
  # finite dividend over an infinite divisor: exact correctly signed zero
  out = (a ^ b) & 0x80000000;
  goto <op_done>;
  <invalid_op>
  cause = cause | 0x10;
  out = 0x7fffffff;
  goto <op_done>;
  <combo_ok>
  local da:8 = float2float(a);
  local db:8 = float2float(b);
  local exact:8 = 0;
  if (kind == 1) goto <k_mul>;
  if (kind == 2) goto <k_div>;
  if (kind == 3) goto <k_sub>;
  exact = da f+ db;
  goto <exact_ready>;
  <k_sub> exact = da f- db; goto <exact_ready>;
  <k_mul> exact = da f* db; goto <exact_ready>;
  <k_div> exact = da f/ db;
  <exact_ready>
  local pos:8 = abs(exact);
  local infs:4 = 0x7f800000;
  local inf8:8 = float2float(infs);
  if (pos f== inf8) goto <res_inf>;
  if (pos f!= 0) goto <res_nonzero>;
  # exact zero: keep the double op's sign; an exact add/sub cancellation
  # is -0 only under RM (IEEE 754 6.3)
  out = float2float(exact);
  if ((kind == 1) || (kind == 2)) goto <op_fin>;
  if (((FXSR >> 18) & 3) != 3) goto <op_fin>;
  out = 0x80000000;
  goto <op_fin>;
  <res_inf>
  # an infinity produced by infinite operands propagates exactly
  out = float2float(exact);
  goto <op_fin>;
  <res_nonzero>
  local tiny:4 = 0x00800000;
  local tiny8:8 = float2float(tiny);
  if (pos f>= tiny8) goto <res_magnitude_ok>;
  # subnormal result BEFORE rounding: FS = 1 flushes (Table 3.123/3.124),
  # FS = 0 raises E, which preempts the U/I accounting
  if ((FXSR & 0x20000) != 0) goto <res_underflow>;
  cause = 0x20;
  goto <op_done>;
  <res_magnitude_ok>
  local maxf:4 = 0x7f7fffff;
  local max8:8 = float2float(maxf);
  if (pos f<= max8) goto <res_round>;
  goto <res_overflow>;
  <res_underflow>
  cause = cause | 0x2;
  cause = cause | zext((FXSR & 0x40) == 0);
  local mode:4 = (FXSR >> 18) & 3;
  local neg:1 = exact f< 0;
  out = 0;
  if (neg == 0) goto <uf_signed>;
  out = 0x80000000;
  <uf_signed>
  if (mode == 2) goto <uf_rp>;
  if (mode == 3) goto <uf_rm>;
  if (mode != 0) goto <op_fin>;
  if ((FXSR & 0x800000) == 0) goto <op_fin>;
  local halfmin:4 = 0x00400000;
  local half8:8 = float2float(halfmin);
  if (pos f>= half8) goto <uf_min_normal>;
  goto <op_fin>;
  <uf_rp>
  if (neg != 0) goto <op_fin>;
  out = 0x00800000;
  goto <op_fin>;
  <uf_rm>
  if (neg == 0) goto <op_fin>;
  out = 0x80800000;
  goto <op_fin>;
  <uf_min_normal>
  out = out | 0x00800000;
  goto <op_fin>;
  <res_overflow>
  cause = cause | 0x4;
  cause = cause | zext((FXSR & 0x80) == 0);
  local omode:4 = (FXSR >> 18) & 3;
  local oneg:1 = exact f< 0;
  out = 0;
  if (oneg == 0) goto <of_signed>;
  out = 0x80000000;
  <of_signed>
  if (omode == 0) goto <of_inf>;
  if (omode == 1) goto <of_max>;
  if (omode == 2) goto <of_rp>;
  if (oneg == 0) goto <of_max>;
  goto <of_inf>;
  <of_rp>
  if (oneg == 0) goto <of_inf>;
  goto <of_max>;
  <of_inf>
  out = out | 0x7f800000;
  goto <op_fin>;
  <of_max>
  out = out | 0x7f7fffff;
  goto <op_fin>;
  <res_round>
  simd_round_d2s(cause, out, exact);
  <op_fin>
  # a flushed input is inexact unless V/Z was detected or a Q-NaN operand
  # supplied the result (R01UH0770 3.2.6.2(6)(a))
  if (flushed == 0) goto <op_done>;
  if ((cause & 0x18) != 0) goto <op_done>;
  if ((out & 0x7fffffff) > 0x7f800000) goto <op_done>;
  cause = cause | 0x1;
  <op_done>
}

# One lane of SIMD SQRTF.S4 / RSQRTF.S4 (kind 0 = sqrt, 1 = reciprocal
# square root). RECIPF.S4 is a DIVF.S4 lane with a constant 1.0 dividend
# (R01UH0770 3.2.6.2(10)(d)) and therefore reuses simd_fp_op directly.
# Negative operands (including -inf) are invalid with the canonical 7fff
# ffff; ±0 gives -0 for sqrt and a correctly signed infinity with Z for
# rsqrt; +inf gives +inf / +0; a subnormal operand follows the FS rules.
# Normal inputs can neither overflow nor produce a subnormal result in
# either operation, so plain mode rounding applies.
macro simd_fp_unary(cause, out, x, operation) {
  local kind:4 = operation;
  local v:4 = x;
  local vv:4 = v & 0x7fffffff;
  local flushed:1 = 0;
  cause = 0;
  out = 0;
  if ((vv == 0) || (vv >= 0x00800000)) goto <u_ready>;
  if ((FXSR & 0x20000) != 0) goto <u_flush>;
  cause = 0x20;
  goto <u_done>;
  <u_flush>
  flushed = 1;
  FXSR = FXSR | 0x400000;
  v = v & 0x80000000;
  vv = 0;
  <u_ready>
  if (vv <= 0x7f800000) goto <u_not_nan>;
  if ((vv & 0x400000) != 0) goto <u_qnan>;
  goto <u_invalid>;
  <u_qnan>
  out = v;
  goto <u_done>;
  <u_not_nan>
  if (vv != 0) goto <u_nonzero>;
  if (kind == 0) goto <u_sqrt_zero>;
  cause = cause | 0x8;
  out = (v & 0x80000000) | 0x7f800000;
  goto <u_done>;
  <u_sqrt_zero>
  out = v;
  goto <u_done>;
  <u_nonzero>
  if ((v & 0x80000000) == 0) goto <u_positive>;
  <u_invalid>
  cause = cause | 0x10;
  out = 0x7fffffff;
  goto <u_done>;
  <u_positive>
  if (vv != 0x7f800000) goto <u_finite>;
  if (kind == 0) goto <u_inf_sqrt>;
  out = 0;
  goto <u_done>;
  <u_inf_sqrt>
  out = 0x7f800000;
  goto <u_done>;
  <u_finite>
  local d8:8 = float2float(v);
  local root_value:8 = sqrt(d8);
  if (kind == 0) goto <u_round>;
  local one8:8 = 0x3ff0000000000000;
  root_value = one8 f/ root_value;
  <u_round>
  simd_round_d2s(cause, out, root_value);
  <u_done>
  if (flushed == 0) goto <u_fin_done>;
  if ((cause & 0x18) != 0) goto <u_fin_done>;
  if ((out & 0x7fffffff) > 0x7f800000) goto <u_fin_done>;
  cause = cause | 0x1;
  <u_fin_done>
}

# One lane of MAXF/MINF (and the RF reduction forms). x = the higher-priority
# wreg2 operand, y = the wreg1 operand. S-NaN anywhere is invalid with the
# canonical 7fffffff (Table 3.125); a single Q-NaN operand yields the real
# operand (Table 3.125 note 4); two Q-NaNs keep the wreg2 payload (note 1).
# ±0 ties keep wreg2 for max and wreg1 for min (Table 3.125 (c)); for the
# reduction forms callers pass x = the odd (higher) lane and y = the even
# lane, which reproduces the odd/even tie rules of (c). MIN/MAX never flush
# subnormal inputs and never raise E (R01UH0770 3.2.6.2(8)(c)/(d)).
macro simd_minmax_lane(cause, out, x, y, pick_max) {
  local is_max:1 = pick_max;
  local xx:4 = x;
  local yy:4 = y;
  local xmag:4 = xx & 0x7fffffff;
  local ymag:4 = yy & 0x7fffffff;
  cause = 0;
  out = 0;
  local snan:1 = ((xmag > 0x7f800000) && ((xmag & 0x400000) == 0))
    || ((ymag > 0x7f800000) && ((ymag & 0x400000) == 0));
  if (snan == 0) goto <mm_no_snan>;
  cause = 0x10;
  out = 0x7fffffff;
  goto <mm_done>;
  <mm_no_snan>
  if ((xmag <= 0x7f800000) && (ymag <= 0x7f800000)) goto <mm_real>;
  if (xmag > 0x7f800000) goto <mm_x_nan>;
  # only y is Q-NaN: the real x operand wins
  goto <mm_take_x>;
  <mm_x_nan>
  if (ymag > 0x7f800000) goto <mm_both_qnan>;
  # only x is Q-NaN: the real y operand wins
  goto <mm_take_y>;
  <mm_both_qnan>
  out = xx;
  goto <mm_done>;
  <mm_real>
  if (is_max != 0) goto <mm_max>;
  if (xx f< yy) goto <mm_take_x>;
  goto <mm_take_y>;
  <mm_max>
  if (yy f> xx) goto <mm_take_y>;
  <mm_take_x>
  out = xx;
  goto <mm_done>;
  <mm_take_y>
  out = yy;
  <mm_done>
}

# Vector-wide commit of per-lane results/causes. Aggregates the lane causes
# (OR for FXSR.XC, 6-bit/5-bit per-lane packing for FXXC/FXXP per Tables
# 3.59/3.60), runs the enable check, and either writes all four lanes with
# the masked (preservation) accumulation into FXSR.XP/FXXP, or takes the
# FXE with the destination fully suppressed.
macro simd_fp_guard(out, cause, fxxc_packed, instruction_pc) {
  # XE bits 9-5 = V,Z,O,U,I -> EI=0x20, EU=0x40, EO=0x80, EZ=0x100, EV=0x200.
  # E (0x20 in `cause`) has no enable and always traps.
  out = ((cause & 0x20) != 0)
    || (((cause & 0x10) != 0) && ((FXSR & 0x200) != 0))
    || (((cause & 0x8) != 0) && ((FXSR & 0x100) != 0))
    || (((cause & 0x4) != 0) && ((FXSR & 0x80) != 0))
    || (((cause & 0x2) != 0) && ((FXSR & 0x40) != 0))
    || (((cause & 0x1) != 0) && ((FXSR & 0x20) != 0));
  if (out == 0) goto <fpu_ok>;
  # XC/FXXC first, then the FXE: EI-level resumable exception, EIIC 0x75,
  # vector RBASE/EBASE+0x70 (R01UH0770 3.2.6.2(7), Tables 3.95/3.98).
  FXSR = (FXSR & 0xffff03ff) | (cause << 10);
  FXXC = fxxc_packed;
  local fxe_handler:4 = 0;
  enter_ei_exception(instruction_pc, 0x75, 0x70, fxe_handler);
  call [fxe_handler];
  <fpu_ok>
}

macro simd_vector_commit(wreg3, lane_result0, lane_result1, lane_result2, lane_result3, ra0, ra1, ra2, ra3, instruction_pc) {
  local raised:4 = (ra0 | ra1) | (ra2 | ra3);
  local fxxc:4 = (ra0 & 0x3f) | ((ra1 & 0x3f) << 8) | ((ra2 & 0x3f) << 16) | ((ra3 & 0x3f) << 24);
  local fxxp:4 = (ra0 & 0x1f) | ((ra1 & 0x1f) << 8) | ((ra2 & 0x1f) << 16) | ((ra3 & 0x1f) << 24);
  local sup:1 = 0;
  simd_fp_guard(sup, raised, fxxc, instruction_pc);
  if (sup != 0) goto <commit_suppressed>;
  # masked: preservation bits accumulate (FXSR.XP from the lane OR,
  # FXXP per way); FXSR.XC is retained (Figure 3.39)
  FXSR = FXSR | (raised & 0x1f);
  FXXP = FXXP | fxxp;
  wreg3[0,32] = lane_result0;
  wreg3[32,32] = lane_result1;
  wreg3[64,32] = lane_result2;
  wreg3[96,32] = lane_result3;
  <commit_suppressed>
}

# ---------------------------------------------------------------------
# 3-operand lane arithmetic. Result lanes: WR[wreg3](wN) = w2(wN) op w1(wN)
# with a = wreg1 lanes (wR0004) and b = wreg2 lanes (wR1115).
:divf.s4 wR0004, wR1115, wR2731 is op0510=0x3F & wR0004 & wR1115; op1626=0x5AE & wR2731 {
  fxu_check(inst_start);
  local a0:4 = wR0004[0,32]; local a1:4 = wR0004[32,32];
  local a2:4 = wR0004[64,32]; local a3:4 = wR0004[96,32];
  local b0:4 = wR1115[0,32]; local b1:4 = wR1115[32,32];
  local b2:4 = wR1115[64,32]; local b3:4 = wR1115[96,32];
  local lane_result0:4 = 0; local lane_result1:4 = 0; local lane_result2:4 = 0; local lane_result3:4 = 0;
  local ra0:4 = 0; local ra1:4 = 0; local ra2:4 = 0; local ra3:4 = 0;
  simd_fp_op(ra0, lane_result0, b0, a0, 2);
  simd_fp_op(ra1, lane_result1, b1, a1, 2);
  simd_fp_op(ra2, lane_result2, b2, a2, 2);
  simd_fp_op(ra3, lane_result3, b3, a3, 2);
  simd_vector_commit(wR2731, lane_result0, lane_result1, lane_result2, lane_result3, ra0, ra1, ra2, ra3, inst_start);
}

:subf.s4 wR0004, wR1115, wR2731 is op0510=0x3F & wR0004 & wR1115; op1626=0x5A6 & wR2731 {
  fxu_check(inst_start);
