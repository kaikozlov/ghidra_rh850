  f32_neg_if_not_nan(lane_result3);
  simd_vector_commit(wR2731, lane_result0, lane_result1, lane_result2, lane_result3, ra0, ra1, ra2, ra3, inst_start);
}

:subaddnf.s4 wR0004, wR1115, wR2731 is op0510=0x3F & wR0004 & wR1115; op1626=0x5DA & wR2731 {
  fxu_check(inst_start);
  local a0:4 = wR0004[0,32]; local a1:4 = wR0004[32,32];
  local a2:4 = wR0004[64,32]; local a3:4 = wR0004[96,32];
  local b0:4 = wR1115[0,32]; local b1:4 = wR1115[32,32];
  local b2:4 = wR1115[64,32]; local b3:4 = wR1115[96,32];
  local lane_result0:4 = 0; local lane_result1:4 = 0; local lane_result2:4 = 0; local lane_result3:4 = 0;
  local ra0:4 = 0; local ra1:4 = 0; local ra2:4 = 0; local ra3:4 = 0;
  simd_fp_op(ra0, lane_result0, b0, a0, 0);
  simd_fp_op(ra1, lane_result1, b1, a1, 3);
  simd_fp_op(ra2, lane_result2, b2, a2, 0);
  simd_fp_op(ra3, lane_result3, b3, a3, 3);
  f32_neg_if_not_nan(lane_result0);
  f32_neg_if_not_nan(lane_result1);
  f32_neg_if_not_nan(lane_result2);
  f32_neg_if_not_nan(lane_result3);
  simd_vector_commit(wR2731, lane_result0, lane_result1, lane_result2, lane_result3, ra0, ra1, ra2, ra3, inst_start);
}

:addsubnxf.s4 wR0004, wR1115, wR2731 is op0510=0x3F & wR0004 & wR1115; op1626=0x5DC & wR2731 {
  fxu_check(inst_start);
  local a0:4 = wR0004[0,32]; local a1:4 = wR0004[32,32];
  local a2:4 = wR0004[64,32]; local a3:4 = wR0004[96,32];
  local b0:4 = wR1115[0,32]; local b1:4 = wR1115[32,32];
  local b2:4 = wR1115[64,32]; local b3:4 = wR1115[96,32];
  local lane_result0:4 = 0; local lane_result1:4 = 0; local lane_result2:4 = 0; local lane_result3:4 = 0;
  local ra0:4 = 0; local ra1:4 = 0; local ra2:4 = 0; local ra3:4 = 0;
  simd_fp_op(ra0, lane_result0, b0, a1, 3);
  simd_fp_op(ra1, lane_result1, b1, a0, 0);
  simd_fp_op(ra2, lane_result2, b2, a3, 3);
  simd_fp_op(ra3, lane_result3, b3, a2, 0);
  f32_neg_if_not_nan(lane_result0);
  f32_neg_if_not_nan(lane_result1);
