# CVTF.SW4/SUW4: rounding per FXSR.RM (G4MH Table 2.17 p.385); every lane
# computes first, one commit decides (per-way FXXC/FXXP packing).
:cvtf.sw4 wR1115, wR2731 is op0510=0x3F & op0004=8 & wR1115; op1626=0x5A0 & wR2731 {
  fxu_check(inst_start);
  local rm:4 = (FXSR >> 18) & 3;
  local x0:4 = wR1115[0,32]; local x1:4 = wR1115[32,32];
  local x2:4 = wR1115[64,32]; local x3:4 = wR1115[96,32];
  local o0:4 = 0; local o1:4 = 0; local o2:4 = 0; local o3:4 = 0;
  local ra0:4 = 0; local ra1:4 = 0; local ra2:4 = 0; local ra3:4 = 0;
  simd_cvt_sw_lane(o0, ra0, x0, rm);
  simd_cvt_sw_lane(o1, ra1, x1, rm);
  simd_cvt_sw_lane(o2, ra2, x2, rm);
  simd_cvt_sw_lane(o3, ra3, x3, rm);
  simd_vector_commit(wR2731, o0, o1, o2, o3, ra0, ra1, ra2, ra3, inst_start);
}

