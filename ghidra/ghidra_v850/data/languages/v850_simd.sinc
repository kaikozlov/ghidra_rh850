# CVTF.HS4: the half-precision source sits in the LOW half of each word lane.
:cvtf.hs4 wR1115, wR2731 is op0510=0x3F & op0004=12 & wR1115; op1626=0x5A0 & wR2731 {
  fxu_check(inst_start);
