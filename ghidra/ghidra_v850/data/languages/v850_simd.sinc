}

# ---------------------------------------------------------------------
# Fused multiply-add family (category 01): per lane
# wreg3 = fma/fms/fnma/fnms(wreg2, wreg1, wreg3) via the exact scalar
# fused helper with the FXSR control word. All four lanes are evaluated
# numerically FIRST (fp32_fused never early-exits), the cause bits are
# ORed across elements (G4MH p.432 note) and one commit decides: no
# enabled exception -> every lane written and sticky causes accumulated
# into FXSR.XP/FXXP; enabled exception -> destination unchanged, FXSR.XC
# replaced with the OR over lanes, FXXC replaced with the per-lane packing,
# and the FXE pends (EIIC 75H, vector +70H).
macro simd_fma4(wreg3, wreg1, wreg2, action, instruction_pc) {
  local a0:4 = wreg2[0,32]; local a1:4 = wreg2[32,32];
  local a2:4 = wreg2[64,32]; local a3:4 = wreg2[96,32];
  local b0:4 = wreg1[0,32]; local b1:4 = wreg1[32,32];
  local b2:4 = wreg1[64,32]; local b3:4 = wreg1[96,32];
  local c0:4 = wreg3[0,32]; local c1:4 = wreg3[32,32];
  local c2:4 = wreg3[64,32]; local c3:4 = wreg3[96,32];
  local res0:4 = 0; local res1:4 = 0; local res2:4 = 0; local res3:4 = 0;
  local ra0:4 = 0; local ra1:4 = 0; local ra2:4 = 0; local ra3:4 = 0;
  local fl0:4 = 0; local fl1:4 = 0; local fl2:4 = 0; local fl3:4 = 0;
  fp32_fused(res0, ra0, fl0, a0, b0, c0, action, FXSR, 1);
  fp32_fused(res1, ra1, fl1, a1, b1, c1, action, FXSR, 1);
  fp32_fused(res2, ra2, fl2, a2, b2, c2, action, FXSR, 1);
  fp32_fused(res3, ra3, fl3, a3, b3, c3, action, FXSR, 1);
  local oraise:4 = (ra0 | ra1) | (ra2 | ra3);
  local ofxxc:4 = (ra0 & 0x3f) | ((ra1 & 0x3f) << 8) | ((ra2 & 0x3f) << 16) | ((ra3 & 0x3f) << 24);
  local ofxxp:4 = (ra0 & 0x1f) | ((ra1 & 0x1f) << 8) | ((ra2 & 0x1f) << 16) | ((ra3 & 0x1f) << 24);
  local oflush:4 = (fl0 | fl1) | (fl2 | fl3);
  # IF accumulates even when the instruction traps (caution 4 of 3.2.6.2(8))
  FXSR = FXSR | (oflush << 22);
  local sup:1 = 0;
  simd_fp_guard(sup, oraise, ofxxc, instruction_pc);
  if (sup != 0) goto <fma_suppressed>;
  wreg3[0,32] = res0;
  wreg3[32,32] = res1;
  wreg3[64,32] = res2;
  wreg3[96,32] = res3;
  FXSR = FXSR | (oraise & 0x1f);
  FXXP = FXXP | ofxxp;
  <fma_suppressed>
}

:fmaf.s4 wR0004, wR1115, wR2731 is op0510=0x3F & wR0004 & wR1115; op1626=0x4C0 & wR2731 {
  fxu_check(inst_start);
  simd_fma4(wR2731, wR0004, wR1115, 0, inst_start);
}

:fmsf.s4 wR0004, wR1115, wR2731 is op0510=0x3F & wR0004 & wR1115; op1626=0x4C2 & wR2731 {
  fxu_check(inst_start);
  simd_fma4(wR2731, wR0004, wR1115, 1, inst_start);
}

:fnmaf.s4 wR0004, wR1115, wR2731 is op0510=0x3F & wR0004 & wR1115; op1626=0x4C4 & wR2731 {
  fxu_check(inst_start);
  simd_fma4(wR2731, wR0004, wR1115, 2, inst_start);
}

:fnmsf.s4 wR0004, wR1115, wR2731 is op0510=0x3F & wR0004 & wR1115; op1626=0x4C6 & wR2731 {
  fxu_check(inst_start);
  simd_fma4(wR2731, wR0004, wR1115, 3, inst_start);
}

# ---------------------------------------------------------------------
# CMPF.S4: per-lane comparison (all-ones/all-zeros) into wreg3.
# cmpf(fcond, A = wreg2, B = wreg1): less = A < B (G4MH p.410). An S-NaN
# operand is an invalid operation condition for ANY fcond ("floating-point
# arithmetic instructions including comparison instructions ... any
# SignalingNaN received as an operand value is regarded as an invalid
# operation condition"); a Q-NaN lane is invalid only when fcond[3] is set
# (unordered-signaling conditions 8-15). With the exception enabled the
# comparison result is not set (vector suppressed); with it masked the
# result is architecturally undefined - this model delivers the cmpf
# formula value. No FPSR/FXSR flag update beyond the V accounting; the
# flags move explicitly via TRFSRV.W4. CMPF never flushes and never
# raises E (3.2.6.2(8)(c)/(d)).
:cmpf.s4 fcond1720, wR0004, wR1115, wR2731 is op0510=0x3F & wR0004 & wR1115; op2325=3 & op2122=0 & op1616=0 & fcond1720 & wR2731 {
  fxu_check(inst_start);
  local comparison_code:4 = fcond1720;
  local b0:4 = wR1115[0,32]; local b1:4 = wR1115[32,32];
  local b2:4 = wR1115[64,32]; local b3:4 = wR1115[96,32];
  local a0:4 = wR0004[0,32]; local a1:4 = wR0004[32,32];
  local a2:4 = wR0004[64,32]; local a3:4 = wR0004[96,32];
  local res0:4 = 0; local res1:4 = 0; local res2:4 = 0; local res3:4 = 0;
  compare_float(comparison_code:1, b0, a0, res0);
  compare_float(comparison_code:1, b1, a1, res1);
  compare_float(comparison_code:1, b2, a2, res2);
  compare_float(comparison_code:1, b3, a3, res3);
  local lane_result0:4 = 0 - res0;
  local lane_result1:4 = 0 - res1;
  local lane_result2:4 = 0 - res2;
  local lane_result3:4 = 0 - res3;
  local sn0:1 = (((b0 & 0x7fffffff) > 0x7f800000) && ((b0 & 0x400000) == 0))
    || (((a0 & 0x7fffffff) > 0x7f800000) && ((a0 & 0x400000) == 0));
  local sn1:1 = (((b1 & 0x7fffffff) > 0x7f800000) && ((b1 & 0x400000) == 0))
    || (((a1 & 0x7fffffff) > 0x7f800000) && ((a1 & 0x400000) == 0));
  local sn2:1 = (((b2 & 0x7fffffff) > 0x7f800000) && ((b2 & 0x400000) == 0))
    || (((a2 & 0x7fffffff) > 0x7f800000) && ((a2 & 0x400000) == 0));
  local sn3:1 = (((b3 & 0x7fffffff) > 0x7f800000) && ((b3 & 0x400000) == 0))
    || (((a3 & 0x7fffffff) > 0x7f800000) && ((a3 & 0x400000) == 0));
  local qn0:1 = nan(b0) || nan(a0);
  local qn1:1 = nan(b1) || nan(a1);
  local qn2:1 = nan(b2) || nan(a2);
  local qn3:1 = nan(b3) || nan(a3);
  local sig:1 = (comparison_code & 8) != 0;
  local ra0:4 = zext(sn0 || (qn0 && sig)) << 4;
  local ra1:4 = zext(sn1 || (qn1 && sig)) << 4;
  local ra2:4 = zext(sn2 || (qn2 && sig)) << 4;
  local ra3:4 = zext(sn3 || (qn3 && sig)) << 4;
  simd_vector_commit(wR2731, lane_result0, lane_result1, lane_result2, lane_result3, ra0, ra1, ra2, ra3, inst_start);
}

# ---------------------------------------------------------------------
# Single -> integer conversion lanes. mode: 0 RN (ROUNDF), 1 RZ (TRNCF),
# 2 RP (CEILF), 3 RM (FLOORF); CVTF passes FXSR.RM. NaN, ±inf and
# out-of-range sources raise V and saturate (G4MH tables p.407-408,
# 418-421, 465-468; R01UH0770 Table 3.126: NaN -> 8000 0000H signed /
# 0000 0000H unsigned); inexact sources raise I; a subnormal source
# flushes to a signed zero (IF + I) with FS=1, while FS=0 raises E which
# preempts the lower-priority inexact accounting. The range check applies
# to the ROUNDED value, so e.g. CEILF just below -2^31 rounds into range
# without V.
macro simd_cvt_sw_lane(out, raised, x, rounding_mode) {
  local mode:4 = rounding_mode;
  local xv:4 = x;
  local isNan:1 = nan(x);
  raised = 0;
  out = 0;
  local xmag:4 = xv & 0x7fffffff;
  if ((xmag == 0) || (xmag >= 0x00800000)) goto <csw_ready>;
  if ((FXSR & 0x20000) != 0) goto <csw_flush>;
  raised = 0x20;
  goto <csw_done>;
  <csw_flush>
  xv = xv & 0x80000000;
  FXSR = FXSR | 0x400000;
  raised = 0x1;
  <csw_ready>
  if (isNan == 0) goto <csw_not_nan>;
  raised = raised | 0x10;
  out = 0x80000000;
  goto <csw_done>;
  <csw_not_nan>
  if (xmag != 0x7f800000) goto <csw_numeric>;
  raised = raised | 0x10;
  out = 0x7fffffff;
  if ((xv & 0x80000000) == 0) goto <csw_done>;
  out = 0x80000000;
  goto <csw_done>;
  <csw_numeric>
  local x8:8 = float2float(xv);
  local t:8 = 0;
  if (mode == 0) goto <csw_rne>;
  if (mode == 2) goto <csw_ceil>;
  if (mode == 3) goto <csw_floor>;
  t = trunc(x8);
  goto <csw_range>;
  <csw_ceil>
  t = trunc(ceil(x8));
  goto <csw_range>;
  <csw_floor>
  t = trunc(floor(x8));
  goto <csw_range>;
  <csw_rne>
  local tr:8 = trunc(x8);
  local trf:8 = int2float(tr);
  local frac:8 = x8 f- trf;
  local half:8 = 0x3fe0000000000000;
  local nhalf:8 = 0xbfe0000000000000;
  local up:1 = (frac f> half) || ((frac f== half) && ((tr & 1) != 0));
  local down:1 = (frac f< nhalf) || ((frac f== nhalf) && ((tr & 1) != 0));
  t = tr + zext(up) - zext(down);
  <csw_range>
  local limhi:8 = 0x7fffffff;
  local limlo:8 = 0xffffffff80000000;
  if (t s< limlo) goto <csw_saturate_lo>;
  if (t s> limhi) goto <csw_saturate_hi>;
  out = t:4;
  local tf:8 = int2float(t);
  raised = raised | zext(tf f!= x8);
  goto <csw_done>;
  <csw_saturate_lo>
  raised = raised | 0x10;
  out = 0x80000000;
  goto <csw_done>;
  <csw_saturate_hi>
  raised = raised | 0x10;
  out = 0x7fffffff;
  <csw_done>
}

macro simd_cvt_suw_lane(out, raised, x, rounding_mode) {
  local mode:4 = rounding_mode;
  local xv:4 = x;
  local isNan:1 = nan(x);
  raised = 0;
  out = 0;
  local xmag:4 = xv & 0x7fffffff;
  if ((xmag == 0) || (xmag >= 0x00800000)) goto <csuw_ready>;
  if ((FXSR & 0x20000) != 0) goto <csuw_flush>;
  raised = 0x20;
  goto <csuw_done>;
  <csuw_flush>
  xv = xv & 0x80000000;
  FXSR = FXSR | 0x400000;
  raised = 0x1;
  <csuw_ready>
  if (isNan == 0) goto <csuw_not_nan>;
  raised = raised | 0x10;
  out = 0;
  goto <csuw_done>;
  <csuw_not_nan>
  if (xmag != 0x7f800000) goto <csuw_numeric>;
  raised = raised | 0x10;
  out = 0xffffffff;
  if ((xv & 0x80000000) == 0) goto <csuw_done>;
  out = 0;
  goto <csuw_done>;
  <csuw_numeric>
  # A negative source is invalid with a 0 result for every unsigned
  # conversion (G4MH p.417-418 operation-result table: -Normal -> 0[V];
  # only +-0 converts to 0 without V)
  if ((xv & 0x80000000) == 0) goto <csuw_conv>;
  if (xmag == 0) goto <csuw_conv>;
  raised = raised | 0x10;
  out = 0;
  goto <csuw_done>;
  <csuw_conv>
  local x8:8 = float2float(xv);
  local t:8 = 0;
  if (mode == 0) goto <csuw_rne>;
  if (mode == 2) goto <csuw_ceil>;
  if (mode == 3) goto <csuw_floor>;
  t = trunc(x8);
  goto <csuw_range>;
  <csuw_ceil>
  t = trunc(ceil(x8));
  goto <csuw_range>;
  <csuw_floor>
  t = trunc(floor(x8));
  goto <csuw_range>;
  <csuw_rne>
  local tr:8 = trunc(x8);
  local trf:8 = int2float(tr);
  local frac:8 = x8 f- trf;
  local half:8 = 0x3fe0000000000000;
  local nhalf:8 = 0xbfe0000000000000;
  local up:1 = (frac f> half) || ((frac f== half) && ((tr & 1) != 0));
  local down:1 = (frac f< nhalf) || ((frac f== nhalf) && ((tr & 1) != 0));
  t = tr + zext(up) - zext(down);
  <csuw_range>
  local zero:8 = 0;
  local limhi:8 = 0xffffffff;
  if (t s< zero) goto <csuw_saturate_lo>;
  if (t s> limhi) goto <csuw_saturate_hi>;
  out = t:4;
  local tf:8 = int2float(t);
  raised = raised | zext(tf f!= x8);
  goto <csuw_done>;
  <csuw_saturate_lo>
  raised = raised | 0x10;
  out = 0;
  goto <csuw_done>;
  <csuw_saturate_hi>
  raised = raised | 0x10;
  out = 0xffffffff;
  <csuw_done>
}

# Integer -> single conversion lanes (CVTF.WS4 / CVTF.UWS4): the integer
# value is exact in double precision; rounding to single follows the
# current FXSR.RM and raises I when precision is lost (G4MH p.422-423).
macro simd_cvt_ws_lane(cause, out, x) {
  local integer:8 = sext(x);
  local e8:8 = int2float(integer);
  cause = 0;
  simd_round_d2s(cause, out, e8);
}

macro simd_cvt_uws_lane(cause, out, x) {
  local integer:8 = zext(x);
  local e8:8 = int2float(integer);
  cause = 0;
  simd_round_d2s(cause, out, e8);
}

# Half -> single conversion lane (CVTF.HS4, source in the low 16 bits).
# Always exact except NaN handling (R01UH0770 Table 3.126): a half S-NaN
# gives the canonical 7fffffff with V; a half Q-NaN widens with the same
# sign and its payload in single fraction bits 22-13. Subnormal halves are
# widened exactly and are never flushed; HS4 never raises E
# (R01UH0770 3.2.6.2(8)(c)/(d)).
macro simd_cvt_hs_lane(cause, out, h) {
  local hh:2 = h;
  local s4:4 = zext(hh & 0x8000);
  local e4:4 = zext((hh >> 10) & 0x1f);
  local f4:4 = zext(hh & 0x3ff);
  cause = 0;
  out = 0;
  if (e4 != 0x1f) goto <hs_not_special>;
  if (f4 == 0) goto <hs_inf>;
  if ((f4 & 0x200) != 0) goto <hs_qnan>;
  cause = 0x10;
  out = 0x7fffffff;
  goto <hs_done>;
  <hs_qnan>
  out = (s4 << 16) | 0x7f800000 | (f4 << 13);
  goto <hs_done>;
  <hs_inf>
  out = (s4 << 16) | 0x7f800000;
  goto <hs_done>;
  <hs_not_special>
  if (e4 != 0) goto <hs_normal>;
  if (f4 == 0) goto <hs_zero>;
  # half subnormal: value = frac x 2^-24; normalize into the single field
  local m:4 = f4;
  local lz:4 = lzcount(m);
  local bitlen:4 = 32 - lz;
  local eb:4 = 102 + bitlen;
  m = m << (24 - bitlen);
  out = (s4 << 16) | (eb << 23) | (m & 0x7fffff);
  goto <hs_done>;
  <hs_zero>
  out = s4 << 16;
  goto <hs_done>;
  <hs_normal>
  local nb:4 = e4 - 15 + 127;
  out = (s4 << 16) | (nb << 23) | (f4 << 13);
  <hs_done>
}

# Single -> half conversion lane (CVTF.SH4, result zero-extended into the
# word). NaN per Table 3.126 (S-NaN -> 7FFFH with V; Q-NaN keeps the sign
# with the fraction's top ten bits). Subnormal SOURCES follow the FS rules;
# a subnormal RESULT (before rounding, judged in half precision) flushes
# per Tables 3.123/3.124 with U (+I unless EU enabled) or raises E with
# FS=0. Overflow uses the IEEE unbounded-exponent rule: O is detected only
# when the value rounded at half PRECISION with an unbounded exponent
# still exceeds the half maximum (RN >= halfway 65520, RZ only >= 65536,
# RP/RM away from zero already above 65504); the delivered value is the
# Table 3.121 initial value. No-O values above the half maximum still
# round to the half maximum and are inexact.
macro simd_cvt_sh_lane(cause, out, x) {
  local xv:4 = x;
  local xmag:4 = xv & 0x7fffffff;
  cause = 0;
  out = 0;
  if ((xmag == 0) || (xmag >= 0x00800000)) goto <sh_ready>;
  if ((FXSR & 0x20000) != 0) goto <sh_flush>;
  cause = 0x20;
  goto <sh_done>;
  <sh_flush>
  xv = xv & 0x80000000;
  xmag = 0;
  FXSR = FXSR | 0x400000;
  cause = 0x1;
  <sh_ready>
  if (xmag <= 0x7f800000) goto <sh_not_nan>;
  if ((xmag & 0x400000) != 0) goto <sh_qnan>;
  cause = 0x10;
  out = 0x7fff;
  goto <sh_done>;
  <sh_qnan>
  local qw:4 = ((xv >> 16) & 0x8000) | 0x7c00 | ((xv >> 13) & 0x3ff);
  out = qw:2;
  goto <sh_done>;
  <sh_not_nan>
  if (xmag != 0x7f800000) goto <sh_finite>;
  local iw:4 = ((xv >> 16) & 0x8000) | 0x7c00;
  out = iw:2;
  goto <sh_done>;
  <sh_finite>
  if (xmag != 0) goto <sh_nonzero>;
  local zw:4 = (xv >> 16) & 0x8000;
  out = zw:2;
  goto <sh_done>;
  <sh_nonzero>
  local x8:8 = float2float(xv);
  local pos:8 = abs(x8);
  local mode:4 = (FXSR >> 18) & 3;
  local neg:1 = x8 f< 0;
  local maxh:2 = 0x7bff;
  local max8:8 = float2float(maxh);
  local minh:2 = 0x0400;
  local tiny8:8 = float2float(minh);
  local halfh:2 = 0x0200;
  local half8:8 = float2float(halfh);
  local t16:8 = 65536;
  local two16:8 = int2float(t16);
  local t20:8 = 65520;
  local thresh:8 = int2float(t20);
  if (pos f<= max8) goto <sh_small>;
  # above the half maximum: decide overflow per the unbounded-exponent rule
  if (mode == 0) goto <sh_big_rn>;
  if (mode == 1) goto <sh_big_rz>;
  if (mode == 2) goto <sh_big_rp>;
  if (neg != 0) goto <sh_big_inf>;
  if (pos f>= two16) goto <sh_big_max>;
  goto <sh_ret_max>;
  <sh_big_rp>
  if (neg != 0) goto <sh_big_rz>;
  <sh_big_inf>
  cause = cause | 0x4;
  cause = cause | zext((FXSR & 0x80) == 0);
  out = 0x7c00;
  if (neg == 0) goto <sh_done>;
  out = 0xfc00;
  goto <sh_done>;
  <sh_big_rn>
  if (pos f>= thresh) goto <sh_big_inf>;
  goto <sh_ret_max>;
  <sh_big_rz>
  if (pos f>= two16) goto <sh_big_max>;
  <sh_ret_max>
  cause = cause | 0x1;
  out = 0x7bff;
  if (neg == 0) goto <sh_done>;
  out = 0xfbff;
  goto <sh_done>;
  <sh_big_max>
  cause = cause | 0x4;
  cause = cause | zext((FXSR & 0x80) == 0);
  out = 0x7bff;
  if (neg == 0) goto <sh_done>;
  out = 0xfbff;
  goto <sh_done>;
  <sh_small>
  if (pos f>= tiny8) goto <sh_round>;
  # subnormal half result before rounding
  if ((FXSR & 0x20000) != 0) goto <sh_underflow>;
  cause = 0x20;
  goto <sh_done>;
  <sh_underflow>
  cause = cause | 0x2;
  cause = cause | zext((FXSR & 0x40) == 0);
  out = 0;
  if (neg == 0) goto <sh_uf_signed>;
  out = 0x8000;
  <sh_uf_signed>
  if (mode == 2) goto <sh_uf_rp>;
  if (mode == 3) goto <sh_uf_rm>;
  if (mode != 0) goto <sh_done>;
  if ((FXSR & 0x800000) == 0) goto <sh_done>;
  if (pos f>= half8) goto <sh_uf_min>;
  goto <sh_done>;
  <sh_uf_rp>
  if (neg != 0) goto <sh_done>;
  out = 0x0400;
  goto <sh_done>;
  <sh_uf_rm>
  if (neg == 0) goto <sh_done>;
  out = 0x8400;
  goto <sh_done>;
  <sh_uf_min>
  out = out | 0x0400;
  goto <sh_done>;
  <sh_round>
  local s:2 = float2float(x8);
  local s8:8 = float2float(s);
  out = s;
  if (s8 f== x8) goto <sh_done>;
  cause = cause | 0x1;
  if (mode == 0) goto <sh_done>;
  if (s8 f< x8) goto <sh_case_a>;
  # s is the upper neighbor
  if (mode == 2) goto <sh_done>;
  if (mode == 3) goto <sh_b_down>;
  if (neg == 0) goto <sh_b_down>;
  goto <sh_done>;
  <sh_case_a>
  # s is the lower neighbor
  if (mode == 3) goto <sh_done>;
  if (mode == 2) goto <sh_a_up>;
  if (neg != 0) goto <sh_a_up>;
  goto <sh_done>;
  <sh_a_up>
  h16_next_up(out, s);
  goto <sh_done>;
  <sh_b_down>
  h16_next_down(out, s);
  <sh_done>
}

# ---------------------------------------------------------------------
# ROUNDF family: round to nearest-even regardless of FXSR.RM
# (G4MH p.465-468).
:roundf.sw4 wR1115, wR2731 is op0510=0x3F & op0004=0 & wR1115; op1626=0x5A0 & wR2731 {
  fxu_check(inst_start);
  local x0:4 = wR1115[0,32]; local x1:4 = wR1115[32,32];
  local x2:4 = wR1115[64,32]; local x3:4 = wR1115[96,32];
  local o0:4 = 0; local o1:4 = 0; local o2:4 = 0; local o3:4 = 0;
  local ra0:4 = 0; local ra1:4 = 0; local ra2:4 = 0; local ra3:4 = 0;
  simd_cvt_sw_lane(o0, ra0, x0, 0);
  simd_cvt_sw_lane(o1, ra1, x1, 0);
  simd_cvt_sw_lane(o2, ra2, x2, 0);
  simd_cvt_sw_lane(o3, ra3, x3, 0);
  simd_vector_commit(wR2731, o0, o1, o2, o3, ra0, ra1, ra2, ra3, inst_start);
}

