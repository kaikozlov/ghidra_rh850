  "boundary": "This recovers Toyota's current host-side resolver. DDB membership is candidate metadata; GetMountEcuList and GetSupportP5 are the live/cached filters. It does not imply that every listed operation is safe to execute or that mutation authorization can be skipped.",
  "functions": {
    "mounted_ecu": {
      "CommConnectionNoBuffer": "0x100829C0",
      "GetEcuAddr": "0x10035420",
      "ProtInfo.FindDbItem1": "0x100C2590",
      "ProtInfo.FindDbItem2": "0x100C2690"
    },
    "p5_support": {
      "AnalyzeFrameData": "0x10063660",
      "CheckSupportDid": "0x10070DB0",
      "CheckSupportPid": "0x10072180",
      "CheckSupportRid": "0x10072F80",
      "CreateEnableDataIdList": "0x10063890",
      "CreateEnableRIdList": "0x10066160",
      "GetSupportP5.Execute": "0x10001630"
    },
    "vehicle_decision": {
      "DecisionKey": "0x100D4AF0",
      "DecisionKeyEU": "0x100D6130",
      "DecisionKeyNew": "0x100D54D0",
      "DecisionKeyNewEU": "0x100D6B90"
    },
    "vin_vehicle_decision": {
      "DecisionKey": "0x100D91D0"
    }
  },
  "mounted_ecu": {
    "connection_algorithm": {
      "api": "CEcuConnectCheck::CommConnectionNoBuffer",
      "comm_frame_db_class_id": "0x111",
      "ecu_category_db_class_id": "0x110",
      "steps": [
        "resolve connection_frame_id through CDbCommFrameTable",
        "apply connection_comm_set_id with CCommFrameData::SetCommSet",
        "transmit the database send frame through the common communication cache/direct sender",
        "AND returned bytes with the database receive mask",
        "compare the masked result byte-for-byte with the database receive-check bytes",
        "set the candidate mounted flag only when the communication succeeds and the check matches"
      ]
    },
    "current_na_camry": {
      "candidate_count": 34,
      "connection_profiles": [
        {
          "comm_set_id": 9,
          "frame_id": 0,
          "phase_type": 18
        },
        {
          "comm_set_id": 9,
          "frame_id": 0,
          "phase_type": 34
        }
      ],
      "meaning": "all current Camry-HV install rows use connection frame 0 / CommSet 9 and phase-type byte 0x12 or 0x22; every one of the 34 candidates independently resolves through Toyota's class-0x10D (category, phase) route table. Frame 0 has empty send/mask/check variables, so mount resolution is category-scoped transport setup/connectivity, not an identity-DID probe"
    },
    "inputs": [
      "CDbInstallingEcuListResRecords",
      "CDbEcuCategoryResRecords"
    ],
    "install_row": {
      "category_id": "u16 +0x06",
      "connection_comm_set_id": "u16 +0x0A",
      "connection_frame_id": "u16 +0x08",
      "connection_phase_type": "u8 +0x13; passed as CommConnectionNoBuffer arg_10h",
      "ddb_type": 44,
      "install_set_id": "u16 +0x04",
      "record_size": 24
    },
    "output": "CCmdEcuInfo list",
    "plugin": "GetMntEcuLstNoCf_DT.dll",
    "source_name": "GetMountEcuListNoCnfm.cpp",
    "transport_route": {
      "address_extension": "u8 +0x0A; consumed by the current P5 frame builder. Current phase-0x22 Camry rows use it to distinguish logical categories that share request CAN ID 0x750",
      "api": "CCommFrameCtrl::GetEcuAddr(category, phase)",
      "key": "CDbProtInfoTable +0x00 category_id and +0x18 phase_type",
      "legislated_request_address": "u16 +0x14; current masters contain standard 0x7E0..0x7E7 physical OBD request IDs here. The corresponding 11-bit response is request+8; +0x14 is not itself the response ID.",
      "protocol_info_db_class_id": "0x10D",
      "protocol_info_ddb_type": 13,
      "request_address": "u16 +0x08; returned directly by GetEcuAddr"
    }
  },
  "p5_support": {
    "did_root": {
      "group_bitmap": "MSB-first; set bit n means xx01+n; final bit for next xx00 is skipped",
      "group_request": "replace request DID with supported xx00 group",
      "positive_sid": "0x62",
      "request": "220101",
      "root_bitmap": "MSB-first; set bit n means group (n << 8)",
      "selector": "0xC8"
    },
    "options": {
      "1": "PID",
      "2": "DID",
      "3": "RID"
    },
    "plugin": "GetSupportP5_DT.dll",
    "routine_root": {
      "positive_sid": "0x71",
      "request": "31011001",
      "selector": "0xCC"
    }
  },
  "pipeline": [
    {
      "api": "CDAExecSelectVehicle -> CSelectCarTypeVin10",
      "semantics": "CSelectCarTypeVin10 dispatches by communication generation. P3/P4 use CDbVehicleDecisionTable; current P5 (generation-low5 20/21) uses CDbVinVehicleDecisionTable and its Phase5 vehicle-decision virtual returns 0xC0040101 without querying class 0x129; results feed vehicle/install resolution",
      "stage": "vehicle-resolution"
    },
    {
      "api": "CDAExecGetMountEcuList -> GetMountEcuListNoCnfm",
      "semantics": "selected CDbInstallingEcuListTable candidates are passed through CEcuConnectCheck/CommConnectionNoBuffer and returned as CCmdEcuInfo mounted ECUs",
      "stage": "mounted-ecu-resolution"
    },
    {
      "api": "GetSupportP5_DT",
      "semantics": "optionId 1/2/3 dispatches to CCommCachePlusP5::CheckSupportPid/Did/Rid; support is live/cached communication state, not DDB presence alone",
      "stage": "feature-support-resolution"
    }
  ],
