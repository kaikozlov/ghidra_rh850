  "pipeline": [
    {
      "api": "CDAExecSelectVehicle -> CSelectCarTypeVin10",
      "semantics": "live communication/protocol identity plus VIN and user/option selections are resolved through CDbVehicleDecisionTable and CDbVinVehicleDecisionTable; results include vehicleId, decisionVin, parentPhaseType, carInfoList and optionInfoList",
      "stage": "vehicle-resolution"
    },
    {
      "api": "CDAExecGetMountEcuList -> GetMountEcuListNoCnfm",
      "semantics": "selected CDbInstallingEcuListTable candidates are passed through CEcuConnectCheck/CommConnectionNoBuffer and returned as CCmdEcuInfo mounted ECUs",
      "stage": "mounted-ecu-resolution"
    },
    {
      "api": "GetSupportP5_DT",
      "semantics": "optionId 1/2/3 dispatches to CCommCachePlusP5::CheckSupportPid/Did/Rid; support is live/cached communication state, not DDB presence alone",
      "stage": "feature-support-resolution"
    }
  ],
