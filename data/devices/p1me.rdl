// Canonical RH850/P1M-E executable device description.
// Register descriptions migrated from data/p1m_sfr_labels.csv; that CSV is now a generated projection.
property evidence { type = string; component = addrmap | mem | reg; };
property source_ref { type = string; component = addrmap | mem | reg; };
property behavior { type = string; component = reg; };
property executable { type = boolean; component = mem; };
property access_widths { type = string; component = reg; };
property alias_group { type = string; component = mem; };
property reset_policy { type = string; component = mem; };
property product_ids { type = string; component = addrmap; };
property p_bus_hz { type = longint unsigned; component = addrmap; };
property trigger { type = string; component = reg; };
property writable_mask { type = longint unsigned; component = reg; };
property read_value { type = longint unsigned; component = reg; };
property read_input { type = boolean; component = reg; };
property sync_mask { type = longint unsigned; component = reg; };
property active_mask { type = longint unsigned; component = reg; };
property allowed_values { type = string; component = reg; };
property status_register { type = string; component = reg; };
property secondary_status_register { type = string; component = reg; };
property capture_registers { type = string; component = reg; };
property status_masks { type = string; component = reg; };
property secondary_status_masks { type = string; component = reg; };
property protection_mask { type = longint unsigned; component = reg; };
property protection_value { type = longint unsigned; component = reg; };
property access_register { type = string; component = reg; };
property history_register { type = string; component = reg; };
property start_address_register { type = string; component = reg; };
property end_address_register { type = string; component = reg; };
property mode_register { type = string; component = reg; };
property emulation_register { type = string; component = reg; };
property enable_register { type = string; component = reg; };
property secondary_enable_register { type = string; component = reg; };
property interrupt_channel { type = longint unsigned; component = reg; };
property interrupt_register { type = string; component = reg; };
property interrupt_channel_base { type = longint unsigned; component = reg; };
property control_register { type = string; component = reg; };
property pointer_register { type = string; component = reg; };
property window_register { type = string; component = reg; };
property channel_control_register { type = string; component = reg; };
property global_control_register { type = string; component = reg; };
property fifo_index { type = longint unsigned; component = reg; };
property fifo_channel { type = longint unsigned; component = reg; };
property payload_address { type = longint unsigned; component = reg; };
property completion_value { type = longint unsigned; component = reg; };
property reset_control { type = string; component = mem; };
property reset_rules { type = string; component = mem; };
property reset_classes { type = string; component = reg; };
property skipped_value { type = longint unsigned; component = reg; };
property reset_mask { type = longint unsigned; component = reg; };

reg peripheral_ecc_control {
    regwidth=32; accesswidth=32;
    desc="Peripheral RAM ECC control, latched error flags and live ECEMF input";
    evidence="manual"; source_ref="R01UH0585EJ0120 Tables31.76-31.79; AppendixA pp2963-2964";
    behavior="peripheral-ecc"; trigger="peripheral-ecc-control";
    writable_mask=0xC6B8; reset_mask=0xFFFFFFFE;
    reset_classes="power-on,system-1-cvm,system-1-pin,system-2,application-1";
    field { sw=rw; reset=0x10; } value[31:0];
};

reg peripheral_ecc_test {
    regwidth=32; accesswidth=32;
    desc="Peripheral RAM ECC test control; ETMA=10 authorizes the mode bit";
    evidence="manual"; source_ref="R01UH0585EJ0120 Tables31.76-31.78,31.80; AppendixA pp2963-2964";
    behavior="peripheral-ecc"; trigger="peripheral-ecc-test"; writable_mask=0xC09F;
    reset_classes="power-on,system-1-cvm,system-1-pin,system-2,application-1";
    field { sw=rw; reset=0; } value[31:0];
};

