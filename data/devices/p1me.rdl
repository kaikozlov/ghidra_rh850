    // Native ECMPS is 8-bit (manual32.4.25 and vendor DR7F701381.DVF ECM.PS).
    // F33 0x3FE/0x6AA use ld.w. Native CS+ CPU execution at0x3FE with
    // ECM.PS=1 returns00000001. Only that containing-word read is declared;
    // this vendor-simulator observation is not silicon bus-width proof.
    reg {
        regwidth=8; accesswidth=8; access_widths="1,4"; desc="ECM protection status; real failure bit0; declared word read zero-extends native byte";
        evidence="manual+firmware"; source_ref="R01UH0585EJ0120 section32.4.25 Table32.39; DR7F701381.DVF ECM.PS native8; F33 CodeFlash0x3FE/0x6AA ld.w; native CS+ CPU word-read observation";
        behavior="ecm";
        reset_classes="power-on,system-1-cvm,system-1-pin,system-2,application-1";
        field { sw=r; reset=0; } value[7:0];
    } ECMPS @ 0xFFD62044;

