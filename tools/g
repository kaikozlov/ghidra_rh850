#!/usr/bin/env bash
#
# tools/g — repo-local ghidra CLI wrapper.
#
# Fully self-contained: resolves the repo root, bootstraps the isolated Ghidra
# environment (processor extension, Java options, fingerprint), materializes the
# working project if absent, selects the pinned vendored CLI binary, and refuses
# to operate against the committed project/ snapshot.
#
# You never need to `source build/cache/ghidra-processor.env` before running this.
#
# Usage:
#   tools/g decompile 0x8db22
#   tools/g x-ref to 0x8db22
#   tools/g inspect 0xc853a --decompile --callers --callees --xrefs --disasm 40
#   tools/g inspect 0xc853a 0x8db22
#   tools/g x-ref trace-to 0xfebef02a --disasm 20
#   printf 'stats\nquery functions --count\n' | tools/g batch --read-only -
#   tools/g script run ghidra/scripts/investigate/Foo.java -- arg1
#   tools/g session-status
#   tools/g stop
#
# Environment:
#   GHIDRA_AGENT=1            Force compact JSON output (for scripted/agent consumption).
#   GHIDRA_PROJECT            Override the working project directory (default: build/work/project).
#   GHIDRA_ANALYSIS_TARGET   Registered analysis target; omitted means registry default.
#   GHIDRA_ALLOW_SYSTEM_CLI=1 Allow falling back to a system-installed ghidra binary.
#   GHIDRA_NO_BOOTSTRAP=1     Skip processor env bootstrap (assumes env already sourced).
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
# shellcheck disable=SC1091
source "$ROOT/tools/lib/build_paths.sh"
ANALYSIS_TARGET="${GHIDRA_ANALYSIS_TARGET:-$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["default_target"])' "$ROOT/data/analysis_targets.json")}"
TARGET_FIELD() { python3 "$ROOT/tools/analysis_target.py" "$ANALYSIS_TARGET" --field "$1"; }
PROJECT_NAME=$(TARGET_FIELD project_name)
PROGRAM_NAME=$(TARGET_FIELD program_name)
SNAPSHOT_DIR="$ROOT/$(TARGET_FIELD snapshot_dir)"
DEFAULT_PROJECT_DIR="$ROOT/$(TARGET_FIELD work_dir)"
PROJECT_DIR="${GHIDRA_PROJECT:-$DEFAULT_PROJECT_DIR}"
DAEMON_RE="AnalyzeHeadless.*${PROJECT_NAME}"

# --- Canonicalize PROJECT_DIR -------------------------------------------------

ABS_PROJECT_DIR=$(python3 - "$PROJECT_DIR" <<'PY'
from pathlib import Path
import sys

print(Path(sys.argv[1]).expanduser().resolve(strict=False))
PY
)
SNAPSHOT_DIR=$(python3 - "$SNAPSHOT_DIR" <<'PY'
from pathlib import Path
import sys
print(Path(sys.argv[1]).expanduser().resolve(strict=False))
PY
)
COMMITTED_PROJECT_ROOT=$(python3 - "$ROOT/project" <<'PY'
from pathlib import Path
import sys
print(Path(sys.argv[1]).resolve(strict=False))
PY
)
COMMITTED_PROJECTS_ROOT=$(python3 - "$ROOT/projects" <<'PY'
from pathlib import Path
import sys
print(Path(sys.argv[1]).resolve(strict=False))
PY
)

# shellcheck disable=SC1091
source "$ROOT/tools/lib/project_marker.sh"
MUTATION_MARKER=$(project_mutation_marker "$ROOT" "$ABS_PROJECT_DIR")

# --- Guard against committed project/ -----------------------------------------

case "$ABS_PROJECT_DIR" in
  "$COMMITTED_PROJECT_ROOT"|"$COMMITTED_PROJECT_ROOT"/*|"$COMMITTED_PROJECTS_ROOT"|"$COMMITTED_PROJECTS_ROOT"/*)
    echo "REFUSING: working project resolves inside a committed project snapshot namespace." >&2
    echo "Use the registered build/work target path or set GHIDRA_PROJECT to a disposable path." >&2
    exit 1
    ;;
esac

# Project/program selection and Java location are owned by this wrapper. The
# CLI accepts global options after subcommands, so appending one later would
# otherwise bypass the committed-snapshot guard above.
for arg in "$@"; do
  case "$arg" in
    --projects-dir|--projects-dir=*|--project|--project=*|--program|--program=*|--java-home|--java-home=*)
      echo "REFUSING: $arg is a tools/g-managed option; use GHIDRA_PROJECT for a safe working-copy override." >&2
      exit 2
      ;;
  esac
done

# Locate the command and action independent of leading/interspersed global
# flags (`--json`, `--pretty`, `-v`, ...). clap accepts those flags globally,
# so raw `$1`/`$2` checks are not a security boundary.
CLI_POSITIONALS=()
for arg in "$@"; do
  case "$arg" in
    --) break ;;
    -*) continue ;;
    *)
      CLI_POSITIONALS+=("$arg")
      if ((${#CLI_POSITIONALS[@]} == 2)); then break; fi
      ;;
  esac
done
USER_SUBCMD="${CLI_POSITIONALS[0]:-}"
USER_ACTION="${CLI_POSITIONALS[1]:-}"

# Project create/delete operates outside the one fixed working project and does
# not belong in this safety wrapper.
if [[ "$USER_SUBCMD" == "project" ]]; then
  echo "REFUSING: project management is not supported through tools/g." >&2
  exit 2
fi

# Determine project need before any cache/toolchain setup. Safety failures for a
# user-supplied working directory must be side-effect-free and must not trigger a
# Rust build or Ghidra bootstrap first.
NEEDS_PROJECT=1
for arg in "$@"; do
  if [[ "$arg" == "--help" || "$arg" == "-h" ]]; then
    NEEDS_PROJECT=0
    break
  fi
done
case "$USER_SUBCMD" in
  session-status) NEEDS_PROJECT=0 ;;
  stop|status|ping|jobs|cancel|version|doctor|setup|init|config)
    if [[ ! -d "$ABS_PROJECT_DIR/$PROJECT_NAME.rep" ]]; then
      NEEDS_PROJECT=0
    fi
    ;;
esac

if ((NEEDS_PROJECT)) && [[ -n "${GHIDRA_PROJECT:-}" ]]    && [[ ! -d "$ABS_PROJECT_DIR/$PROJECT_NAME.rep" ]]    && [[ -d "$ABS_PROJECT_DIR" ]]    && [[ -n "$(find "$ABS_PROJECT_DIR" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null)" ]]; then
  echo "REFUSING: GHIDRA_PROJECT points at a nonempty directory without $PROJECT_NAME.rep: $ABS_PROJECT_DIR" >&2
  echo "Choose an empty disposable directory or an existing working project." >&2
  exit 1
fi

# session-status is deliberately toolchain-free. It must work in a clean clone
# without building the Rust CLI, installing Ghidra extensions, or materializing
# any ignored workspace state.
STATUS_ONLY=0
if [[ "$USER_SUBCMD" == "session-status" ]]; then
  STATUS_ONLY=1
fi

# --- Resolve and build the ghidra CLI binary ----------------------------------
if ((STATUS_ONLY == 0)); then

RESOLVE_ARGS=(--ensure-vendored)
if [[ "${GHIDRA_ALLOW_SYSTEM_CLI:-0}" == "1" ]]; then
  RESOLVE_ARGS+=(--allow-system)
fi
GHIDRA_CLI=$("$ROOT/tools/resolve_ghidra_cli.sh" "${RESOLVE_ARGS[@]}")

# --- Bootstrap the isolated Ghidra environment --------------------------------
#
# The helper validates a cached isolated processor environment and only rebuilds
# it when missing or stale. tools/g never requires a manual env-file source.

if [[ "${GHIDRA_NO_BOOTSTRAP:-0}" != "1" ]]; then
  # shellcheck disable=SC1091
  source "$ROOT/tools/lib/ghidra_env.sh" none
fi

# Bind the vendored CLI to the same isolated Ghidra installation that supplied
# the processor extension.  ghidra-cli otherwise may reuse a user-global
# ghidra_install_dir from its config, which can silently select a different
# Ghidra version that cannot open this project's v850e3 language.
if [[ -n "${GHIDRA_HOME:-}" ]]; then
  export GHIDRA_INSTALL_DIR="$GHIDRA_HOME"
fi
fi # STATUS_ONLY == 0

# --- Special commands ---------------------------------------------------------

cmd_session_status() {
  local daemon_pid="" daemon_state="stopped"
  if daemon_pid=$(pgrep -f "$DAEMON_RE" 2>/dev/null | head -1); then
    daemon_state="running"
  fi

  local project_state="missing"
  if [[ -d "$ABS_PROJECT_DIR/$PROJECT_NAME.rep" ]]; then
    project_state="present"
  fi

  local fingerprint_state="unknown"
  local manifest=""
  if [[ -f "$ABS_PROJECT_DIR/processor_manifest.json" ]]; then
    manifest="$ABS_PROJECT_DIR/processor_manifest.json"
  elif [[ -f "$SNAPSHOT_DIR/processor_manifest.json" ]]; then
    manifest="$SNAPSHOT_DIR/processor_manifest.json"
  fi
  if [[ -n "$manifest" && -n "${GHIDRA_HOME:-}" ]]; then
    if python3 "$ROOT/tools/fingerprint_processor.py" \
         --source-only --expect "$manifest" >/dev/null 2>&1; then
      fingerprint_state="matching"
    else
      fingerprint_state="mismatched"
    fi
  elif [[ -n "$manifest" ]]; then
    fingerprint_state="not-checked (no env)"
  fi

  local mutation_state="clean"
  if [[ -f "$MUTATION_MARKER" ]]; then
    mutation_state="potentially-mutated"
  fi

  local snapshot_state="unknown"
  if git -C "$ROOT" diff --quiet -- "$SNAPSHOT_DIR/" 2>/dev/null \
     && git -C "$ROOT" diff --cached --quiet -- "$SNAPSHOT_DIR/" 2>/dev/null; then
    if [[ -f "$MUTATION_MARKER" ]]; then
      snapshot_state="unchanged"  # mutations not yet promoted
    else
      snapshot_state="unchanged"
    fi
  else
    snapshot_state="different"
    if git -C "$ROOT" diff --cached --quiet -- "$SNAPSHOT_DIR/" 2>/dev/null; then
      snapshot_state="different (unstaged)"
    elif git -C "$ROOT" diff --quiet -- "$SNAPSHOT_DIR/" 2>/dev/null; then
      snapshot_state="staged"
    else
      snapshot_state="staged+unstaged"
    fi
  fi

  # Machine-readable output.
  if [[ "${GHIDRA_AGENT:-}" == "1" ]]; then
    python3 - \
      "$daemon_state" "$daemon_pid" "$DAEMON_RE" \
      "$ABS_PROJECT_DIR" "$project_state" "$fingerprint_state" \
      "$mutation_state" "$snapshot_state" <<'PY'
import json, sys
(
    daemon_state, daemon_pid, daemon_pattern,
    project_path, project_state, fingerprint_state,
    mutation_state, snapshot_state,
) = sys.argv[1:]
daemon = {
    'state': daemon_state,
    'pattern': daemon_pattern,
}
if daemon_pid:
    daemon['pid'] = int(daemon_pid)
print(json.dumps({
    'daemon': {
        **daemon,
    },
    'project': {
        'path': project_path,
        'state': project_state,
    },
    'processor_fingerprint': fingerprint_state,
    'working_session': mutation_state,
    'snapshot': snapshot_state,
}, indent=2))
PY
  else
    echo "daemon:              $daemon_state${daemon_pid:+ (pid $daemon_pid)}"
    echo "project:             $ABS_PROJECT_DIR ($project_state)"
    echo "processor fingerprint: $fingerprint_state"
    echo "working session:     $mutation_state"
    echo "snapshot:            $snapshot_state"
  fi
}

# Handle session-status before any project materialization.
if [[ "${1:-}" == "session-status" ]]; then
  cmd_session_status
  exit 0
fi

# --- Materialize the working project if absent --------------------------------

if ((NEEDS_PROJECT)) && [[ ! -d "$ABS_PROJECT_DIR/$PROJECT_NAME.rep" ]]; then
  if [[ ! -d "$SNAPSHOT_DIR/$PROJECT_NAME.rep.snapshot" ]]; then
    echo "No committed snapshot found at $SNAPSHOT_DIR — run 'make rebuild-project' first." >&2
    exit 1
  fi
  echo "Materializing working project from committed snapshot..." >&2
  python3 "$ROOT/tools/project_layout.py" materialize \
    --snapshot-dir "$SNAPSHOT_DIR" \
    --project-dir "$ABS_PROJECT_DIR" \
    --project-name "$PROJECT_NAME"
  echo "Ready: $ABS_PROJECT_DIR" >&2

  # Validate processor manifest fingerprint after copy.
  if [[ -f "$ABS_PROJECT_DIR/processor_manifest.json" ]]; then
    MANIFEST="$ABS_PROJECT_DIR/processor_manifest.json"
  elif [[ -f "$SNAPSHOT_DIR/processor_manifest.json" ]]; then
    MANIFEST="$SNAPSHOT_DIR/processor_manifest.json"
  else
    MANIFEST=""
  fi
  if [[ -n "$MANIFEST" ]]; then
    if ! python3 "$ROOT/tools/fingerprint_processor.py" --source-only --expect "$MANIFEST" >&2; then
      echo "ERROR: processor manifest fingerprint mismatch after materializing working project." >&2
      echo "The vendored processor sources do not match the committed snapshot." >&2
      exit 1
    fi
  fi
fi

# --- Write mutation marker for mutation-capable commands -----------------------
#
# These commands can modify the working project. We write a marker so
# session-status can warn that the working copy may have uncommitted edits.
# The marker is cleared by `make finalize-project` (snapshot promotion).

SUBCMD="$USER_SUBCMD"
ACTION="$USER_ACTION"
# clap aliases are accepted by the vendored CLI, so lifecycle accounting must
# normalize them before classifying mutations.
case "$SUBCMD" in
  prog|programs) SUBCMD=program ;;
  fn|func|functions) SUBCMD=function ;;
  sym|symbols) SUBCMD=symbol ;;
  mem) SUBCMD=memory ;;
  types) SUBCMD=type ;;
  comments) SUBCMD=comment ;;
  scripts) SUBCMD=script ;;
  analysis) SUBCMD=analyze ;;
  mv) SUBCMD=rename ;;
esac
case "$ACTION" in
  rm) ACTION=delete ;;
  mv) ACTION=rename ;;
esac
MUTATES=0
case "$SUBCMD" in
  analyze|import|rename) MUTATES=1 ;;
  batch)
    MUTATES=1
    for arg in "$@"; do
      if [[ "$arg" == "--" ]]; then
        break
      fi
      if [[ "$arg" == "--read-only" ]]; then
        # The vendored CLI preflights the complete batch against a conservative
        # read-only allowlist before executing its first command.
        MUTATES=0
        break
      fi
    done
    ;;
  script)
    case "$ACTION" in
      run|python|java) MUTATES=1 ;;
    esac
    ;;
  program) if [[ "$ACTION" == "delete" || "$ACTION" == "save" ]]; then MUTATES=1; fi ;;
  function)
    case "$ACTION" in
      rename|create|delete|set-signature|set-return-type|set-calling-convention|set-var-type)
        MUTATES=1 ;;
    esac
    ;;
  symbol)  if [[ "$ACTION" == "create" || "$ACTION" == "delete" || "$ACTION" == "rename" ]]; then MUTATES=1; fi ;;
  memory)  if [[ "$ACTION" == "write" ]]; then MUTATES=1; fi ;;
  type)
    case "$ACTION" in
      create|apply|delete|rename|create-enum|typedef|add-field|del-field) MUTATES=1 ;;
    esac
    ;;
  comment) if [[ "$ACTION" == "set" || "$ACTION" == "delete" ]]; then MUTATES=1; fi ;;
  patch)   if [[ "$ACTION" == "bytes" || "$ACTION" == "nop" ]]; then MUTATES=1; fi ;;
esac
if ((MUTATES)); then
  write_project_mutation_marker "$MUTATION_MARKER" "$ABS_PROJECT_DIR"
fi

# --- Build CLI args -----------------------------------------------------------

# The vendored CLI gives this environment variable precedence over the
# wrapper-supplied --projects-dir. Do not let inherited process state redirect
# an otherwise guarded invocation.
unset GHIDRA_PROJECT_DIR

CLI_ARGS=(
  --projects-dir "$ABS_PROJECT_DIR"
  --project "$PROJECT_NAME"
  --program "$PROGRAM_NAME"
)

# Force compact JSON when used as an agent tool.
if [[ "${GHIDRA_AGENT:-}" == "1" ]]; then
  CLI_ARGS+=(--json)
fi

# --- Dispatch -----------------------------------------------------------------

exec "$GHIDRA_CLI" "${CLI_ARGS[@]}" "$@"
