#!/usr/bin/env bash
#
# tools/g — repo-local ghidra CLI wrapper.
#
# Removes the ceremony of remembering --projects-dir/--project/--program on
# every invocation. Resolves the repo root, materializes the working project
# if absent, selects the pinned vendored CLI binary, and refuses to operate
# against the committed project/ snapshot.
#
# Usage:
#   tools/g decompile 0x8db22
#   tools/g x-ref to 0x8db22
#   tools/g script run ghidra/scripts/investigate/Foo.java -- arg1
#   tools/g stop
#   tools/g inspect 0xc853a --decompile --callers --callees --xrefs --disasm 40
#
# Environment:
#   GHIDRA_AGENT=1            Force compact JSON output (for scripted/agent consumption).
#   GHIDRA_PROJECT            Override the working project directory (default: build/project).
#   GHIDRA_ALLOW_SYSTEM_CLI=1 Allow falling back to a system-installed ghidra binary.
#
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
PROJECT_NAME="rh850_p1me_mapped"
PROGRAM_NAME="RH850_P1M-E_CodeFlash.bin"
SNAPSHOT_DIR="$ROOT/project"
PROJECT_DIR="${GHIDRA_PROJECT:-$ROOT/build/project}"

# --- Resolve the ghidra CLI binary -------------------------------------------

VENDOR_SRC="$ROOT/ghidra/ghidra-cli/src"
VENDOR_BIN="$ROOT/build/ghidra-cli/ghidra"

# Rebuild if the binary is missing or stale (source newer than binary).
if [[ -d "$VENDOR_SRC" ]]; then
  NEED_BUILD=0
  if [[ ! -x "$VENDOR_BIN" ]]; then
    NEED_BUILD=1
  else
    # Check if any .rs or .java source file is newer than the binary.
    if find "$VENDOR_SRC" -type f \( -name '*.rs' -o -name '*.java' \) \
         -newer "$VENDOR_BIN" -print -quit 2>/dev/null | grep -q .; then
      NEED_BUILD=1
    fi
  fi
  if ((NEED_BUILD)) && [[ -x "$ROOT/tools/build_ghidra_cli.sh" ]] && command -v cargo >/dev/null 2>&1; then
    echo "Vendored ghidra CLI is missing or stale — rebuilding..." >&2
    "$ROOT/tools/build_ghidra_cli.sh" >&2
  fi
fi

if [[ -x "$VENDOR_BIN" ]]; then
  GHIDRA_CLI="$VENDOR_BIN"
elif [[ "${GHIDRA_ALLOW_SYSTEM_CLI:-0}" == "1" ]] && command -v ghidra >/dev/null 2>&1; then
  GHIDRA_CLI=$(command -v ghidra)
else
  echo "ghidra CLI not found. Run 'make ghidra-cli' to build the vendored copy." >&2
  echo "(Set GHIDRA_ALLOW_SYSTEM_CLI=1 to fall back to a system ghidra on PATH.)" >&2
  exit 1
fi

# --- Guard against committed project/ ----------------------------------------

# Resolve to an absolute canonical path WITHOUT requiring the directory to exist
# (python3 Path.resolve(strict=False) follows symlinks and collapses .. without
# needing the path to be present on disk). The old `cd ... && pwd` approach
# failed open when the cd failed, leaving the path uncanonicalized.
ABS_PROJECT_DIR=$(python3 -c "from pathlib import Path; print(Path('$PROJECT_DIR').resolve(strict=False))")
case "$ABS_PROJECT_DIR" in
  "$SNAPSHOT_DIR"|"$SNAPSHOT_DIR"/*)
    echo "REFUSING: working project resolves inside committed snapshot ($SNAPSHOT_DIR)." >&2
    echo "Use build/project (the default) or set GHIDRA_PROJECT to a disposable path." >&2
    exit 1
    ;;
esac

# --- Materialize the working project if absent --------------------------------

# Skip for bridge management commands that don't need a project open.
NEEDS_PROJECT=1
case "${1:-}" in
  stop|status|ping|jobs|cancel|version|doctor|setup|init|config)
    # These work on the daemon lifecycle, not the project dir — but we still
    # want the project flags so 'stop'/'status' target the right daemon.
    if [[ ! -d "$PROJECT_DIR/$PROJECT_NAME.rep" ]]; then
      NEEDS_PROJECT=0
    fi
    ;;
esac

if ((NEEDS_PROJECT)) && [[ ! -d "$PROJECT_DIR/$PROJECT_NAME.rep" ]]; then
  if [[ ! -d "$SNAPSHOT_DIR/$PROJECT_NAME.rep" ]]; then
    echo "No committed snapshot found at $SNAPSHOT_DIR — run 'make rebuild-project' first." >&2
    exit 1
  fi
  echo "Materializing working project from committed snapshot..." >&2
  mkdir -p "$PROJECT_DIR"
  cp -R "$SNAPSHOT_DIR/." "$PROJECT_DIR/"
  echo "Ready: $PROJECT_DIR" >&2

  # Verify the processor manifest fingerprint after copy, mirroring
  # `make work-project`. This catches stale/incorrect processor sources
  # that would silently produce wrong decompilation.
  if [[ -f "$PROJECT_DIR/processor_manifest.json" ]]; then
    MANIFEST="$PROJECT_DIR/processor_manifest.json"
  elif [[ -f "$SNAPSHOT_DIR/processor_manifest.json" ]]; then
    MANIFEST="$SNAPSHOT_DIR/processor_manifest.json"
  else
    MANIFEST=""
  fi
  if [[ -n "$MANIFEST" ]]; then
    if ! python3 "$ROOT/tools/fingerprint_processor.py" --source-only --expect "$MANIFEST" >&2; then
      echo "ERROR: processor manifest fingerprint mismatch after materializing working project." >&2
      echo "The vendored processor sources do not match the committed snapshot." >&2
      exit 1
    fi
  else
    echo "NOTE: no processor_manifest.json yet; run rebuild-project to create one." >&2
  fi
fi

# --- Build CLI args -----------------------------------------------------------

CLI_ARGS=(
  --projects-dir "$PROJECT_DIR"
  --project "$PROJECT_NAME"
  --program "$PROGRAM_NAME"
)

# Force compact JSON when used as an agent tool.
if [[ "${GHIDRA_AGENT:-}" == "1" ]]; then
  CLI_ARGS+=(--json)
fi

# --- Dispatch -----------------------------------------------------------------

# Pass all remaining args through to the ghidra CLI.
exec "$GHIDRA_CLI" "${CLI_ARGS[@]}" "$@"
