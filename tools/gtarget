#!/usr/bin/env bash
set -euo pipefail
ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
resolve_target() {
  python3 "$ROOT/tools/project/analysis_target.py" "$@" || {
    local status=$?
    echo "Run 'tools/gtarget list' to see registered targets." >&2
    return "$status"
  }
}

if (($# == 0)); then set -- --help; fi
case "${1:-}" in
  -h|--help)
    cat <<'EOF'
Usage:
  tools/gtarget list
  tools/gtarget show TARGET
  tools/gtarget TARGET COMMAND [ARGS...]

List registered analysis targets, show their metadata, or run a Ghidra command
against a selected target. Use a registered target name, not a bare part number.
EOF
    exit 0
    ;;
  list)
    shift
    exec python3 "$ROOT/tools/project/analysis_target.py" --list "$@"
    ;;
  show)
    TARGET=${2:?usage: tools/gtarget show TARGET}
    shift 2
    resolve_target "$TARGET" --json "$@"
    exit 0
    ;;
esac
TARGET=${1:?usage: tools/gtarget TARGET <ghidra-command...>}
shift
resolve_target "$TARGET" --field project_name >/dev/null
export GHIDRA_ANALYSIS_TARGET="$TARGET"
exec "$ROOT/tools/g" "$@"
