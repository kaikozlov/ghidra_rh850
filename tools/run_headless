#!/usr/bin/env bash
# Centralized, fail-closed wrapper for Ghidra analyzeHeadless.
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
PROJECT_DIR=""
PROJECT_NAME=""
LOG=""
LABEL="headless"
QUIET=0
WITH_INVESTIGATE=0

usage() {
  cat <<'EOF'
Usage: tools/run_headless --project-dir DIR --project NAME [options] -- ARGS...

Options:
  --project-dir DIR  Project directory (canonicalized; committed project/ rejected)
  --project NAME     Ghidra project name
  --log PATH         Durable complete log (default: temporary log)
  --label TEXT       Stage label used in diagnostics
  --quiet            Do not replay successful output to stdout
  --with-investigate Include ghidra/scripts/investigate in the controlled scriptPath
  -h, --help         Show this help

The runner owns the isolated processor environment, canonical semicolon-separated
scriptPath, analysis timeout, CPU limit, logging, and script-error detection.
Callers must not pass -scriptPath, -analysisTimeoutPerFile, or -max-cpu.
EOF
}

while (($#)); do
  case "$1" in
    --project-dir) PROJECT_DIR=${2:?missing --project-dir value}; shift 2 ;;
    --project) PROJECT_NAME=${2:?missing --project value}; shift 2 ;;
    --log) LOG=${2:?missing --log value}; shift 2 ;;
    --label) LABEL=${2:?missing --label value}; shift 2 ;;
    --quiet) QUIET=1; shift ;;
    --with-investigate) WITH_INVESTIGATE=1; shift ;;
    -h|--help) usage; exit 0 ;;
    --) shift; break ;;
    *) echo "unknown runner option: $1" >&2; usage >&2; exit 2 ;;
  esac
done

[[ -n "$PROJECT_DIR" ]] || { echo "ERROR: --project-dir is required" >&2; exit 2; }
[[ -n "$PROJECT_NAME" ]] || { echo "ERROR: --project is required" >&2; exit 2; }
(($#)) || { echo "ERROR: analyzeHeadless arguments are required after --" >&2; exit 2; }

for arg in "$@"; do
  case "$arg" in
    -scriptPath|-analysisTimeoutPerFile|-max-cpu)
      echo "ERROR: caller-supplied $arg is forbidden; tools/run_headless owns it" >&2
      exit 2
      ;;
  esac
done

PROJECT_DIR=$(python3 - "$PROJECT_DIR" "$ROOT/project" <<'PY'
from pathlib import Path
import sys
path = Path(sys.argv[1]).expanduser().resolve(strict=False)
snapshot = Path(sys.argv[2]).resolve(strict=False)
if path == snapshot or snapshot in path.parents:
    raise SystemExit(f"ERROR: refusing committed snapshot path: {path}")
if any(part.startswith(".") for part in path.parts if part not in (".", "..")):
    raise SystemExit(f"ERROR: Ghidra rejects dot-prefixed path components: {path}")
print(path)
PY
)
mkdir -p "$PROJECT_DIR"

if [[ "${GHIDRA_NO_BOOTSTRAP:-0}" != "1" ]]; then
  # shellcheck disable=SC1091
  source "$ROOT/tools/lib/ghidra_env.sh" none
fi
[[ -n "${GHIDRA_HOME:-}" ]] || { echo "ERROR: GHIDRA_HOME is unset" >&2; exit 1; }
ANALYZE="$GHIDRA_HOME/support/analyzeHeadless"
[[ -x "$ANALYZE" ]] || { echo "ERROR: missing analyzeHeadless: $ANALYZE" >&2; exit 1; }

SCRIPT_DIRS=(
  "$ROOT/ghidra/scripts/import"
  "$ROOT/ghidra/scripts/seed"
  "$ROOT/ghidra/scripts/annotate"
  "$ROOT/ghidra/scripts/verify"
)
if ((WITH_INVESTIGATE)); then
  SCRIPT_DIRS+=("$ROOT/ghidra/scripts/investigate")
fi
SCRIPT_PATH=$(printf '%s;' "${SCRIPT_DIRS[@]}")
SCRIPT_PATH=${SCRIPT_PATH%;}

TEMP_LOG=0
if [[ -z "$LOG" ]]; then
  mkdir -p "$ROOT/build/headless-logs"
  safe_label=$(printf '%s' "$LABEL" | tr -c '[:alnum:]_.-' '_')
  LOG=$(mktemp "$ROOT/build/headless-logs/${safe_label}.XXXXXX.log")
  TEMP_LOG=1
else
  LOG=$(python3 -c 'from pathlib import Path; import sys; print(Path(sys.argv[1]).expanduser().resolve())' "$LOG")
  mkdir -p "$(dirname "$LOG")"
fi

set +e
"$ANALYZE" "$PROJECT_DIR" "$PROJECT_NAME" \
  -scriptPath "$SCRIPT_PATH" \
  -analysisTimeoutPerFile "${GHIDRA_ANALYSIS_TIMEOUT:-1800}" \
  -max-cpu "${GHIDRA_MAX_CPU:-4}" \
  "$@" >"$LOG" 2>&1
rc=$?
set -e

# Ghidra's analyzeHeadless shell wrapper can return a fraction of a second
# before its launch.sh/java descendants disappear.  A following verifier may
# otherwise observe an active AnalyzeHeadless for the same project even though
# this runner has returned.  Do not kill the descendant; fail closed unless the
# exact project becomes quiescent.
if ! python3 - "$PROJECT_DIR" "$PROJECT_NAME" "${GHIDRA_HEADLESS_QUIESCE_TIMEOUT:-10}" <<'PY'
import subprocess
import sys
import time

project_dir, project_name, raw_timeout = sys.argv[1:]
try:
    timeout = float(raw_timeout)
except ValueError:
    raise SystemExit(f"invalid GHIDRA_HEADLESS_QUIESCE_TIMEOUT: {raw_timeout!r}")
if timeout < 0:
    raise SystemExit("GHIDRA_HEADLESS_QUIESCE_TIMEOUT must be >= 0")

needle = "ghidra.app.util.headless.AnalyzeHeadless"
deadline = time.monotonic() + timeout
while True:
    result = subprocess.run(
        ["ps", "-axo", "pid=,command="],
        check=True, capture_output=True, text=True,
    )
    matches = []
    for line in result.stdout.splitlines():
        if needle not in line or project_dir not in line or project_name not in line:
            continue
        pid_text, _, command = line.strip().partition(" ")
        if pid_text.isdigit():
            matches.append((int(pid_text), command))
    if not matches:
        break
    if time.monotonic() >= deadline:
        for pid, command in matches:
            print(f"headless descendant still active: pid={pid} {command}", file=sys.stderr)
        raise SystemExit(1)
    time.sleep(0.05)
PY
then
  echo "ERROR: headless stage did not quiesce: $LABEL" >&2
  echo "full log: $LOG" >&2
  exit 1
fi

script_error=0
if grep -E 'REPORT SCRIPT ERROR|IllegalStateException' "$LOG" >/dev/null 2>&1; then
  script_error=1
fi

if ((rc != 0 || script_error)); then
  echo "ERROR: headless stage failed: $LABEL (rc=$rc, script_error=$script_error)" >&2
  echo "full log: $LOG" >&2
  grep -En 'REPORT SCRIPT ERROR|SCRIPT ERROR|IllegalStateException|ASSERT|ERROR' "$LOG" >&2 || true
  exit 1
fi

if ((QUIET == 0)); then
  cat "$LOG"
fi
if ((TEMP_LOG)); then
  rm -f "$LOG"
fi
